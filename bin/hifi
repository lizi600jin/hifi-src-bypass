#!/system/bin/sh
# ==============================================================================
# HiFi SRC Bypass - universal USB / wired SRC bypass
#                                on-device controller            v2.0.2
#
#   what it does
#     The factory audio policy of THIS phone is located automatically -- no
#     device template, no hard-coded OnePlus paths.  Every file that really
#     contains a USB / wired / DIRECT output port is patched in memory:
#
#       * samplingRates of those ports re-capped to the chosen ceiling
#       * 24 / 32-bit profiles appended when the factory only declared 16-bit
#       * the primary mixer rate aligned to the chosen mixer value
#
#     The factory file is NEVER modified.  A patched copy is bind-mounted over
#     the real path inside the global (init) mount namespace so audioserver
#     sees it -> unmounting the bind is a 100 % lossless restore.
#
#   what it deliberately does not do
#     add / remove / rename any mixPort, devicePort or route.  This is not a
#     promise, it is checked on the device by payload/check_policy.awk before
#     anything gets mounted; if the check fails the module stays inert and the
#     factory policy keeps running.
#
#   usage
#     hifi status | dac | json | rates | ports | files | scan
#     hifi set <key> <val>          apply | restore | reset
#     hifi preset auto|384k|192k|96k|44k
#     hifi verify | doctor | log | boot | uninstall
#
#   runs under Magisk / KernelSU / APatch
# ==============================================================================

set -u

# ------------------------------------------------------------------ self path
SELF="$0"
case "$SELF" in
  /*) ;;
  *)  SELF="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)/$(basename "$SELF")" ;;
esac
MODDIR="${MODDIR:-$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd)}"

MOD_ID=hifi_src_bypass
MARKER=HIFI_SRC_BYPASS_UNIV

# ------------------------------------------------------- offline test hooks
# Empty in production; only used by the desktop regression harness so the
# controller can run against a fixture tree without root or a real device.
#   HIFI_FAKE_ROOT   prefix prepended to every absolute policy path
#   HIFI_FAKE_MOUNTS alternative mounts file (default /proc/mounts)
#   HIFI_FAKE_ASOUND alternative /proc/asound tree
#   HIFI_STATE_DIR   alternative state dir (default /data/adb/$MOD_ID)
PROOT="${HIFI_FAKE_ROOT:-}"
MOUNTS="${HIFI_FAKE_MOUNTS:-/proc/mounts}"
ASOUND="${HIFI_FAKE_ASOUND:-/proc/asound}"

STATE="${HIFI_STATE_DIR:-/data/adb/$MOD_ID}"
CONF="$STATE/config.conf"
TGT="$STATE/targets.lst"
LOG="$STATE/last.log"
REPORT="$STATE/report.txt"
CACHE="$STATE/targets.cache"
PATCHER="$MODDIR/payload/patch_policy.awk"
CHECKER="$MODDIR/payload/check_policy.awk"
HALPATCH="$MODDIR/payload/patch_hal.sh"
# Fourth layer: the volume CURVE, not the rate table.  AOSP caps loudness at the
# last <point> of each (stream, device) curve; a ROM that is afraid of its own
# loudspeaker leaves that step short of 0 dB (-300 = -3 dB is typical), so no
# volume-key press can ever reach full scale.  Lifting the tail of exactly one
# curve -- speaker + music -- is what raises the maximum acoustic output.
VOLPATCH="$MODDIR/payload/patch_volume.awk"
VOLCHECK="$MODDIR/payload/check_volume.awk"

# The old OnePlus-13-only module.  If it is still installed, its bind mount
# would fight ours, so we notice it and say so instead of failing cryptically.
OLD_ID=op13_hifi_src_bypass
OLD_STATE=/data/adb/op13_hifi

# ------------------------------------------------------------------- defaults
# Every key MUST be initialised here: the script runs under `set -u` and
# load_conf() re-reads them afterwards, so a truncated config file would
# otherwise abort on the first reference.
MIXER_RATE=48000
MAX_RATE=384000
BIT_DEPTH=32
ENABLED=1
RESTART=1
# the user's own restart preference, as read from config.conf; do_restore writes
# THIS back, never the value a suppressed run happened to use
RESTART_PERSIST=1
# The vendor HiFi port ("hifi_playback"): on Qualcomm/OnePlus-style ROMs USB
# audio plays through THIS port, not deep_buffer.  It ships as a *dynamic*
# mixPort, so the policy pins it to whatever the DAC advertises as its maximum
# and every source is resampled up to that.  A numeric value gives it a static
# profile instead, which is the only lever that reaches this port (verified on
# a Redmi K20 Pro: the live port went 384000 -> 192000 Hz).  "auto" = stock.
HIFI_RATE=auto
# Second layer: reorder the sample-rate table inside the AOSP USB HAL library.
# The policy XML tells the *framework* what it may request; the HAL keeps its
# own hard ceiling (usually 96000) and that is what actually reaches the DAC.
# 1 = unlock it (only ever acts when the known table is found exactly once).
HAL_PATCH=1
# Speaker / earpiece device ports: "auto" keeps the factory rates (they only
# get the mixer rate appended, as before).  A number pins them to that single
# rate, so a matching source plays without resampling on the loudspeaker too.
# Mixer mixPorts are NOT touched by this knob -- they belong to MIXER_RATE.
SPK_RATE=auto
# Bit-depth ceiling for the speaker / earpiece device ports.  16 = factory
# (the historical behaviour: mixer-class ports never get extra depths).
SPK_BITS=16
# ADSP bit-width enforce knob: the QTI audio HAL natively reads the system
# property persist.vendor.audio_hal.dsp_bit_width_enforce_mode at start-up
# and forces the ADSP ASM streams to the given bit width through the
# "ASM Bit Width" mixer control.  16 = never inject anything (factory
# behaviour), 24 / 32 = inject on every `hifi apply`.  Pure property layer:
# no policy file is touched by this knob.
SPK_DSP_BITS=16
# Smart PA power layer (NXP TFA9874-class or Qualcomm WSA88xx devices, driven
# purely through runtime tinymix writes -- zero files, zero mounts).  Empty =
# never touch the PA (factory behaviour, the safe default).  PA_GAIN=<0..6>
# raises the loudspeaker PA gain on every apply (TFA: control 23 dB tiers;
# WSA884x: RX0+RX1 volume 84-2N).  PA_BOOST=<1|2> sets the boost max state on
# TFA-class devices; WSA backends report it as firmware-managed and skip.
# "reset" behaves like empty.  This layer is deliberately decoupled from the
# policy mount layer: restore never touches the PA controls.
PA_GAIN=""
PA_BOOST=""
# Speaker loudness mode (0 / 1 / 2, default 0 = never touch anything).
#
#   0 = 不碰（原有行为）
#   1 = 只做硬件 IIR 高通：把扬声器发不出的超低频砍掉，释放振膜行程
#   2 = 额外允许把数字前端音量压到 72（Qualcomm 衰减索引，数值小 = 更响）
#
# 为什么不再推 PA 增益：TFA9874 的 G_DEFAULT 在硬件固件里等于满载 G_6_DB。
# 真机声学实测（原厂 0dB 档 vs 模块 +6dB 档，两条录音全采样分析）RMS 差
# -0.41 dB、1000 Hz 基波差 -0.37 dB、峰值差 -0.45 dB —— 同一个输出。所以
# 推 PA 增益是零收益；真正的瓶颈在振膜行程被无效低频吃掉，TFA 的 DSP 限幅器
# 一直被那些发不出来的频率触发，把中高频一起压下去。
SPK_LOUD=0
# Volume-curve ceiling unlock (the fourth layer).  0 = never touch a volume
# table (factory behaviour, the safe default); 1 = lift the last VOL_POINTS
# steps of the AUDIO_STREAM_MUSIC / DEVICE_CATEGORY_SPEAKER curve to 0 dB.
# Deliberately a separate switch from everything else: it is the only knob in
# this module that changes how LOUD the phone is allowed to be, so it must be
# possible to have the rate work without it -- and to turn it off again without
# disturbing the rate work.
VOL_UNLOCK=0
# Trailing steps of the curve to lift when VOL_UNLOCK=1.  3 is the last ~3% of a
# 101-step AOSP curve: the three volume-key presses that a conservative ROM
# leaves unusable.  Not a config key on purpose -- nobody needs to tune it, and
# a config value that silently changes the loudness ceiling is a footgun.
VOL_POINTS=3

DIRECT_POOL="8000 11025 12000 16000 22050 24000 32000 44100 48000 64000 88200 96000 128000 176400 192000 352800 384000"
USB_POOL="44100 48000 64000 88200 96000 128000 176400 192000 352800 384000"
ALL_RATES="48000 96000 176400 192000 352800 384000"
ALL_MIXER="44100 48000 192000 384000"
ALL_HIFI="auto 44100 48000 96000 176400 192000 352800 384000"
ALL_BITS="16 24 32"
ALL_SPK="auto 44100 48000 96000 192000 384000"
ALL_SPK_BITS="16 24 32"
ALL_SPKDSP="16 24 32"

# ------------------------------------------------------------------ candidates
# Canonical locations, in the order the vendors actually use them.  Every one
# of these is a real path (the /system/vendor duplicates are included because
# on some ROMs /vendor is a symlink and `find` does not follow it).
FIXED_CANDIDATES="
/odm/etc/audio/audio_module_config_primary.xml
/odm/etc/audio/audio_module_config_secondary.xml
/odm/etc/audio/audio_policy_configuration.xml
/odm/etc/audio_policy_configuration.xml
/vendor/etc/audio/audio_module_config_primary.xml
/vendor/etc/audio/audio_policy_configuration.xml
/vendor/etc/audio_policy_configuration.xml
/system/vendor/etc/audio/audio_policy_configuration.xml
/system/vendor/etc/audio_policy_configuration.xml
/system/vendor/etc/audio/audio_module_config_primary.xml
/product/etc/audio_policy_configuration.xml
/system/etc/audio_policy_configuration.xml
"

# ------------------------------------------------- second layer: the USB HAL
# libalsautils{,v2}.so carry the compile-time table of sample rates the USB HAL
# will actually open; its first entry is the advertised maximum and is 96000 on
# most builds.  Reordering those 13 uint32s is what lifts the real ceiling.
# We only ever touch these two sonames -- they are the AOSP USB HAL, they are
# optional, and their absence is a perfectly normal result (not an error).
HAL_LIBS="libalsautils.so libalsautilsv2.so"

# ------------------------------------------------- the volume tables (layer 4)
# ONLY these two names are unlocked, and the whitelist is exact on purpose:
#
#   audio_policy_volumes.xml     <volume stream=... deviceCategory=...> curves
#   default_volume_tables.xml    <reference name=...VOLUME_CURVE> curves
#
# The rest of the *volumes* family that a ROM may <xi:include> is deliberately
# left alone:
#
#   audio_policy_engine_stream_volumes.xml
#   audio_policy_engine_default_stream_volumes.xml
#   *_stream_volumes_mi.xml   (MIUI/HyperOS vendor copy)
#
# Those belong to the AudioPolicy *engine* configuration: they describe how the
# engine scales a stream for one of its own product strategies, and they are
# consumed by a different parser with a different default-value mechanism.  The
# two framework tables above are the ones AudioPolicyManager resolves the user's
# volume index through, so they are where a ceiling actually lives.  Rewriting
# the engine tables would change strategy behaviour (call/assistant ducking) that
# this module has no business touching -- so they are recognised, reported and
# skipped with a reason instead of being silently fed to the policy patcher.
VOL_NAMES="audio_policy_volumes.xml default_volume_tables.xml"
VOL_ENGINE_RE="*stream_volumes*.xml"
HAL_DIRS="
/odm/lib64
/odm/lib
/vendor/lib64
/vendor/lib
/system/vendor/lib64
/system/vendor/lib
/system/lib64
/system/lib
"

# =============================================================== small helpers
log() {
  # post-fs-data runs before the RTC is usable, so `date` happily reports 1970.
  # A wall-clock-less marker is more honest than a timestamp from 56 years ago.
  ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
  case "$ts" in
    ""|1970-*) ts="[clock-not-set-yet]" ;;
  esac
  line="$ts $*"
  printf '%s\n' "$line" >> "$LOG" 2>/dev/null
  printf '%s\n' "$line"
}

ensure_dirs() {
  mkdir -p "$STATE/stock" "$STATE/patched" 2>/dev/null
  chmod 0755 "$STATE" "$STATE/stock" "$STATE/patched" 2>/dev/null
}

# ============================================================================
# JSON string safety.
#
# A WebUI ("json") answer is consumed by KSU's bridge and by JSON.parse, so any
# byte the JSON grammar forbids turns the WHOLE object into a parse error and
# the page loses every field -- including the ones that were fine.  The values
# here are not under our control: log lines carry device output, DAC names come
# from /proc/asound/<card>/stream0, target paths come from the ROM's own
# filesystem.  One carriage return, one ANSI colour escape, one ESC / form feed
# / vertical tab byte is enough to destroy the page.
#
# 🔴 THE BYTE CLASS STOPS AT 0x7F, AND THAT IS LOAD-BEARING.
# An earlier version of this function also stripped 0x80-0x9F on the theory that
# it is "the C1 block".  That is a UTF-8 KILLER: in every CJK code point the
# continuation bytes run 0x80-0xBF, so a large share of Chinese characters carry
# a byte in 0x80-0x9F (一 = E4 B8 80, 中 = E4 B8 AD).  Stripping the range
# amputated 74.4% of the CJK corpus -- and did so INCONSISTENTLY, because
# whether awk sees a byte or a character there depends on the locale:
#   * mawk / busybox awk (byte mode) -> #<80>..#<9F> matched BYTES, so
#     mid-character deletion produced invalid UTF-8;
#   * gawk in a UTF-8 locale          -> the range is read as the CHARACTERS
#     U+0080..U+009F and gawk aborts with "Invalid collation character", so the
#     whole json_escape died (rc=1) and the answer contained nothing at all.
# A REGEX RANGE CANNOT SEPARATE "C1 byte" FROM "CJK continuation byte" -- they
# are the same octets in a byte-wise reader.  So the range stays out entirely.
#
# The two C1 cases that DO matter are handled by exact sequences, never by a
# range, because in well-formed UTF-8 a multi-byte pattern can only match the
# character it names:
#   * U+0085 NEL, which the device log corpus carries -> matched as #<C2>#<85>.
#   * U+009B CSI, the C1 form of the ANSI escape introducer: `\233[1;31m`
#     (the 8-bit CSI sequence) is removed AS A WHOLE below, exactly like the
#     7-bit `\033[1;31m` form.  \233 is only matched when followed by `[` and a
#     real CSI parameter/terminator, so a lone 0x9B cannot be confused with a
#     continuation byte here either.
#
# WHAT IS STILL OUT OF REACH, STATED HONESTLY: awk cannot validate UTF-8, so a
# LONE 0x9B (or a truncated multi-byte sequence such as 0xE4 followed by ASCII)
# survives this pass.  That is why json_str -- the funnel every field actually
# goes through -- runs iconv(1) as a final UTF-8 validator, and why the raw
# json_escape output is documented as "byte-cleaned, not UTF-8-validated".
# Don't read the class above as "C1 is fully handled by regex".
#
# TABS: json_escape keeps them (they are not a byte-safety problem), and the
# JSON-mandated \t escape is applied by json_str -- the single funnel every
# string field of the answer goes through.  See the note on json_str.
#
# Order matters:
#   1. ANSI colour/attribute sequences are removed AS WHOLE SEQUENCES first, so
#      cutting the ESC byte does not leave the visible "[1;31m" debris behind.
#      Both the 7-bit (\033[) and 8-bit (\233[) introducers get their own rule.
#   2. Every remaining illegal byte is stripped: 0x01-0x1F except \n (which the
#      line separator consumes), plus 0x7F (DEL), plus the NEL encoding above.
#      \r \v \f are removed rather than re-encoded -- a stripped byte can never
#      be mis-parsed, and the consumers here render these strings as display
#      text, not as payload.
#   3. `\` is escaped BEFORE `"`: otherwise the quote's escape character would
#      itself be escaped and the string would end early.
#
# The class is written with explicit octal escapes because \x is a gawk
# extension that busybox awk would read as a literal "x0".
json_escape() {
  awk '
    BEGIN { ORS = ""; first = 1 }
    {
      if (!first) printf "\\n"
      first = 0
      # 7-bit CSI: ESC [ params final
      gsub(/\033\[[0-9;]*[A-Za-z]/, "")
      # 8-bit CSI (C1 0x9B): the ECMA-48 single-byte introducer.  Removed with
      # its parameter bytes and terminator, so no "[1;31m" debris is left.
      gsub(/\233\[[0-9;]*[A-Za-z]/, "")
      gsub(/[\001-\010\013-\037\177]/, "")
      gsub(/\302\205/, "")
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      print $0
    }'
}

# iconv availability is PROBED, not assumed.  Android ships it as a toybox
# applet (verified on the K20 Pro: /system/bin/iconv -> toybox, and it drops a
# lone 0x9B while keeping CJK and emoji byte-for-byte), but a minimal or
# stripped ROM may not have it -- in that case json_str degrades to the
# regex-only path documented above instead of failing.
#
# The probe runs a REAL conversion of a string that contains an isolated C1
# byte: a bare symlink can exist while the applet itself is missing from the
# toybox build, and an iconv without -c would fail on exactly this input.
ICONV_BIN=""
for c in /system/bin/iconv /system/xbin/iconv; do
  [ -x "$c" ] || continue
  if printf 'A\233B\n' | "$c" -f UTF-8 -t UTF-8 -c 2>/dev/null | grep -q '^AB$'; then
    ICONV_BIN="$c"; break
  fi
done
if [ -z "$ICONV_BIN" ]; then
  c="$(command -v iconv 2>/dev/null)"
  if [ -n "$c" ] && printf 'A\233B\n' | "$c" -f UTF-8 -t UTF-8 -c 2>/dev/null | grep -q '^AB$'; then
    ICONV_BIN="$c"
  fi
fi

# The single funnel every string field of status_json goes through -- callers
# must not interpolate a raw value into a printf '"%s"' (a path, a DAC name or a
# property value can carry anything).  Three things happen here, in this order:
#
#   1. json_escape -- strip the illegal bytes, remove ANSI sequences, escape
#      `\` and `"`.  It MUST run first: it is what removes the 8-bit CSI sequence
#      (\233[1;31m) AS A WHOLE.  Feeding the raw value to iconv first would eat
#      the lone 0x9B introducer and leave the visible "[1;31m" debris behind.
#
#   2. iconv -f UTF-8 -t UTF-8 -c -- the UTF-8 VALIDITY pass.  Regex cannot tell
#      a C1 byte from a CJK continuation byte (same octets), and it cannot reject
#      a truncated sequence such as 0xE4 followed by ASCII, so a lone 0x9B
#      survives step 1 by design.  iconv can: it discards exactly the bytes that
#      are not valid UTF-8 and passes everything else through untouched.  This is
#      the pass that makes "python json.loads / JSON.parse both accept it"
#      hold on a real log, which may carry any byte a device driver printed.
#
#      READ THE EXIT STATUS CORRECTLY -- this is where the previous attempt went
#      wrong.  `iconv -c` ALWAYS exits non-zero when it actually drops something
#      ("A\233B" -> stdout "AB", rc=1); rc=0 only means "nothing was discarded".
#      Gating the assignment on `rc == 0` therefore throws away exactly the
#      cleaned result and keeps the poisoned one -- the pass looked present and
#      did nothing.  What matters is whether iconv produced OUTPUT, not whether
#      it was happy: an empty result for a non-empty input means the conversion
#      failed wholesale (wrong locale, broken applet) and the un-sanitised value
#      is kept, because a rare stray byte is a smaller problem than an emptied
#      field; any non-empty result IS the validated value, whatever the rc.
#
#   3. TAB -> \t.  A literal 0x09 inside a JSON string is INVALID (RFC 8259:
#      U+0000-U+001F must be escaped), so `json.loads` and JSON.parse both reject
#      the whole object over a single tab in a log line.  json_escape leaves the
#      byte alone so that the cleaner stays a byte filter; json_str is where JSON
#      *grammar* is honoured.  Ordering it last means the backslash it introduces
#      is not re-escaped by step 1.
#
# Numbers stay raw on purpose: they are validated counters and must serialise as
# JSON numbers.
json_str() {
  _v="$(printf '%s' "$1" | json_escape)"
  if [ -n "$ICONV_BIN" ] && [ -n "$_v" ]; then
    # `-c` exits 1 whenever it drops a byte, so the rc is NOT the success signal
    # here; "did it come back with anything" is.  See the note above.
    _s="$(printf '%s' "$_v" | "$ICONV_BIN" -f UTF-8 -t UTF-8 -c 2>/dev/null)"
    [ -n "$_s" ] && _v="$_s"
  fi
  printf '%s' "$_v" | awk 'BEGIN { ORS = "" } { gsub(/\t/, "\\t"); print }'
}

flatten() { printf '%s' "$1" | tr '/.' '__'; }

is_ours() { [ -r "$1" ] && grep -q "$MARKER" "$1" 2>/dev/null; }

is_mounted() {
  awk -v t="$1" '$2 == t { found = 1 } END { exit !found }' "$MOUNTS" 2>/dev/null
}

# The three layers are verified completely differently: a policy XML carries our
# text marker, a HAL library can never carry it -- there we look for the rate
# table instead, and a volume table cannot carry a marker EITHER because the
# whole point of that patch is that the file keeps its exact byte length (see
# payload/patch_volume.awk).  Everything that asks "is this target live?" goes
# through here.
is_hal_target() { case "$1" in *.so) return 0 ;; esac; return 1; }

# Is $1 one of the two framework volume tables we are allowed to unlock?
# Exact name match, not a *volume* glob: audio_policy_engine_stream_volumes.xml
# and the MIUI *_stream_volumes_mi.xml are volume tables of a DIFFERENT kind (the
# AudioPolicy engine's own strategy scaling) and are intentionally out of scope.
is_volume_target() {
  case "$(basename "$1" 2>/dev/null)" in
    audio_policy_volumes.xml|default_volume_tables.xml) return 0 ;;
  esac
  return 1
}

# A volume table the module recognises but deliberately does not unlock.
# Reported by name so the log explains the SKIP instead of claiming the file
# "is not an audio policy file" -- which is what the pre-2.0 build wrote for
# every volume table it stumbled over through <xi:include>.
is_volume_engine_target() {
  case "$(basename "$1" 2>/dev/null)" in
    *stream_volumes*.xml|*volume_tables_engine*.xml) return 0 ;;
  esac
  return 1
}

# Is the speaker/music curve at $1 already at full scale?
#
# A volume table carries NO marker and its byte length is fixed, so identity has
# to be established by reading it: compare the live file against the archived
# factory copy with the same checker that gates the mount.  exit 0 = the live
# file is exactly "factory + lifted tail", which is the definition of applied.
is_volume_unlocked() {
  live="$1"
  [ -r "$live" ] || return 1
  [ -n "${VOLCHECK:-}" ] && [ -r "$VOLCHECK" ] || return 1
  stk="$STATE/stock/$(flatten "$live")"
  [ -r "$stk" ] || return 1
  awk -v SPK_POINTS="$VOL_POINTS" -f "$VOLCHECK" "$stk" "$live" >/dev/null 2>&1
}

is_hal_unlocked() {
  [ -r "$HALPATCH" ] || return 1
  sh "$HALPATCH" --check "$1" "$MAX_RATE" >/dev/null 2>&1
  case "$?" in 4|7) return 0 ;; esac
  return 1
}

# which ceiling the rate table in $1 currently carries (blank = not a USB HAL)
#
# NOTE: the patcher prints the *stock* case ("ok (check) offset=...") on stdout
# but every "already unlocked" case on stderr, so both streams must be captured.
hal_ceiling() {
  [ -r "$HALPATCH" ] || return 0
  msg="$(sh "$HALPATCH" --check "$1" 384000 2>&1)"
  case "$msg" in
    *"already unlocked at 768"*) printf '%s' 768000 ;;
    *"already unlocked at 384"*) printf '%s' 384000 ;;
    *"already unlocked at 192"*) printf '%s' 192000 ;;
    *"ok (check)"*)             printf '%s' 96000 ;;
  esac
}

target_applied() {
  is_mounted "$1" || return 1
  if is_hal_target "$1";    then is_hal_unlocked   "$1"; return; fi
  if is_volume_target "$1"; then is_volume_unlocked "$1"; return; fi
  is_ours "$1"
}

realpath_of() {
  rp="$(readlink -f "$1" 2>/dev/null)"
  if [ -n "$rp" ]; then printf '%s' "$rp"; else printf '%s' "$1"; fi
}

# -------------------------------------------------------------- loaded policy
# Which policy XML is the framework ACTUALLY reading?  AudioPolicyManager is the
# only authority and it prints it: "Config source: <path>".
#
# This matters more than it sounds.  Vendors ship two or three copies -- e.g.
# /vendor/etc/audio_policy_configuration.xml (loaded) and a much richer
# /vendor/etc/audio/audio_policy_configuration.xml (NOT loaded, just the source
# the first one was generated from).  Patching the copy nobody reads looks
# successful in every log we write, and changes nothing.  Asking the framework
# removes the guesswork on any ROM.
#
# audioserver does not exist yet during post-fs-data, so there the answer comes
# from the cache written on the last run.
# The raw text the framework reports, which is NOT always a path: AIDL HAL
# ROMs answer "AIDL HAL" (the HAL itself carries the policy, there is no single
# file).  Kept separate so the report can show the truth either way.
config_source_desc() {
  cs="$(dumpsys media.audio_policy 2>/dev/null \
        | sed -n 's/.*Config source: *//p' | head -n1 | tr -d '\r')"
  if [ -n "$cs" ]; then
    printf '%s' "$cs" > "$STATE/config_source.txt" 2>/dev/null
    printf '%s' "$cs"
    return 0
  fi
  [ -r "$STATE/config_source.txt" ] && cat "$STATE/config_source.txt"
  return 0
}

loaded_policy_file() {
  lp="$(config_source_desc)"
  case "$lp" in
    /*) ;;                       # a real absolute path -- usable
    *)  printf ''; return 0 ;;   # "AIDL HAL", empty, or anything else
  esac
  printf '%s' "$lp" > "$STATE/loaded_policy.path" 2>/dev/null
  printf '%s' "$lp"
  return 0
}

# Is this ROM a Qualcomm AIDL-dialect device?  OnePlus 13 (and other 8 Elite
# class QTI ROMs) answer "AIDL HAL" as the config source and ship audio policy
# XMLs that use the `pcmType` attribute; MTK / AOSP HIDL ROMs answer with a
# real file path and use `format=`.  Two independent probes, first hit wins:
#   1. the framework's own answer (dumpsys media.audio_policy, "Config source")
#      mentioning AIDL -- the same evidence the report already prints;
#   2. any candidate policy XML on this device using `pcmType=` (the QTI AIDL
#      dialect) -- works even when audioserver is not running yet.
# The offline test harness stubs `dumpsys`, so both branches stay exercisable.
is_qti_aidl() {
  case "$(config_source_desc 2>/dev/null)" in
    *[Aa][Ii][Dd][Ll]*) return 0 ;;
  esac
  for f in $FIXED_CANDIDATES; do
    [ -f "$PROOT$f" ] || continue
    grep -q 'pcmType="' "$PROOT$f" 2>/dev/null && return 0
  done
  return 1
}

QTI_AIDL_MIXER44K_WARN='!! MIXER_RATE=44100：Qualcomm AIDL 机型的 DSP 混音通路锁 48k 时钟粒度，44.1k 会产生周期性杂音（一加13 真机验证）。若扬声器/有线有"噗噗"声，请 mixer 48000 + hifirate 对齐音源。'

# Emitted wherever MIXER_RATE=44100 is shown to a user: `hifi apply` output and
# `hifi status`.  Warn-only -- the setting stays fully legal, and MTK / HIDL
# dialect devices (Redmi Note 11T Pro verified) must never see this line.
maybe_warn_qti_mixer44k() {
  [ "$MIXER_RATE" = 44100 ] || return 0
  is_qti_aidl || return 0
  printf '%s\n' "$QTI_AIDL_MIXER44K_WARN"
}

load_conf() {
  [ -r "$CONF" ] && . "$CONF"
  case "$MIXER_RATE" in 44100|48000|192000|384000) ;; *) MIXER_RATE=48000 ;; esac
  ok=0
  for r in $ALL_RATES; do [ "$r" = "$MAX_RATE" ] && ok=1; done
  [ "$ok" = 1 ] || MAX_RATE=384000
  ok=0
  for r in $ALL_HIFI; do [ "$r" = "$HIFI_RATE" ] && ok=1; done
  [ "$ok" = 1 ] || HIFI_RATE=auto
  case "$ENABLED"  in 0|1) ;; *) ENABLED=1 ;; esac
  case "$RESTART"  in 0|1) ;; *) RESTART=1 ;; esac
  case "$HAL_PATCH" in 0|1) ;; *) HAL_PATCH=1 ;; esac
  ok=0
  for b in $ALL_BITS; do [ "$b" = "$BIT_DEPTH" ] && ok=1; done
  [ "$ok" = 1 ] || BIT_DEPTH=32
  ok=0
  for r in $ALL_SPK; do [ "$r" = "$SPK_RATE" ] && ok=1; done
  [ "$ok" = 1 ] || SPK_RATE=auto
  ok=0
  for b in $ALL_SPK_BITS; do [ "$b" = "$SPK_BITS" ] && ok=1; done
  [ "$ok" = 1 ] || SPK_BITS=16
  case "$SPK_DSP_BITS" in 16|24|32) ;; *) SPK_DSP_BITS=16 ;; esac
  # smart PA knobs: "" (= factory / untouched) or a valid tier, never guessed
  case "$PA_GAIN" in ""|reset|[0-6]) ;; *) PA_GAIN="" ;; esac
  case "$PA_BOOST" in ""|reset|1|2) ;; *) PA_BOOST="" ;; esac
  # speaker loudness mode: strictly 0 / 1 / 2.  Anything else -- a hand-edited
  # conf, a truncated write, a value from a future build -- falls back to 0
  # (leave the codec alone).  Same reasoning as VOL_UNLOCK: the safe failure
  # mode of THIS knob is "nothing was changed", never "an unverified IIR
  # coefficient set is running on the loudspeaker".
  case "$SPK_LOUD" in 0|1|2) ;; *) SPK_LOUD=0 ;; esac
  # volume-curve unlock: strictly 0 or 1.  Anything else (a hand-edited conf, a
  # truncated write) falls back to 0 = do not touch a volume table, because the
  # safe failure mode of THIS knob is "the phone is a bit quieter than it could
  # be", not "the phone mounted a curve nobody verified".
  case "$VOL_UNLOCK" in 0|1) ;; *) VOL_UNLOCK=0 ;; esac
  # fixed, never read from the conf -- see the note at the default above
  VOL_POINTS=3
  # RESTART_PERSIST keeps the value the USER chose, whatever this run decides.
  # do_restore saves the config on its way out (it flips ENABLED=0), so without
  # this the suppressed RESTART=0 burned into config.conf would outlive the boot
  # self-heal -- the exact regression t3/t4 check for, just reached through the
  # other door.
  RESTART_PERSIST="${RESTART_PERSIST:-$RESTART}"
  case "$RESTART"  in 0|1) ;; *) RESTART=1 ;; esac
  # ---- restart suppression, honoured where it actually matters ---------------
  # service.sh's boot self-heal (P0-4) has to unmount a patch while audioserver
  # is CRASH-LOOPING.  Restarting the audio stack there re-enters the loop the
  # module is trying to escape, so the suppression must be settable per call:
  #   HIFI_NO_RESTART=1        environment, applies to any command
  #   HIFI_TRANSIENT=1         the existing "this run only" flag; it already
  #                            means "the self-heal is driving, do not persist",
  #                            and suppressing the restart is the other half of
  #                            that same promise
  #   HIFI_RESTART=0|1         explicit override of the persisted RESTART value
  # Both spellings land on $RESTART, which is what do_apply/do_restore test, so
  # there is exactly ONE branch to reason about.  This is the F2 fix: the old
  # code suppressed the *save* but left $RESTART=1 from config.conf, and the
  # self-heal restarted the crashing stack anyway.
  case "${HIFI_RESTART:-}" in
    0|1) RESTART="$HIFI_RESTART" ;;
  esac
  if [ "${HIFI_NO_RESTART:-0}" = 1 ] || [ "${HIFI_TRANSIENT:-0}" = 1 ]; then
    RESTART=0
  fi
  return 0
}

save_conf() {
  ensure_dirs
  cat > "$CONF" <<EOF
# HiFi SRC Bypass : settings
# MIXER_RATE : global mixer rate. 48000 = factory (safe), 44100 = align a 44.1k
#              library, 192000 / 384000 = high-rate mixer (upsamples 44.1k/48k
#              sources by an integer factor; heavier on the SoC and USB bus)
MIXER_RATE=$MIXER_RATE
# MAX_RATE   : HiFi / USB direct ceiling. 384000 = high-tier DAC, 96000 = 96k tier
MAX_RATE=$MAX_RATE
# HIFI_RATE  : rate for the vendor HiFi port ("hifi_playback") that USB audio
#              actually plays through.  auto = stock (the port follows the
#              DAC's own maximum, so every source is resampled up to it).
#              A number pins the port to that rate: pick the rate YOUR library
#              uses (192000 for 超清母带 / 臻品音质 masters) and that content
#              plays without resampling; everything else is resampled UP, never down.
HIFI_RATE=$HIFI_RATE
# BIT_DEPTH  : ceiling for the USB / wired output bit depth (16 / 24 / 32).
#              16 = do not extend at all, 32 = 16 + 24 + 32 (default)
BIT_DEPTH=$BIT_DEPTH
# SPK_RATE   : speaker / earpiece device port rate.  auto = 原厂 (the ports
#              only get the mixer rate appended, as before).  A number pins
#              扬声器/听筒端口 to that single rate, so a matching source plays
#              without resampling on the loudspeaker.  The mixer mixPorts are
#              NOT touched -- they belong to MIXER_RATE.
SPK_RATE=$SPK_RATE
# SPK_BITS   : bit-depth ceiling for the speaker / earpiece device ports
#              (16 / 24 / 32).  16 = 保持原厂 (mixer-class ports get nothing
#              added), 24 / 32 = 补齐 24 / 32-bit 到扬声器/听筒端口.
SPK_BITS=$SPK_BITS
# SPK_DSP_BITS : ADSP bit-width enforce mode.  Injected as the system
#              property persist.vendor.audio_hal.dsp_bit_width_enforce_mode
#              on every apply (24 / 32).  16 = nothing is injected; a value
#              left on the system is only cleared by hifi restore.
SPK_DSP_BITS=$SPK_DSP_BITS
# PA_GAIN    : smart PA loudspeaker gain tier written via tinymix on apply
#              (empty / reset = never touch the PA, the factory behaviour).
#              0..6 = explicit dB tier.  THIS CHANGES SPEAKER DRIVE POWER:
#              start at 0 (+1dB) and listen before going higher.
PA_GAIN=$PA_GAIN
# PA_BOOST   : smart PA boost max state (empty / reset = untouched, 1 = stepped
#              down (saves power, clips earlier), 2 = factory full stage).
PA_BOOST=$PA_BOOST
# SPK_LOUD   : speaker loudness mode (0 / 1 / 2).
#              0 = 不碰（原有行为）
#              1 = hardware IIR high-pass only: cuts the sub-bass the TFA
#                  loudspeaker cannot reproduce, which frees diaphragm
#                  excursion so the PA's DSP limiter stops being tripped by
#                  inaudible low frequencies and lets the mid/high band through
#                  louder.
#              2 = mode 1 + allowed to LOWER the Qualcomm digital front-end
#                  volume to 72 (that control is an ATTENUATION index:
#                  gain_dB = (124 - v) / 2, LARGER = QUIETER, so lowering the
#                  number is the only direction that adds level).
#              推 PA 增益不在此列：TFA9874 的 G_DEFAULT 在固件里就是满载。
SPK_LOUD=$SPK_LOUD
# VOL_UNLOCK : 1 = lift the ceiling of the speaker/music volume CURVE
#              (audio_policy_volumes.xml + default_volume_tables.xml) by
#              rewriting its last 3 steps from e.g. -300 mB to 0 dB.
#              THIS CHANGES THE MAXIMUM ACOUSTIC OUTPUT OF THE LOUDSPEAKER:
#              the digital limiter the ROM built in is removed at the top of
#              the range, so a full-scale mix can clip the small speaker.
#              0 = factory curve (default).  hifi restore is unconditional.
VOL_UNLOCK=$VOL_UNLOCK
# ENABLED    : 1 = patch mounted, 0 = factory policy in use
ENABLED=$ENABLED
# RESTART    : 1 = restart the audio stack right after applying, 0 = reboot later
#              (the USER's value: a run that suppressed the restart -- the boot
#               self-heal -- must not persist its own decision here)
RESTART=${RESTART_PERSIST:-$RESTART}
# HAL_PATCH  : 1 = also reorder the USB HAL's own sample-rate table
#              (libalsautils{,v2}.so), which is a *lower* ceiling than the
#              policy XML and the usual reason a dongle stays at 96 kHz.
#              0 = policy XML only.
HAL_PATCH=$HAL_PATCH
EOF
  chmod 0644 "$CONF" 2>/dev/null
}

# ====================================================== policy file discovery
# One candidate = one XML that lives on the phone and has <mixPort>/<devicePort>
# in it.  <xi:include href="..."> is followed one level, because Qualcomm HIDL
# ROMs split the a2dp module out into its own file.
scan_candidates() {
  found=""
  # the file the framework really reads goes first -- see loaded_policy_file()
  lp="$(loaded_policy_file)"
  if [ -n "$lp" ] && [ -f "$PROOT$lp" ]; then found="$found $PROOT$lp"; fi
  for f in $FIXED_CANDIDATES; do
    [ -f "$PROOT$f" ] && found="$found $PROOT$f"
  done
  # Vendor policy files do not all start with "audio_policy_configuration":
  # AOSP itself ships usb_ / a2dp_ / r_submix_ / bluetooth_ / hearing_aid_
  # variants, and they are pulled into the main document with <xi:include>.
  # Matching *_audio_policy_configuration.xml as well means the USB module is
  # found even if the include is spelled unusually or lives in a subdirectory.
  for root in /odm /vendor /system/vendor /product /system/etc /system/product/etc; do
    [ -d "$PROOT$root" ] || continue
    hit="$(find "$PROOT$root" -maxdepth 6 -type f \
             \( -name 'audio_policy_configuration*.xml' \
                -o -name '*_audio_policy_configuration.xml' \
                -o -name 'audio_module_config_*.xml' \) \
             2>/dev/null)"
    [ -n "$hit" ] && found="$found $hit"
  done

  # one level of <xi:include>.  The spec forbids nesting, so one level is all
  # there can be -- but the href may still be absolute or contain a directory.
  for f in $found; do
    [ -r "$f" ] || continue
    inc="$(sed -n 's/.*<xi:include[^>]*href="\([^"]*\)".*/\1/p' "$f" 2>/dev/null)"
    for h in $inc; do
      case "$h" in
        *://*|"") continue ;;
        /*)       [ -f "$PROOT$h" ] && found="$found $PROOT$h"; continue ;;
      esac
      d="$(dirname "$f")"
      [ -f "$d/$h" ] && found="$found $d/$h"
    done
  done

  # layer 4: the volume tables.  They are reachable two ways and BOTH must work:
  #   * the main policy <xi:include>s them, and the include follower above has
  #     already appended them -- but ONLY if the main policy was found first, so
  #     this is not a guarantee;
  #   * a ROM may keep them next to the policy without including them (or the
  #     framework reads them from /odm), so they are also looked up by name.
  # VOL_UNLOCK=0 still SCANS them: the report must be able to say "this ROM has
  # a speaker curve ending at -3 dB and you left it alone", which is how a user
  # discovers the knob.  Only the patch step is gated by the switch.
  for root in /odm /vendor /system/vendor /product /system/etc /system/product/etc; do
    [ -d "$PROOT$root" ] || continue
    for d in "$root" "$root/etc" "$root/etc/audio" "$root/audio"; do
      for n in $VOL_NAMES; do
        [ -f "$PROOT$d/$n" ] && found="$found $PROOT$d/$n"
      done
    done
  done
  # and once more by name, in case a vendor parked them somewhere non-standard
  for root in /odm /vendor /product; do
    [ -d "$PROOT$root" ] || continue
    vh="$(find "$PROOT$root" -maxdepth 4 -type f \
            \( -name 'audio_policy_volumes.xml' \
               -o -name 'default_volume_tables.xml' \) \
            2>/dev/null)"
    [ -n "$vh" ] && found="$found $vh"
  done

  # second layer: the AOSP USB HAL libraries
  if [ "$HAL_PATCH" = 1 ]; then
    for d in $HAL_DIRS; do
      for l in $HAL_LIBS; do
        [ -f "$PROOT$d/$l" ] && found="$found $PROOT$d/$l"
      done
    done
  fi

  # normalise + dedupe, keeping the first spelling we saw
  #
  # `stub_audio_policy_configuration.xml` is an AOSP *placeholder* (one dummy
  # mixPort) that several ROMs ship alongside the real policy.  Patching it
  # achieves nothing and only adds a bind mount, so skip it by name.
  seen=""
  for f in $found; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
      *stub*) continue ;;
    esac
    rp="$(realpath_of "$f")"
    case " $seen " in *" $rp "*) continue ;; esac
    seen="$seen $rp"
    printf '%s\n' "$rp"
  done
}

# ============================================================ dialect probe
# READ-ONLY classification of the policy XML currently on the device.  It
# answers ONE question -- is this a QTI/AIDL file or an AOSP/HIDL one -- by
# counting the two mutually exclusive format attributes the vendor dialects
# use.  Comment blocks are stripped character-wise before counting, because
# vendor files discuss both spellings inside <!-- --> and a naive grep would
# read the prose as content (this exact bug shipped once).
#
# Nothing here writes, mounts or changes a file: it is a diagnostic, used by
# `hifi status` and by the WebUI so the user can see which dialect their ROM
# speaks without pulling files off the phone.
#
# exit 3 (no known format attribute) is mapped to the empty string: "this file
# is not a policy" is a normal answer, not an error, and the callers below walk
# on to the next candidate.
dialect_of() {
  awk '
    { ln = $0
      while (1) {
        p = index(ln, "<!--")
        if (p == 0) break
        q = index(substr(ln, p), "-->")
        if (q == 0) { ln = substr(ln, 1, p - 1); break }
        ln = substr(ln, 1, p - 1) substr(ln, p + q + 2)
      }
      if (ln ~ /pcmType="/) qti++
      else if (ln ~ /format="AUDIO_FORMAT_/) aosp++
    }
    END {
      if (qti == 0 && aosp == 0) exit 3
      print (qti >= aosp) ? "qti" : "aosp"
    }' "$1" 2>/dev/null
}

# The device's policy dialect, discovered WITHOUT any prior state: prefer the
# archived factory copy of every file we already mounted (it is the file the
# ROM actually boots with), then fall back to a fresh scan.  Returns the empty
# string when nothing on this ROM is a patchable policy -- never an error, so a
# caller may always interpolate the result into a status line.
current_dialect() {
  if [ -r "$TGT" ]; then
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      is_hal_target "$live" && continue
      is_volume_target "$live" && continue
      [ -r "$stk" ] || continue
      d="$(dialect_of "$stk")"
      [ -n "$d" ] && { printf '%s' "$d"; return 0; }
    done < "$TGT"
  fi
  for f in $(candidate_list); do
    case "$f" in *.so) continue ;; esac
    is_volume_target "$f" && continue
    [ -r "$f" ] || continue
    d="$(dialect_of "$f")"
    [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  done
  return 0
}

refresh_targets() {
  ensure_dirs
  scan_candidates > "$CACHE.tmp" 2>/dev/null
  mv -f "$CACHE.tmp" "$CACHE" 2>/dev/null
}

# the list of policy files worth patching, cached between calls so that the
# WebUI's polling does not run `find` over /vendor every second
candidate_list() {
  if [ -s "$CACHE" ]; then
    stale=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ -f "$f" ] || stale=1
    done < "$CACHE"
    [ "$stale" = 0 ] && { cat "$CACHE"; return 0; }
  fi
  refresh_targets
  [ -s "$CACHE" ] && cat "$CACHE"
  return 0
}

# --------------------------------------------------------------- SELinux
# Borrow the label of a sibling file -- never hard-code it, the label differs
# between /odm (OnePlus / Qualcomm AIDL) and /vendor (everything older), and
# between an XML policy (vendor_configs_file) and a shared library
# (vendor_file).  Getting this wrong is exactly how a patched library ends up
# unreadable by audioserver (avc: denied read).
ref_context_for() {
  live="$1"
  d="$(dirname "$live")"
  ext="${live##*.}"
  c=""
  # 1. the file we are overlaying -- its own label is by definition correct
  c="$(ls -Zd "$live" 2>/dev/null | awk '{print $1}')"
  case "$c" in u:*) printf '%s' "$c"; return 0 ;; esac
  # 2. a sibling of the same kind (.so next to .so, xml next to xml)
  ref=""
  for f in "$d"/*."$ext"; do
    [ -e "$f" ] || continue
    [ "$f" = "$live" ] && continue
    ref="$f"; break
  done
  # 3. any sibling at all, then the directory itself
  if [ -z "$ref" ]; then
    for f in "$d"/*; do
      [ -e "$f" ] || continue
      [ "$f" = "$live" ] && continue
      ref="$f"; break
    done
  fi
  [ -n "$ref" ] || ref="$d"
  c="$(ls -Zd "$ref" 2>/dev/null | awk '{print $1}')"
  case "$c" in u:*) printf '%s' "$c"; return 0 ;; esac
  # 4. last resort: the standard label for that file kind
  case "$ext" in
    so) printf '%s' "u:object_r:vendor_file:s0" ;;
    *)  printf '%s' "u:object_r:vendor_configs_file:s0" ;;
  esac
}

# ============================================================ global mount ns
enter_global_ns() {
  [ "${HIFI_NS:-}" = "done" ] && return 0
  self_ns="$(readlink /proc/self/ns/mnt 2>/dev/null)"
  init_ns="$(readlink /proc/1/ns/mnt 2>/dev/null)"
  if [ -n "$self_ns" ] && [ "$self_ns" = "$init_ns" ]; then
    HIFI_NS=done; export HIFI_NS; return 0
  fi
  if command -v nsenter >/dev/null 2>&1; then
    HIFI_NS=done
    export HIFI_NS
    exec nsenter -t 1 -m -- "$SELF" "$@"
  fi
  log "! cannot enter the global mount namespace, audioserver may not see the patch"
  return 0
}

# ============================================================== generate patch
# Patch one file.  $1 = live path, $2 = patched output, $3 = stock archive.
# Echoes nothing; sets GEN_RC (0 = changed and verified, 3 = no patchable port,
# 4 = nothing to change, 1 = rejected).

# The dispatcher.  Order matters: a volume table is an XML file too, so it would
# happily fall into the *) policy arm and come back exit 3 ("not an audio policy
# file") -- which is exactly the misleading SKIPPED line that ended up in real
# device reports whenever the main policy <xi:include>d its volume tables.
gen_one() {
  case "$1" in
    *.so)                                   gen_hal "$@" ;;
    *) if is_volume_target "$1"; then
         gen_volume "$@"
       else
         gen_policy "$@"
       fi ;;
  esac
}

# A HAL library is "already unlocked" when the stock rate table is gone.  The
# patcher's --check mode answers that without writing anything; is_hal_unlocked
# above maps exit 4 (same ceiling) and 7 (a different ceiling) to "unlocked".

gen_hal() {
  live="$1"; out="$2"; stk="$3"
  GEN_RC=1
  if [ -z "$HALPATCH" ] || [ ! -r "$HALPATCH" ]; then
    log "! HAL patcher missing ($HALPATCH)"
    return 1
  fi

  # archive the factory library exactly once -- and never archive one that is
  # already unlocked, or restore would put back the wrong thing
  made_archive=0
  if [ ! -e "$stk" ]; then
    if is_hal_unlocked "$live"; then
      log "! $live already carries an unlocked rate table; not archiving it"
      GEN_RC=4
      return 4
    fi
    cp -f "$live" "$stk" 2>/dev/null || { log "! cannot archive $live"; return 1; }
    chmod 0644 "$stk" 2>/dev/null
    made_archive=1
  fi

  sh "$HALPATCH" "$stk" "$out" "$MAX_RATE" > "$STATE/.hal.out" 2> "$STATE/.hal.err"
  rc=$?
  case "$rc" in
    0) : ;;
    # 3 / 6 mean this library will never be patched, so the archive we just
    # made for it is dead weight -- drop it again, or `hifi files` ends up
    # listing archives that belong to nothing
    3) [ "$made_archive" = 1 ] && rm -f "$stk"
       GEN_RC=3; return 3 ;;
    4) GEN_RC=4; return 4 ;;
    6) log "! $live: the rate table occurs more than once -- refusing to guess"
       rm -f "$out"; [ "$made_archive" = 1 ] && rm -f "$stk"
       GEN_RC=6; return 6 ;;
    # 7 = the copy we were about to patch is itself already unlocked.  That can
    # only mean the archive is not a factory library (e.g. it was produced by an
    # older build of this module), so refuse loudly instead of mounting a
    # library whose provenance we cannot trust -- and drop the bad archive so a
    # later restore+apply can archive the real factory library again.
    7) log "!! REJECTED $live: $(cat "$STATE/.hal.err" 2>/dev/null)"
       log "   the archived copy is not a factory library; discarding it."
       log "   recover with:  hifi restore  &&  hifi apply"
       rm -f "$stk" "$out"; GEN_RC=1; return 1 ;;
    *) log "! HAL patch failed on $live: $(cat "$STATE/.hal.err" 2>/dev/null)"
       rm -f "$out"; return 1 ;;
  esac

  # the reorder is in place, so both the length and the ELF header must be
  # bit-identical to the factory library.  If they are not, we mis-stepped.
  sz_a="$(wc -c < "$stk" | tr -d ' ')"
  sz_b="$(wc -c < "$out" | tr -d ' ')"
  if [ "$sz_a" != "$sz_b" ]; then
    log "!! REJECTED $live (size changed $sz_a -> $sz_b)"
    rm -f "$out"; GEN_RC=1; return 1
  fi
  hd_a="$(dd if="$stk" bs=1 count=16 2>/dev/null | od -An -v -tx1 | tr -d ' \n')"
  hd_b="$(dd if="$out" bs=1 count=16 2>/dev/null | od -An -v -tx1 | tr -d ' \n')"
  if [ "$hd_a" != "$hd_b" ]; then
    log "!! REJECTED $live (ELF header changed)"
    rm -f "$out"; GEN_RC=1; return 1
  fi

  chmod 0644 "$out" 2>/dev/null
  chown 0:0 "$out" 2>/dev/null
  ctx="$(ref_context_for "$live")"
  [ -n "$ctx" ] && chcon "$ctx" "$out" 2>/dev/null

  GEN_RC=0
  return 0
}

gen_policy() {
  live="$1"; out="$2"; stk="$3"
  GEN_RC=1

  # archive the factory file exactly once -- and never archive something that
  # is already ours, or the archive would be poisoned
  made_archive=0
  if [ ! -e "$stk" ]; then
    if is_ours "$live"; then
      log "! $live already carries a patched policy; not archiving it"
      return 1
    fi
    cp -f "$live" "$stk" 2>/dev/null || { log "! cannot archive $live"; return 1; }
    chmod 0644 "$stk" 2>/dev/null
    made_archive=1
  fi

  awk -v MARKER="$MARKER" -v MIXER="$MIXER_RATE" -v CEIL="$MAX_RATE" -v BITS="$BIT_DEPTH" \
      -v HIFI="$HIFI_RATE" -v SPK="$SPK_RATE" -v SPKBITS="$SPK_BITS" \
      -v VER="$MODVER" -v STOCKPATH="$live" \
      -f "$PATCHER" "$stk" > "$out.tmp" 2> "$STATE/.patch.err"
  rc=$?
  if [ "$rc" = 3 ]; then
    rm -f "$out.tmp"
    # this file will never be patched, so an archive of it is dead weight
    [ "$made_archive" = 1 ] && rm -f "$stk"
    GEN_RC=3
    return 3
  fi
  if [ "$rc" = 4 ]; then
    rm -f "$out.tmp" "$out"
    [ "$made_archive" = 1 ] && rm -f "$stk"
    GEN_RC=4
    return 4
  fi
  if [ "$rc" != 0 ]; then
    log "! policy generator failed on $live: $(cat "$STATE/.patch.err" 2>/dev/null)"
    rm -f "$out.tmp"
    return 1
  fi

  # ---- structure check: refuse to mount anything that is not a pure
  #      profile-level rewrite of the factory file
  chk="$(awk -v MARKER="$MARKER" -f "$CHECKER" "$stk" "$out.tmp" 2>&1)"
  crc=$?
  if [ "$crc" != 0 ]; then
    log "!! REJECTED $live"
    printf '%s\n' "$chk" | while IFS= read -r l; do [ -n "$l" ] && log "   $l"; done
    rm -f "$out.tmp"
    return 1
  fi

  mv -f "$out.tmp" "$out" || { GEN_RC=1; return 1; }
  chmod 0644 "$out" 2>/dev/null
  chown 0:0 "$out" 2>/dev/null
  ctx="$(ref_context_for "$live")"
  [ -n "$ctx" ] && chcon "$ctx" "$out" 2>/dev/null

  GEN_RC=0
  return 0
}

gen_volume() {
  live="$1"; out="$2"; stk="$3"
  GEN_RC=1

  if [ -z "$VOLPATCH" ] || [ ! -r "$VOLPATCH" ]; then
    log "! volume patcher missing ($VOLPATCH)"
    return 1
  fi
  if [ -z "$VOLCHECK" ] || [ ! -r "$VOLCHECK" ]; then
    log "! volume checker missing ($VOLCHECK)"
    return 1
  fi

  # archive the factory table exactly once.  A volume table carries no marker,
  # so "is this archive poisoned?" cannot be answered by grep: instead the
  # checker is run with the archive on BOTH sides.  A factory file compared with
  # itself yields "no points to lift" (exit 4) or a clean pass; an archive that
  # is already our own output would fail that comparison against a fresh read of
  # the live file, and we refuse rather than mount something unverifiable.
  made_archive=0
  if [ ! -e "$stk" ]; then
    cp -f "$live" "$stk" 2>/dev/null || { log "! cannot archive $live"; return 1; }
    chmod 0644 "$stk" 2>/dev/null
    made_archive=1
  fi

  awk -v MARKER="$MARKER" -v SPK_POINTS="$VOL_POINTS" -v VER="$MODVER" \
      -f "$VOLPATCH" "$stk" > "$out.tmp" 2> "$STATE/.vol.err"
  rc=$?
  case "$rc" in
    0) : ;;
    # 3 = not a volume table after all (a policy file that happened to be named
    # like one).  Nothing will ever come of it, so drop the archive again.
    3) rm -f "$out.tmp"
       [ "$made_archive" = 1 ] && rm -f "$stk"
       GEN_RC=3; return 3 ;;
    # 4 = a genuine volume table whose speaker/music tail is already at 0 dB.
    # This is the idempotent case and ALSO the case of a ROM that never capped
    # the curve: either way there is nothing to mount and no archive to keep.
    4) rm -f "$out.tmp" "$out"
       [ "$made_archive" = 1 ] && rm -f "$stk"
       GEN_RC=4; return 4 ;;
    *) log "! volume generator failed on $live: $(cat "$STATE/.vol.err" 2>/dev/null)"
       rm -f "$out.tmp"
       [ "$made_archive" = 1 ] && rm -f "$stk"
       GEN_RC=1; return 1 ;;
  esac

  # ---- the two invariants, re-checked by the caller and not trusted from awk
  #
  # 1. same byte length.  patch_volume.awk already refuses (exit 1) when its own
  #    output changed length, but the shell repeats the measurement because this
  #    is the property the bind mount depends on: an audioserver that re-reads a
  #    file of a different size is reading a file we cannot vouch for.
  sz_a="$(wc -c < "$stk" | tr -d ' ')"
  sz_b="$(wc -c < "$out.tmp" | tr -d ' ')"
  if [ "$sz_a" != "$sz_b" ]; then
    log "!! REJECTED $live (size changed $sz_a -> $sz_b)"
    rm -f "$out.tmp"; GEN_RC=1; return 1
  fi

  # 2. the structural proof: every non-speaker/music curve byte-identical, the
  #    point count and index sequence unchanged, the tail now exactly 0.
  volchk="$(awk -v SPK_POINTS="$VOL_POINTS" -f "$VOLCHECK" "$stk" "$out.tmp" 2>&1)"
  crc=$?
  if [ "$crc" != 0 ]; then
    log "!! REJECTED $live (volume curve check failed)"
    printf '%s\n' "$volchk" | while IFS= read -r l; do [ -n "$l" ] && log "   $l"; done
    rm -f "$out.tmp"
    [ "$made_archive" = 1 ] && rm -f "$stk"
    GEN_RC=1; return 1
  fi

  mv -f "$out.tmp" "$out" || { GEN_RC=1; return 1; }
  chmod 0644 "$out" 2>/dev/null
  chown 0:0 "$out" 2>/dev/null
  ctx="$(ref_context_for "$live")"
  [ -n "$ctx" ] && chcon "$ctx" "$out" 2>/dev/null

  GEN_RC=0
  return 0
}

# One-line summary of what the volume patch actually changed, for the report:
# the factory attenuation of each lifted step, in the order the curve uses them.
# Extracted from the two files rather than recomputed, so the report can never
# disagree with the artefact that is about to be mounted.
volume_tail_report() {
  vstk="$1"; vpat="$2"
  [ -r "$vstk" ] && [ -r "$vpat" ] || return 0
  # Two files, two passes.  "file 1 vs file 2" is decided by NR == FNR (ARGIND is
  # not portable), and the scan is deliberately LINE-oriented: a report line is
  # worth far less than the mount decision, so this does not need the tokenizer
  # patch_volume.awk uses -- it only needs to be right on the one-element-per-line
  # shape every AOSP generator emits, which is also what the fixtures model.
  awk -v N="$VOL_POINTS" '
    function attr(atts, name,   re, v) {
      re = "(^|[ \t\r])" name "[ \t\r]*=[ \t\r]*\"[^\"]*\""
      if (match(atts, re)) {
        v = substr(atts, RSTART, RLENGTH)
        sub(/^[^"]*"/, "", v); sub(/"[ \t\r]*$/, "", v)
        return v
      }
      return ""
    }
    function isour(tag, atts) {
      if (tag == "volume")
        return (attr(atts, "stream") == "AUDIO_STREAM_MUSIC" && \
                attr(atts, "deviceCategory") == "DEVICE_CATEGORY_SPEAKER")
      if (tag == "reference")
        return (attr(atts, "name") ~ /^DEFAULT_DEVICE_CATEGORY_SPEAKER_VOLUME_CURVE/)
      return 0
    }
    {
      first = (NR == FNR)
      line = $0

      # opening tag of a curve, anywhere on the line
      if (match(line, /<(volume|reference)[ \t\r]/)) {
        tag  = substr(line, RSTART + 1); sub(/[ \t\r].*$/, "", tag)
        rest = substr(line, RSTART)
        gt   = index(rest, ">")
        if (gt > 0) {
          atts = substr(rest, length(tag) + 1, gt - length(tag) - 1)
          inblk = isour(tag, atts)
          curtag = tag
          line = substr(rest, gt + 1)
        }
      }
      if (!inblk) next

      # the close tag ends our block
      if (index(line, "</" curtag) > 0) { inblk = 0 }

      # every <point> that belongs to it
      while (match(line, /<point[ \t]*>[^<]*<\/point>/)) {
        seg  = substr(line, RSTART, RLENGTH)
        line = substr(line, RSTART + RLENGTH)
        sub(/^<point[ \t]*>/, "", seg); sub(/<\/point>$/, "", seg)
        split(seg, a, ",")
        idx = a[1] + 0
        db  = a[2]; gsub(/[ \t\r]/, "", db)
        if (first) { S[idx] = db; if (idx > mx) mx = idx }
        else       { P[idx] = db }
      }
    }
    END {
      if (mx == 0) exit 0   # a return inside END is a syntax error in awk
      from = mx - N + 1
      if (from < 1) from = 1
      for (i = from; i <= mx; i++) {
        if (!(i in S)) continue
        out = out (out == "" ? "" : ", ") i ":" S[i] "->" (i in P ? P[i] : "?")
      }
      printf "%s", out
    }' "$vstk" "$vpat" 2>/dev/null
}

# prepare every patchable policy file; writes $TGT and $REPORT
prepare() {
  ensure_dirs
  MODVER="$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n1)"
  [ -n "$MODVER" ] || MODVER="?"

  refresh_targets
  : > "$TGT.tmp"
  : > "$REPORT.tmp"
  n_all=0; n_ok=0; n_skip=0; n_pol=0; n_hal=0; n_vol=0; n_vollock=0
  # volume tables that were REFUSED by the checker (as opposed to skipped).
  # Reported separately by apply_mount, because a refused loudness layer is the
  # one failure the user must not have to dig for: the phone stays at the
  # factory ceiling and nothing in the normal log says so.
  n_volfail=0

  for f in $(candidate_list); do
    n_all=$((n_all + 1))
    flat="$(flatten "$f")"
    # Three kinds, and the volume arm MUST be tested before the *) policy arm:
    # a volume table is an XML file too, and sending it to patch_policy.awk
    # produces the misleading "not an audio policy file" skip.
    kind=policy
    if is_hal_target "$f"; then kind=hal
    elif is_volume_target "$f"; then kind=volume
    elif is_volume_engine_target "$f"; then kind=volengine
    fi

    # The volume layer is the only one gated by a switch, and the gate is THIS
    # narrow: the table is still reported (that is how a user discovers that
    # their ROM caps the speaker at -3 dB), it is just never rewritten.
    if [ "$kind" = volume ] && [ "$VOL_UNLOCK" != 1 ]; then
      printf 'SKIPPED  %s  (VOL_UNLOCK=0: speaker/music curve left at the factory ceiling)\n' \
             "$f" >> "$REPORT.tmp"
      n_vollock=$((n_vollock + 1))
      n_skip=$((n_skip + 1))
      continue
    fi
    # An engine-level volume table is never ours, whatever VOL_UNLOCK says.
    if [ "$kind" = volengine ]; then
      printf 'SKIPPED  %s  (volume table not in the unlock whitelist -- AudioPolicy engine strategy curves are out of scope)\n' \
             "$f" >> "$REPORT.tmp"
      n_skip=$((n_skip + 1))
      continue
    fi

    if gen_one "$f" "$STATE/patched/$flat" "$STATE/stock/$flat"; then
      n_ok=$((n_ok + 1))
      printf '%s|%s|%s\n' "$f" "$STATE/patched/$flat" "$STATE/stock/$flat" >> "$TGT.tmp"
      if [ "$kind" = hal ]; then
        n_hal=$((n_hal + 1))
        printf 'PATCHED  %s\n         HAL sample-rate table unlocked to %s Hz\n' \
               "$f" "$MAX_RATE" >> "$REPORT.tmp"
      elif [ "$kind" = volume ]; then
        n_vol=$((n_vol + 1))
        vtop="$(volume_tail_report "$STATE/stock/$flat" "$STATE/patched/$flat")"
        printf 'PATCHED  %s\n         speaker/music curve: last %s point(s) lifted to 0 dB (%s)\n' \
               "$f" "$VOL_POINTS" "${vtop:-?}" >> "$REPORT.tmp"
      else
        n_pol=$((n_pol + 1))
        ports="$(sed -n "s/.*$MARKER | ports=\([^|]*\)|.*/\1/p" "$STATE/patched/$flat" 2>/dev/null | head -n1)"
        printf 'PATCHED  %s\n         ports:%s\n' "$f" "$ports" >> "$REPORT.tmp"
      fi
    else
      rc="${GEN_RC:-1}"
      case "$kind" in
        hal)
          case "$rc" in
            3) printf 'SKIPPED  %s  (this library does not use the AOSP USB HAL rate table)\n' "$f" >> "$REPORT.tmp" ;;
            4) printf 'SKIPPED  %s  (HAL ceiling already unlocked)\n' "$f" >> "$REPORT.tmp" ;;
            6) printf 'SKIPPED  %s  (rate table appears twice -- refused)\n' "$f" >> "$REPORT.tmp" ;;
            *) printf 'FAILED   %s  (HAL patch refused -- see the log above)\n' "$f" >> "$REPORT.tmp" ;;
          esac ;;
        volume)
          case "$rc" in
            3) printf 'SKIPPED  %s  (not a volume table -- no speaker/music curve and no VOLUME_CURVE reference)\n' "$f" >> "$REPORT.tmp" ;;
            4) printf 'SKIPPED  %s  (speaker/music curve already at full scale -- nothing to lift)\n' "$f" >> "$REPORT.tmp" ;;
            *) printf 'FAILED   %s  (volume patch REFUSED -- the factory curve stays in use, see the log above)\n' "$f" >> "$REPORT.tmp"
               n_volfail=$((n_volfail + 1)) ;;
          esac ;;
        *)
          case "$rc" in
            3) printf 'SKIPPED  %s  (not an audio policy file)\n' "$f" >> "$REPORT.tmp" ;;
            4) printf 'SKIPPED  %s  (no USB / wired / DIRECT output port WITH a rate profile)\n' "$f" >> "$REPORT.tmp" ;;
            *) printf 'FAILED   %s  (see the log above)\n' "$f" >> "$REPORT.tmp" ;;
          esac ;;
      esac
      n_skip=$((n_skip + 1))
    fi
  done

  mv -f "$TGT.tmp" "$TGT" 2>/dev/null
  mv -f "$REPORT.tmp" "$REPORT" 2>/dev/null
  log "scan: $n_all candidate(s) -> $n_pol policy + $n_hal HAL + $n_vol volume patched, $n_skip skipped (mixer=$MIXER_RATE ceiling=$MAX_RATE bits=$BIT_DEPTH hifi=$HIFI_RATE hal=$HAL_PATCH volunlock=$VOL_UNLOCK)"
  if [ "$VOL_UNLOCK" != 1 ] && [ "$n_vollock" -gt 0 ]; then
    log "  note: $n_vollock volume table(s) left at the factory ceiling -- 'hifi set volunlock 1' lifts the top $VOL_POINTS speaker/music steps"
  fi
  if [ "$n_volfail" -gt 0 ]; then
    log "!! $n_volfail volume table(s) were REFUSED by check_volume.awk and are NOT mounted:"
    log "   the loudspeaker keeps the factory ceiling. Run 'hifi verify' and 'hifi log'."
  fi

  if [ "$n_ok" = 0 ]; then
    log "! nothing patchable was found -- this ROM exposes neither a USB / wired /"
    log "  DIRECT output port in any XML policy file, nor the AOSP USB HAL library,"
    log "  so the module would do nothing here.  Run 'hifi scan' and 'hifi ports'"
    log "  and report the output."
    return 1
  fi
  if [ "$n_pol" = 0 ]; then
    log "! note: no XML audio policy was patchable; only the USB HAL table was."
    log "  The HAL table governs the hardware ceiling, so this still helps, but"
    log "  the framework will not advertise rates above the factory policy."
    log "  A common reason for this: the ROM declares its USB output devicePorts"
    log "  with NO <profile> at all (it lets the HAL decide the rates), so there is"
    log "  no ceiling in the XML to lift -- only the HAL library table matters."
  fi
  return 0
}

# ================================================================= apply/undo
apply_mount() {
  # Remember what was mounted before we rebuild the list: a target that drops
  # out of it (the user turned the HAL layer off, a ROM update removed a file)
  # would otherwise keep its bind mount forever, because the mount loop only
  # ever walks the *new* list.
  old_tgt=""
  if [ -r "$TGT" ]; then
    old_tgt="$STATE/targets.prev"
    cp -f "$TGT" "$old_tgt" 2>/dev/null || old_tgt=""
  fi

  prepare || return 1
  rc=0
  n_ok=0
  while IFS='|' read -r live patched stk; do
    [ -n "$live" ] || continue
    if is_mounted "$live"; then umount "$live" 2>/dev/null; fi
    if ! mount --bind "$patched" "$live" 2>/dev/null; then
      log "! bind mount failed: $patched -> $live"
      rc=1
      continue
    fi
    # each layer is verified its own way: a policy XML by our text marker, a
    # HAL library by the rate table actually present at the live path
    if target_applied "$live"; then
      n_ok=$((n_ok + 1))
      if is_hal_target "$live"; then
        log "active: $live  (USB HAL ceiling now $(hal_ceiling "$live") Hz)"
      elif is_volume_target "$live"; then
        log "active: $live  (speaker/music curve: last $VOL_POINTS step(s) at 0 dB, file length unchanged)"
      else
        log "active: $live"
      fi
    else
      # never leave a mount we cannot vouch for -- an unreadable vendor library
      # is worse than no patch at all
      log "! post-mount verification failed on $live -- unmounting it again"
      umount "$live" 2>/dev/null
      is_mounted "$live" && umount -l "$live" 2>/dev/null
      rc=1
    fi
  done < "$TGT"

  if [ -n "$old_tgt" ] && [ -r "$old_tgt" ]; then
    while IFS='|' read -r live rest; do
      [ -n "$live" ] || continue
      if awk -F'|' -v t="$live" '$1 == t { f = 1 } END { exit !f }' "$TGT" 2>/dev/null; then
        continue
      fi
      if is_mounted "$live"; then
        umount "$live" 2>/dev/null
        is_mounted "$live" && umount -l "$live" 2>/dev/null
        log "dropped from the target list, unmounted: $live"
      fi
    done < "$old_tgt"
    rm -f "$old_tgt" 2>/dev/null
  fi

  [ "$rc" = 0 ] && log "applied: $n_ok of $(count_targets) target file(s) are live"
  return $rc
}

undo_mount() {
  [ -r "$TGT" ] || return 0
  while IFS='|' read -r live patched stk; do
    [ -n "$live" ] || continue
    if is_mounted "$live"; then
      umount "$live" 2>/dev/null \
        || umount -l "$live" 2>/dev/null \
        || true
      is_mounted "$live" || log "patch unmounted: $live"
    fi
  done < "$TGT"

  # A file-level bind can leave a *self* mount on the source copy -- observed on
  # the OnePlus 13 as one of our own /data/adb/.../patched/* files turning into
  # a mountpoint.  Harmless, but it belongs to us, so clean it up.
  awk -v s="$STATE/" 'index($2, s) == 1 { print $2 }' "$MOUNTS" 2>/dev/null \
    | while IFS= read -r t; do
        [ -n "$t" ] || continue
        umount "$t" 2>/dev/null
      done
  # belt and braces: the bind can also be listed by source
  [ -z "$PROOT" ] || return 0
  for d in /proc/[0-9]*; do
    [ -r "$d/mounts" ] || continue
    while IFS='|' read -r live patched stk; do
      [ -n "$patched" ] || continue
      if awk -v p="$patched" '$1 == p { exit 0 } END { exit 1 }' "$d/mounts" 2>/dev/null; then
        umount -l "$live" 2>/dev/null
      fi
    done < "$TGT"
  done
  return 0
}

# --------------------------------------------------------------- audio stack
kill_by_cmdline() {
  pat="$1"
  for d in /proc/[0-9]*; do
    [ -r "$d/cmdline" ] || continue
    c="$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)"
    case "$c" in
      *"$pat"*)
        p="${d#/proc/}"
        [ "$p" = "$$" ] && continue
        kill -9 "$p" 2>/dev/null
        ;;
    esac
  done
}

# =============================================== the ONE restart decision point
# do_apply and do_restore both ask this, so the suppression rule cannot drift
# between them again (that drift WAS finding F2: do_set honoured the transient
# flag, do_restore did not, and the boot self-heal restarted a crash-looping
# audioserver).  Suppression re-checks the raw environment instead of trusting
# $RESTART alone, because load_conf is not the only writer of that variable.
restart_suppressed() {
  [ "${HIFI_NO_RESTART:-0}" = 1 ] && return 0
  [ "${HIFI_TRANSIENT:-0}" = 1 ] && return 0
  [ "${RESTART:-1}" = 1 ] || return 0
  return 1
}

maybe_restart_audio() {
  if restart_suppressed; then
    log "audio restart SUPPRESSED (${1:-apply}): the stack is left exactly as it is (transient / no-restart path)"
    return 0
  fi
  restart_audio
}

restart_audio() {
  svcs="$(getprop 2>/dev/null | sed -n 's/^\[init\.svc\.\(.*\)\]: *\[.*/\1/p' | grep -i audio)"
  log "-- restarting audio stack [${svcs:-none found}]"
  if [ -n "$svcs" ]; then
    for s in $svcs; do
      case "$s" in audioserver) continue ;; esac
      setprop ctl.restart "$s" 2>/dev/null
    done
    sleep 2
    setprop ctl.restart audioserver 2>/dev/null || setprop ctl.start audioserver 2>/dev/null
  else
    kill_by_cmdline android.hardware.audio
    kill_by_cmdline audioserver
    sleep 1
    setprop ctl.start audioserver 2>/dev/null
  fi
  sleep 3
  if [ "$(getprop init.svc.audioserver)" = "running" ]; then
    log "audioserver running"
  else
    log "! audioserver is not running, reboot the device to recover"
  fi
}

# ==================================================================== reports
usb_dac_report() {
  cards=""
  if [ -r "$ASOUND/cards" ]; then
    cards="$(sed -n 's/^ *\([0-9][0-9]*\) .*USB.*/\1/p' "$ASOUND/cards")"
  fi
  if [ -z "$cards" ]; then
    for d in "$ASOUND"/card[0-9]*; do
      [ -f "$d/stream0" ] || continue
      grep -q 'at usb-' "$d/stream0" 2>/dev/null && cards="$cards ${d##*card}"
    done
  fi
  [ -z "$cards" ] && return 1
  for n in $cards; do
    f="$ASOUND/card$n/stream0"
    [ -r "$f" ] || continue
    name="$(sed -n '1{s/^Card [0-9]*: //; s/ at usb.*//; p;}' "$f")"
    [ -n "$name" ] || name="USB Audio"
    pb="$(sed -n '/Playback:/,/Capture:/p' "$f")"
    ch="$(printf '%s\n' "$pb" | sed -n 's/^ *Channels: *//p' | head -n1)"
    fm="$(printf '%s\n' "$pb" | sed -n 's/^ *Format: *//p' | sort -u | tr '\n' '/')"
    rates="$(printf '%s\n' "$pb" | sed -n 's/^ *Rates: *//p' | tr ',' '\n' | tr -d ' ' | grep -E '^[0-9]+$')"
    max=0
    for r in $rates; do
      [ "$r" -gt "$max" ] 2>/dev/null && max="$r"
    done
    [ "$max" -gt 0 ] || continue
    printf '%s|%s|%s|%s|%s\n' "$n" "$name" "${ch:-?}" "${fm%/}" "$max"
  done
}

cmd_dac() {
  if usb_dac_report > "$STATE/dac.txt" 2>/dev/null && [ -s "$STATE/dac.txt" ]; then
    while IFS='|' read -r n name ch fm mx; do
      printf 'USB DAC #%s  %s\n  channels: %s  formats: %s  max rate: %s Hz\n' \
             "$n" "$name" "$ch" "$fm" "$mx"
    done < "$STATE/dac.txt"
  else
    printf 'no USB audio device detected (plug your dongle in and retry)\n'
    : > "$STATE/dac.txt"
  fi
}

rate_ceiling_of() {
  picked=""
  for r in $ALL_RATES; do
    [ "$r" -le "${1:-0}" ] 2>/dev/null && picked="$r"
  done
  [ -n "$picked" ] || picked="${ALL_RATES%% *}"
  printf '%s' "$picked"
}

bits_of() {
  case "$1" in
    *S32*|*S24_3*) printf '%s' 24 ;;
    *S24*)         printf '%s' 24 ;;
    *)             printf '%s' 16 ;;
  esac
}

count_targets() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do [ -n "$live" ] && n=$((n + 1)); done < "$TGT"
  printf '%s' "$n"
}

count_applied() {
  n=0
  [ -r "$TGT" ] || { printf '0'; return; }
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_mounted "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

# ---- the two layers counted separately, so the UI can say "2 policy + 1 HAL"

count_hal() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_hal_target "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

count_hal_applied() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_hal_target "$live" || continue
    is_mounted "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

count_volume() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_volume_target "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

count_volume_applied() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_volume_target "$live" || continue
    is_mounted "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

hal_list() {
  [ -r "$TGT" ] || return 0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    is_hal_target "$live" && printf '%s\n' "$live"
  done < "$TGT"
}

# Type-aware "is it really live?" -- slower, because a HAL target is probed by
# reading its rate table.  Used by the boot/action scripts, not by the polling
# JSON endpoint, and by the test harness to assert the two layers independently.
count_applied_verified() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    target_applied "$live" && n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

count_missing() {
  [ -r "$TGT" ] || { printf '0'; return; }
  n=0
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    target_applied "$live" || n=$((n + 1))
  done < "$TGT"
  printf '%s' "$n"
}

targets_brief() {
  [ -r "$TGT" ] || { printf 'none'; return; }
  out=""
  while IFS='|' read -r live rest; do
    [ -n "$live" ] || continue
    out="$out${out:+, }$live"
  done < "$TGT"
  [ -n "$out" ] || out="none"
  printf '%s' "$out"
}

status_json() {
  n_ok="$(count_applied)"
  n_all="$(count_targets)"
  applied=0
  [ "$n_ok" -gt 0 ] 2>/dev/null && applied=1
  backup=0
  [ -d "$STATE/stock" ] && [ -n "$(ls -A "$STATE/stock" 2>/dev/null)" ] && backup=1
  dac_name=""; dac_max="0"; dac_formats=""
  usb_dac_report > "$STATE/dac.txt" 2>/dev/null
  if [ -s "$STATE/dac.txt" ]; then
    IFS='|' read -r _ dn _ dfm dm _ < "$STATE/dac.txt"
    dac_name="${dn:-}"; dac_max="${dm:-0}"; dac_formats="${dfm:-}"
  fi
  ver="$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null)"
  # `json_str "$(tail ...)"`, NOT `tail ... | json_str`: json_str takes its
  # value as ARGUMENT ($1) and would otherwise receive nothing and emit an empty
  # string.  Running json_escape on the pipe was the last path that bypassed the
  # funnel, so a tab in a log line invalidated the whole answer.
  tail_txt="$(json_str "$(tail -n 12 "$LOG" 2>/dev/null)")"
  old_mod=0
  [ -d "/data/adb/modules/$OLD_ID" ] && old_mod=1
  # the ROM's own policy dialect, read-only.  Reported so the WebUI can state
  # which dialect the device speaks without asking for files: it also tells the
  # user WHY a file was skipped (a HIDL/HAL-only ROM has no AIDL policy).
  dialect="$(current_dialect)"

  printf '{\n'
  printf '  "version": "%s",\n' "$(json_str "${ver:-?}")"
  printf '  "enabled": %s,\n' "$ENABLED"
  printf '  "applied": %s,\n' "$applied"
  printf '  "applied_files": %s,\n' "${n_ok:-0}"
  printf '  "total_files": %s,\n' "${n_all:-0}"
  printf '  "hal_files": %s,\n' "$(count_hal)"
  printf '  "hal_applied": %s,\n' "$(count_hal_applied)"
  printf '  "volume_files": %s,\n' "$(count_volume)"
  printf '  "volume_applied": %s,\n' "$(count_volume_applied)"
  printf '  "vol_unlock": %s,\n' "$VOL_UNLOCK"
  printf '  "hal_enabled": %s,\n' "$HAL_PATCH"
  printf '  "backup": %s,\n' "$backup"
  printf '  "mixer_rate": %s,\n' "$MIXER_RATE"
  printf '  "hifi_rate": "%s",\n' "$(json_str "$HIFI_RATE")"
  printf '  "max_rate": %s,\n' "$MAX_RATE"
  printf '  "bit_depth": %s,\n' "$BIT_DEPTH"
  printf '  "spk_rate": "%s",\n' "$(json_str "$SPK_RATE")"
  printf '  "spk_bits": %s,\n' "$SPK_BITS"
  printf '  "spk_dsp_bits": %s,\n' "$SPK_DSP_BITS"
  # smart PA knobs are reported from the CONFIG, never from tinymix: the WebUI
  # must not depend on root-only mixer control reads
  printf '  "pa_gain": %s,\n' "$(pa_conf_json_num "$PA_GAIN")"
  printf '  "pa_boost": %s,\n' "$(pa_conf_json_num "$PA_BOOST")"
  printf '  "bit_profiles": "%s",\n' "$(json_str "$(bitdepth_profiles "$BIT_DEPTH")")"
  printf '  "restart": %s,\n' "$RESTART"
  printf '  "rates": [%s],\n' "$(printf '%s' "$ALL_RATES" | tr ' ' ',')"
  printf '  "target": "%s",\n' "$(json_str "$(targets_brief)")"
  printf '  "dac_name": "%s",\n' "$(json_str "$dac_name")"
  printf '  "dac_formats": "%s",\n' "$(json_str "$dac_formats")"
  printf '  "dac_max": %s,\n' "${dac_max:-0}"
  printf '  "audioserver": "%s",\n' "$(json_str "$(getprop init.svc.audioserver)")"
  printf '  "sdk": "%s",\n' "$(json_str "$(getprop ro.build.version.sdk)")"
  printf '  "dialect": "%s",\n' "$(json_str "${dialect:-unknown}")"
  printf '  "device": "%s",\n' "$(json_str "$(getprop ro.product.device)")"
  printf '  "old_module": %s,\n' "$old_mod"
  printf '  "log_tail": "%s"\n' "$tail_txt"
  printf '}\n'
}

bitdepth_profiles() {
  case "$1" in
    16) printf '%s' "INT_16_BIT / AUDIO_FORMAT_PCM_16_BIT (factory only)" ;;
    24) printf '%s' "+ INT_24_BIT / AUDIO_FORMAT_PCM_24_BIT_PACKED" ;;
    *)  printf '%s' "+ INT_24_BIT / AUDIO_FORMAT_PCM_24_BIT_PACKED + INT_32_BIT / AUDIO_FORMAT_PCM_32_BIT" ;;
  esac
}

bits_profiles_short() {
  case "$1" in
    16) printf '%s' "16" ;;
    24) printf '%s' "16+24" ;;
    *)  printf '%s' "16+24+32" ;;
  esac
}

do_status() {
  ver="$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null)"
  n_app="$(count_applied)"; n_tot="$(count_targets)"
  if [ "$n_app" -gt 0 ] 2>/dev/null; then
    if [ "$n_app" = "$n_tot" ]; then mnt="active  (bind-mounted, $n_app file(s))"
    else mnt="partially active ($n_app of $n_tot file(s))"; fi
  else
    mnt="inactive (factory policy in use)"
  fi
  if [ "$HAL_PATCH" != 1 ]; then
    hal_txt="disabled (policy XML only)"
  elif [ "$(count_hal)" = 0 ]; then
    hal_txt="not present on this ROM (no libalsautils*.so)"
  elif [ "$(count_hal_applied)" != 0 ]; then
    hal_txt="active ($(count_hal_applied) of $(count_hal) library/ies unlocked)"
  else
    hal_txt="inactive ($(count_hal) library/ies still at the factory ceiling)"
  fi
  # the ROM's own policy dialect -- read-only, so `status` can say WHICH kind of
  # file the module is dealing with (and explain a HIDL ROM with no AIDL policy)
  DIALECT="$(current_dialect)"
  cat <<EOF
HiFi SRC Bypass  (universal USB / wired SRC bypass)
  module version : ${ver:-?}
  module id      : $MOD_ID
  enabled        : $([ "$ENABLED" = 1 ] && echo yes || echo no)
  policy mount   : $mnt
  HAL layer      : $hal_txt
  policy dialect : ${DIALECT:-unknown}$([ "$DIALECT" = qti ] && echo " (Qualcomm AIDL)" || true)$([ "$DIALECT" = aosp ] && echo " (AOSP / HIDL)" || true)
  factory backup : $([ -d "$STATE/stock" ] && ls -1 "$STATE/stock" 2>/dev/null | wc -l | tr -d ' ') archived file(s)
  mixer rate     : $MIXER_RATE Hz $([ "$MIXER_RATE" = 48000 ] && echo "(factory-typical)")$([ "$MIXER_RATE" = 44100 ] && echo "(44.1k library aligned)")$([ "$MIXER_RATE" = 192000 ] && echo "(high-rate mixer)")$([ "$MIXER_RATE" = 384000 ] && echo "(max-rate mixer)")
  hifi port rate : $HIFI_RATE$([ "$HIFI_RATE" = auto ] && echo " (stock: follows the DAC maximum)")$([ "$HIFI_RATE" != auto ] && echo " Hz (pinned: $HIFI_RATE content plays without resampling, the rest is resampled UP)")
  direct ceiling : $MAX_RATE Hz
  bit depth      : ${BIT_DEPTH}bit -> $(bitdepth_profiles "$BIT_DEPTH")
  speaker rate   : $SPK_RATE$([ "$SPK_RATE" = auto ] && echo " (factory)")$([ "$SPK_RATE" != auto ] && echo " Hz (pinned)")
  speaker bits   : ${SPK_BITS}bit$([ "$SPK_BITS" = 16 ] && echo " (factory)" || echo " -> speaker/earpiece ports extended to ${SPK_BITS}bit")
  speaker loud   : $SPK_LOUD$(_loud_txt)
  ceilings avail : $ALL_RATES
  bitdepth avail : $ALL_BITS
  dsp enforce    : $SPK_DSP_BITS$([ "$SPK_DSP_BITS" = 16 ] && echo " (off: no property injected)" || echo " -> persist.vendor.audio_hal.dsp_bit_width_enforce_mode=$SPK_DSP_BITS on apply")
  device / sdk   : $(getprop ro.product.device) / $(getprop ro.build.version.sdk)
  selinux        : $(getenforce 2>/dev/null || echo unknown)
  audio service  : $(getprop init.svc.audioserver)
EOF
  printf '\n  policy files (the framework ceiling)\n'
  lp="$(loaded_policy_file)"
  if [ -r "$TGT" ]; then
    n_shown=0
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      is_hal_target "$live" && continue
      n_shown=$((n_shown + 1))
      if is_mounted "$live"; then s="[mounted]"; else s="[factory]"; fi
      if [ -n "$lp" ] && [ "$live" = "$PROOT$lp" ]; then
        printf '    %-10s %s\n               <= the framework loads THIS one\n' "$s" "$live"
      else
        printf '    %-10s %s\n' "$s" "$live"
      fi
    done < "$TGT"
    [ "$n_shown" = 0 ] && printf '    (none -- this ROM exposes no patchable XML policy)\n'
    csd="$(config_source_desc)"
    if [ -n "$lp" ]; then
      printf '    framework config source : %s\n' "$csd"
    elif [ -n "$csd" ]; then
      printf '    framework config source : %s\n' "$csd"
      printf '    (not a file -- the HAL carries the policy; nothing to prefer)\n'
    else
      printf '    framework config source : unknown (audioserver not running yet)\n'
    fi
  else
    printf '    (not scanned yet -- run: hifi apply, or: hifi scan)\n'
  fi
  # QTI AIDL dialects lock the DSP mixing path to a 48k clock granularity: a
  # 44.1k mixer rate was verified on a OnePlus 13 to produce periodic pops on
  # the speaker path.  Warn-only, and only on QTI AIDL devices (MTK / HIDL
  # mixes 44.1k cleanly -- Redmi Note 11T Pro verified).
  maybe_warn_qti_mixer44k
  printf '\n  USB HAL libraries (the hardware ceiling)\n'
  if [ "$HAL_PATCH" != 1 ]; then
    printf '    disabled -- enable with: hifi set hal 1\n'
  elif [ -r "$TGT" ]; then
    n_shown=0
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      is_hal_target "$live" || continue
      n_shown=$((n_shown + 1))
      if is_mounted "$live"; then s="[mounted]"; else s="[factory]"; fi
      printf '    %-10s %-44s ceiling %s Hz\n' "$s" "$live" "$(hal_ceiling "$live")"
    done < "$TGT"
    [ "$n_shown" = 0 ] && printf '    (none found -- libalsautils{,v2}.so is absent here)\n'
  else
    printf '    (not scanned yet -- run: hifi apply, or: hifi scan)\n'
  fi
  printf '\n'
  cmd_dac
  printf '\n'
  printf 'one-tap restore : hifi restore      (or the WebUI button)\n'
  printf 'deep check      : hifi doctor       (four layers of evidence)\n'
  printf 'full uninstall  : remove the module in your manager, all residue is wiped\n'
}

# ==================================================================== report
# A world-readable snapshot for remote diagnosis.
#
# Everything useful lives where only root can read it: /data/adb is 0700 and on
# a hardened ROM the vendor libraries cannot even be `stat`ed by the adb shell
# (`ls -l` prints -?????????).  So the module has to *produce* the report itself
# -- and it already runs as root at boot.  It lands in /data/local/tmp, which
# plain `adb pull` can fetch with no root at all.
REPORT_OUT=/data/local/tmp/hifi_src_bypass_report.txt

do_report() {
  out="${1:-$REPORT_OUT}"
  case "$out" in
    /*) ;;
    *)  out="$REPORT_OUT" ;;
  esac
  {
    printf '=== HiFi SRC Bypass -- device report ===\n'
    printf 'generated    : %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'trigger      : %s\n' "${HIFI_REPORT_WHY:-manual}"
    printf 'module dir   : %s\n' "$MODDIR"
    printf 'state dir    : %s\n' "$STATE"
    printf '\n-- device --\n'
    printf 'device       : %s (%s)\n' "$(getprop ro.product.device)" "$(getprop ro.product.model)"
    printf 'soc          : %s %s\n' "$(getprop ro.soc.model)" "$(getprop ro.board.platform)"
    printf 'sdk          : %s\n' "$(getprop ro.build.version.sdk)"
    printf 'rom          : %s\n' "$(getprop ro.build.display.id)"
    printf 'selinux      : %s\n' "$(getenforce 2>/dev/null)"
    printf 'audioserver  : %s\n' "$(getprop init.svc.audioserver)"
    printf '\n-- settings in effect --\n'
    sed 's/^/  /' "$CONF" 2>/dev/null
    printf '\n-- controller status --\n'
    do_status 2>&1
    printf '\n-- target list --\n'
    sed 's/^/  /' "$TGT" 2>/dev/null
    printf '\n-- scan report (why each file was patched or skipped) --\n'
    sed 's/^/  /' "$REPORT" 2>/dev/null
    printf '\n-- what the framework says its config source is --\n'
    printf '  raw      : %s\n' "$(config_source_desc 2>/dev/null)"
    printf '  as a path: %s\n' "$(loaded_policy_file 2>/dev/null)"
    printf '  (blank path is normal on AIDL HAL ROMs, e.g. \"Config source: AIDL HAL\")\n'
    printf '\n-- live bind mounts --\n'
    awk '$2 ~ /alsautils|audio_policy|audio_module_config/ { print "  " $1 " -> " $2 }' "$MOUNTS" 2>/dev/null
    printf '\n-- USB HAL libraries on this ROM, and the ceiling in each --\n'
    printf '  (ALREADY-UNLOCKED = the library is already at the requested ceiling -- healthy steady state, nothing to fix)\n'
    seen=""
    for hd in $HAL_DIRS; do
      for hl in $HAL_LIBS; do
        hf="$PROOT$hd/$hl"
        [ -f "$hf" ] || continue
        # /system/vendor is a symlink to /vendor on many ROMs, so the same
        # library shows up under two spellings -- resolve before listing it
        hr="$(realpath_of "$hf")"
        case " $seen " in *" $hr "*) continue ;; esac
        seen="$seen $hr"
        hmsg="$(sh "$HALPATCH" --check "$hr" "$MAX_RATE" 2>&1)"
        hrc=$?
        # decode the probe's exit code into a plain-language status word so
        # non-technical users stop reading healthy steady states as errors
        case "$hrc" in
          0) hstat=FACTORY-TABLE ;;
          4|7) hstat=ALREADY-UNLOCKED ;;
          3) hstat=NOT-USB-HAL ;;
          6) hstat=TABLE-TWICE ;;
          *) hstat=REFUSED ;;
        esac
        printf '  %-44s rc=%s [%s] %s\n' "$hr" "$hrc" "$hstat" "$hmsg"
      done
    done
    printf '\n-- archived factory copies --\n'
    ls -l "$STATE/stock" 2>/dev/null | sed 's/^/  /'
    printf '\n-- log tail --\n'
    tail -n 90 "$LOG" 2>/dev/null | sed 's/^/  /'
    printf '\n=== end of report ===\n'
  } > "$out" 2>&1
  chmod 0644 "$out" 2>/dev/null
  chown 0:0 "$out" 2>/dev/null
  printf '%s\n' "$out"
}

do_ports() {
  if [ ! -s "$REPORT" ]; then
    printf 'no report yet -- run: hifi scan\n'
    return 1
  fi
  printf 'policy files on this device:\n'
  sed 's/^/  /' "$REPORT" 2>/dev/null
  printf '\nports the patcher recognises as patchable:\n'
  if [ -r "$TGT" ]; then
    while IFS='|' read -r live patched stk; do
      [ -n "$patched" ] || continue
      case "$live" in
        *.so)
          printf '  %s\n      (USB HAL library -- sample-rate table, not XML ports)\n' "$live"
          continue ;;
      esac
      if is_volume_target "$live"; then
        printf '  %s\n      (volume table -- speaker/music curve, not a port list)\n' "$live"
        continue
      fi
      printf '  %s\n' "$live"
      sed -n "s/.*$MARKER | ports=\([^|]*\)|.*/    \1/p" "$patched" 2>/dev/null \
        | tr ',' '\n' | sed 's/^/      /'
    done < "$TGT"
  fi
  return 0
}

do_files() {
  if [ ! -r "$TGT" ]; then printf 'nothing scanned yet\n'; return 1; fi
  n_hal="$(count_hal)"
  printf '%-10s %-7s %-44s %s\n' STATE LAYER LIVE PATCH
  while IFS='|' read -r live patched stk; do
    [ -n "$live" ] || continue
    if target_applied "$live"; then s=mounted; else s=factory; fi
    if is_hal_target "$live"; then k=HAL
    elif is_volume_target "$live"; then k=volume
    else k=policy
    fi
    printf '%-10s %-7s %-44s %s\n' "$s" "$k" "$live" "$patched"
  done < "$TGT"
  n_vol="$(count_volume)"
  printf '\n  policy : %s file(s)   HAL : %s library/ies   volume : %s table(s)\n' \
         "$(( $(count_targets) - n_hal - n_vol ))" "$n_hal" "$n_vol"
  printf '\narchives:\n'
  ls -l "$STATE/stock" 2>/dev/null | sed 's/^/  /'
}

do_boot() {
  load_conf
  [ "$ENABLED" = 1 ] || { log "module disabled, factory policy left untouched"; return 0; }
  # ---- boot safety net v1.9.2 (P0-3 first boot + degraded mark) ------------
  # STATE comes from the standard global (L58, honors HIFI_STATE_DIR).
  # A degraded mark means a previous boot pass timed out or audioserver
  # rejected the patch: do not spend post-fs-data time mounting again -- the
  # late_start pass in service.sh owns the decision from here on.
  if [ -e "$STATE/boot_degraded" ]; then
    log "boot degraded mark present: skipping boot mount, late_start will decide"
    return 0
  fi
  # First boot after (re)installation: only prepare everything, do not mount.
  # This bounds the post-fs-data cost on an unknown ROM to the pure
  # discover+patch+verify pass, which the K80 stall showed can be slow; the
  # mount itself happens on the NEXT boot once the preparation is proven.
  # `hifi apply` (manual) is intentionally NOT affected by this gate.
  # NOTE: the marker check above runs BEFORE enter_global_ns, which execs and
  # re-enters the script -- a check placed after it would run twice.
  if [ ! -e "$STATE/firstboot_done" ]; then
    mkdir -p "$STATE" 2>/dev/null
    : > "$STATE/firstboot_done" 2>/dev/null
    log "first boot: preparing patches without mounting (P0-3); mount deferred to next boot"
    # Prepare without mounting and without touching the audio stack: reuse the
    # battle-tested boot pass, then undo whatever it mounted.  undo_mount only
    # umounts + copies back from the archive; no audioserver interaction.
    enter_global_ns boot
    apply_mount || true
    undo_mount || true
    log "first boot preparation done; reboot to activate"
    return 0
  fi
  enter_global_ns boot
  apply_mount || true
  return 0
}

do_apply() {
  enter_global_ns apply
  load_conf
  # P0-5: the boot self-heal may re-apply while the audio stack is crash-looping,
  # so it passes --no-restart / HIFI_NO_RESTART=1 / HIFI_TRANSIENT=1.  load_conf
  # folds all three into $RESTART, but the argument form is checked here as well
  # so `hifi apply --no-restart` works as a standalone command line too.
  case "${1:-}" in
    --no-restart|0) RESTART=0 ;;
    1)              RESTART=1 ;;
  esac
  # `apply` is an explicit "turn it on": clear a previous restore and persist
  # it, otherwise a one-tap restore would silently swallow every later apply.
  if [ "$ENABLED" != 1 ]; then
    ENABLED=1
    log "enabling the patch (ENABLED=1)"
  fi
  apply_mount || { save_conf; return 1; }
  save_conf
  # ---- P0-2 follow-up: an explicit apply hands back a full retry budget ------
  # `apply` is the user (or action.sh) saying "turn it on": it already clears a
  # previous restore just above.  The circuit-breaker counter counts *boots whose
  # audioserver came up unhealthy* (service.sh L70-86) and has served its whole
  # purpose the moment it disabled auto-start.  Carrying it across a successful
  # re-apply would make the NEXT unhealthy boot trip the breaker instantly: the
  # user sees the module switch itself off again after a single bad boot, with
  # no second chance, even though re-applying was an explicit request.
  # Cleared on success ONLY:
  #   * a failed apply_mount returns above -- its exit path persists the config
  #     for a later attempt and deliberately leaves the history alone;
  #   * a successful one means a full target list was mounted and verified
  #     again, which is a genuinely clean slate for what was being counted.
  # service.sh L91 remains the other, independent clear (a healthy boot clears
  # the history even when the user asked for nothing).
  if [ -r "$STATE/bootfail.count" ]; then
    bf_prev="$(head -n1 "$STATE/bootfail.count" 2>/dev/null | tr -d '[:space:]')"
    rm -f "$STATE/bootfail.count" 2>/dev/null
    # speak up only for a real count (a stale 0 / garbage is not a history)
    case "$bf_prev" in
      ''|0|*[!0-9]*) : ;;
      *) log "boot-failure history cleared (previous count=$bf_prev)" ;;
    esac
  fi
  # one decision point, shared with do_restore (see restart_suppressed)
  maybe_restart_audio apply
  # refresh the snapshot: otherwise it still describes the *previous* boot,
  # which is exactly the wrong thing to hand to whoever is debugging
  # WP1: force the ADSP bit width when the user asked for it.  Pure property
  # injection -- the HAL reads it when (re)started, no file is touched.
  # 16 injects nothing and never clears a previous value: clearing is
  # restore's job, so a plain re-apply keeps the running mode intact.
  case "$SPK_DSP_BITS" in
    24|32)
      setprop persist.vendor.audio_hal.dsp_bit_width_enforce_mode "$SPK_DSP_BITS" \
        && log "dsp_bit_width_enforce_mode=$SPK_DSP_BITS injected (takes effect when the audio HAL restarts)"
      ;;
  esac
  # smart PA layer: config-driven runtime tinymix writes, AFTER the dsp
  # injection and BEFORE the report.  Empty / reset = nothing is touched.
  pa_apply_conf
  # QTI AIDL + mixer 44100 = periodic pops on the speaker path (OnePlus 13
  # verified): warn in the apply output the user actually reads.  Warn-only.
  maybe_warn_qti_mixer44k
  do_report >/dev/null 2>&1
  return 0
}

do_restore() {
  enter_global_ns restore
  load_conf
  # P0-4 calls this as `restore --no-restart` while audioserver is crash-looping
  # (service.sh).  The argument is honoured on top of HIFI_NO_RESTART /
  # HIFI_TRANSIENT, which load_conf already folded into $RESTART.
  case "${1:-}" in
    --no-restart|0) RESTART=0 ;;
    1)              RESTART=1 ;;
  esac
  log "=== one-tap restore: going back to the factory audio policy ==="
  undo_mount || true
  ENABLED=0
  save_conf
  # the factory file was never written to; but if something else overwrote it,
  # put the archive back
  if [ -r "$TGT" ]; then
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      if [ ! -e "$live" ] && [ -r "$stk" ]; then
        log "! $live disappeared -- restoring it from the archive"
        cp -f "$stk" "$live" 2>/dev/null && log "factory file written back: $live"
      fi
    done < "$TGT"
  fi
  # WP1: pull the ADSP bit-width enforce property back out.  Restore must
  # leave zero module state behind, and setprop depends on no audio service,
  # so it is safe even on a crash-looping stack (the P0-5 rule).
  case "$SPK_DSP_BITS" in
    24|32) _clear_dsp=1 ;;
    *)     _clear_dsp=0 ;;
  esac
  # a value left over from an older config must go too: query, then clear
  if [ "$_clear_dsp" = 0 ] \
     && [ -n "$(getprop persist.vendor.audio_hal.dsp_bit_width_enforce_mode 2>/dev/null)" ]; then
    _clear_dsp=1
  fi
  if [ "$_clear_dsp" = 1 ]; then
    setprop persist.vendor.audio_hal.dsp_bit_width_enforce_mode "" \
      && log "dsp_bit_width_enforce_mode cleared (factory ADSP bit width restored)"
  fi
  # ---- speaker loudest-mode codec layer ------------------------------------
  # `hifi restore` must leave ZERO module state behind, and SPK_LOUD is state
  # that lives in the CODEC, not in a file: leaving IIR0 filtering at 160 Hz
  # after a restore would mean the phone keeps a handset-specific EQ nobody
  # asked for any more.  Unconditional (whatever SPK_LOUD says now): an older
  # config or a crashed run may have written the coefficients without the
  # value surviving.  Restore is a read-modify-write of controls that already
  # exist -- no audio service needed, so it is safe on a crash-looping stack.
  iir_restore_hp || true
  spk_digital_restore
  log "factory policy is in use again; the module stays installed but inert"
  log "re-enable with: hifi apply   (or the WebUI button)"
  # F2: this is the call the P0-4 emergency exit makes on a crash-looping
  # audioserver, so it must go through the same suppression gate as do_apply.
  maybe_restart_audio restore
  do_report >/dev/null 2>&1
  return 0
}

do_set() {
  key="${1:-}"; val="${2:-}"
  # HIFI_TRANSIENT=1 : change the value FOR THIS RUN ONLY and do not rewrite
  # config.conf.  service.sh's boot self-heal needs exactly this -- it has to
  # apply/restore with the audio restart suppressed (the stack may be
  # crash-looping), but it must not silently persist that decision: the user's
  # own RESTART=1 would be permanently downgraded to 0 with no recovery point.
  # Without this flag the old comment "zero it for this run without saving" was
  # simply false -- do_set's restart branch fell straight through to save_conf.
  transient=0
  [ "${HIFI_TRANSIENT:-0}" = 1 ] && transient=1
  case "$key" in
    mixer|mixer_rate)
      ok=0
      for r in $ALL_MIXER; do [ "$r" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "mixer must be one of: $ALL_MIXER"; return 1; }
      MIXER_RATE="$val" ;;
    hifirate|hifiport)
      ok=0
      for r in $ALL_HIFI; do [ "$r" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "hifirate must be one of: $ALL_HIFI"; return 1; }
      HIFI_RATE="$val" ;;
    max|max_rate)
      ok=0
      for r in $ALL_RATES; do [ "$r" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "max must be one of: $ALL_RATES"; return 1; }
      MAX_RATE="$val" ;;
    bitdepth|bits|bit_depth)
      ok=0
      for b in $ALL_BITS; do [ "$b" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "bitdepth must be one of: $ALL_BITS"; return 1; }
      BIT_DEPTH="$val" ;;
    spk|spk_rate)
      ok=0
      for r in $ALL_SPK; do [ "$r" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "spk must be one of: $ALL_SPK"; return 1; }
      SPK_RATE="$val" ;;
    spkbits|spk_bits)
      ok=0
      for b in $ALL_SPK_BITS; do [ "$b" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "spkbits must be one of: $ALL_SPK_BITS"; return 1; }
      SPK_BITS="$val" ;;
    spkdsp|spk_dsp_bits)
      ok=0
      for b in $ALL_SPKDSP; do [ "$b" = "$val" ] && ok=1; done
      [ "$ok" = 1 ] || { echo "spkdsp must be one of: $ALL_SPKDSP"; return 1; }
      SPK_DSP_BITS="$val" ;;
    speloud|speakerloud|spk_loud)
      # Speaker loudness mode.  Numeric only (0/1/2) -- the words on/off are
      # deliberately NOT accepted: "1" and "2" mean different amounts of
      # intervention, so an alias that silently picks one of them would be a
      # coin flip on the user's loudspeaker.
      case "$val" in
        0|1|2) SPK_LOUD="$val" ;;
        *) echo "speloud must be one of: 0 1 2   (0 = off, 1 = IIR high-pass only, 2 = + digital volume down to 72)"; return 1 ;;
      esac ;;
    enabled|enable)
      case "$val" in 1|on|true) ENABLED=1 ;; 0|off|false) ENABLED=0 ;;
        *) echo "enabled must be 0 or 1"; return 1 ;; esac ;;
    restart)
      case "$val" in 1|0) RESTART="$val" ;;
        *) echo "restart must be 0 or 1"; return 1 ;; esac
      # an explicit `set restart` IS a user decision, so it becomes the value
      # that gets persisted (unless this call is the transient self-heal)
      [ "$transient" = 1 ] || RESTART_PERSIST="$RESTART" ;;
    hal|hal_patch)
      case "$val" in
        1|on|true)   HAL_PATCH=1 ;;
        0|off|false) HAL_PATCH=0 ;;
        *) echo "hal must be 0 or 1"; return 1 ;;
      esac ;;
    volunlock|vol_unlock|volume)
      case "$val" in
        1|on|true)   VOL_UNLOCK=1 ;;
        0|off|false) VOL_UNLOCK=0 ;;
        *) echo "volunlock must be 0 or 1"; return 1 ;;
      esac ;;
    *) echo "unknown key: $key"; return 1 ;;
  esac
  # turning the HAL layer on/off changes which files are even candidates.
  # Only the candidate cache is dropped -- targets.lst is left alone, because
  # `hifi restore` still needs it to unmount the currently active targets.
  case "$key" in
    # turning a layer on/off changes which files are candidates AND which of
    # them are patched; the cache is recomputed so a stale entry can never keep
    # a volume table out of (or inside) the list
    hal|hal_patch|volunlock|vol_unlock|volume) rm -f "$CACHE" 2>/dev/null ;;
  esac
  if [ "$transient" = 1 ]; then
    # the value is live for this process only; config.conf keeps the user's
    # own setting, so the next boot starts from what the user chose
    printf '%s = %s (transient: config.conf left untouched)\n' "$key" "$val"
    return 0
  fi
  save_conf
  printf '%s = %s\n' "$key" "$val"
  case "$key" in
    max|max_rate|bitdepth|bits|bit_depth|spkbits|spk_bits|hal|hal_patch)
      printf 'run: hifi apply   (and, for a changed ceiling, hifi restore first)\n' ;;
    spk|spk_rate)
      printf 'run: hifi apply\n' ;;
    spkdsp|spk_dsp_bits)
      printf 'run: hifi apply   (16 = off: nothing is injected, an old value is cleared by hifi restore)\n' ;;
    volunlock|vol_unlock|volume)
      printf 'run: hifi apply   (1 = the last %s speaker/music volume steps go to 0 dB; 0 = factory curve)\n' "$VOL_POINTS" ;;
    speloud|speakerloud|spk_loud)
      # Deliberately NOT "run: hifi apply": every other key here changes files
      # the apply step mounts, this one drives runtime codec controls that
      # `hifi speaker loud` writes directly.  Pointing at the wrong verb would
      # leave the user with a persisted 1 and an untouched codec.
      case "$SPK_LOUD" in
        0) printf 'run: hifi speaker auto   (0 = 不碰：IIR 高通与数字音量都还原出厂)\n' ;;
        *) printf 'run: hifi speaker loud   (立即写入；%s)\n' \
             "$([ "$SPK_LOUD" = 2 ] && echo '1 = 只做 IIR 高通, 2 = 额外允许数字音量压到 72' || echo '1 = 只做 IIR 高通')" ;;
      esac ;;
  esac
  return 0
}

do_preset() {
  case "${1:-}" in
    auto|detect|highest)
      rep="$(usb_dac_report 2>/dev/null)"
      if [ -z "$rep" ]; then
        echo "自动识别失败：没有检测到 USB 音频设备。"
        echo "  请先插好小尾巴（或拔插一次），再重试；也可以手动选档位。"
        return 1
      fi
      line="$(printf '%s\n' "$rep" | head -n1)"
      dn="$(printf '%s' "$line" | cut -d'|' -f2)"
      dfm="$(printf '%s' "$line" | cut -d'|' -f4)"
      dmax="$(printf '%s' "$line" | cut -d'|' -f5)"
      new_max="$(rate_ceiling_of "$dmax")"
      new_bits="$(bits_of "$dfm")"
      MIXER_RATE=48000; MAX_RATE="$new_max"; BIT_DEPTH="$new_bits"; ENABLED=1
      msg="自动识别：$dn
  上报能力 : 最高 ${dmax} Hz / $dfm
  已配置   : 采样率上限 ${new_max} Hz / 位深 ${new_bits} bit / 混音 48000 Hz
  （策略档位取的是\"不超过解码器上报值\"的最大档；位深取的是它支持的最高位深）"
      [ "$dmax" -gt "$new_max" ] 2>/dev/null && msg="$msg
  注意     : 解码器上报 ${dmax} Hz 高于本模块最高档 ${new_max} Hz，已按 ${new_max} Hz 配置。"
      ;;
    384k|cx31993|max|hifi)
      MIXER_RATE=48000; MAX_RATE=384000; BIT_DEPTH=32; ENABLED=1
      msg="384 kHz 满血模式 - CX31993 / 支持 384k 的 USB 小尾巴（位深 32bit）" ;;
    192k|master|safe|compat)
      MIXER_RATE=48000; MAX_RATE=192000; BIT_DEPTH=24; ENABLED=1
      msg="192 kHz 超清母带 Master 档 - 上限 192k 的设备（位深 24bit）" ;;
    96k)
      MIXER_RATE=48000; MAX_RATE=96000; BIT_DEPTH=24; ENABLED=1
      msg="96 kHz 高清臻音模式 - 96k/24bit 档" ;;
    44k|44100|src)
      MIXER_RATE=44100; MAX_RATE=384000; BIT_DEPTH=32; ENABLED=1
      msg="44.1 kHz 全局对齐 - 曲库以 44.1k 为主时消除系统重采样" ;;
    192mix|mix192|192kmix)
      MIXER_RATE=192000; MAX_RATE=384000; BIT_DEPTH=32; ENABLED=1
      msg="192 kHz 全局混音 - 混音器提升到 192k，44.1k / 48k 音源走整数倍升采样（位深 32bit）" ;;
    384mix|mix384|384kmix)
      MIXER_RATE=384000; MAX_RATE=384000; BIT_DEPTH=32; ENABLED=1
      msg="384 kHz 全局混音 - 混音器拉满到 384k（对 SoC 与 USB 带宽压力最大，仅高端机型建议）" ;;
    *)
      echo "preset must be one of: auto | 384k | 192k | 96k | 44k | 192mix | 384mix"
      echo "  auto / detect  : 自动识别小尾巴上限并配置（推荐）"
      echo "  384k / cx31993 : MAX_RATE=384000 MIXER_RATE=48000 BIT_DEPTH=32"
      echo "  192k / master  : MAX_RATE=192000 MIXER_RATE=48000 BIT_DEPTH=24"
      echo "  96k            : MAX_RATE=96000  MIXER_RATE=48000 BIT_DEPTH=24"
      echo "  44k            : MAX_RATE=384000 MIXER_RATE=44100 BIT_DEPTH=32"
      echo "  192mix         : MAX_RATE=384000 MIXER_RATE=192000 BIT_DEPTH=32"
      echo "  384mix         : MAX_RATE=384000 MIXER_RATE=384000 BIT_DEPTH=32"
      return 1 ;;
  esac
  save_conf
  echo "$msg"
  echo "applying..."
  do_apply
}

# ============================================== speaker: hardware IIR high-pass
# 为什么要高通，而不是继续推功放增益
# ---------------------------------------------------------------------------
# 真机声学实测（原厂 0dB 档 vs 模块 +6dB 档，两条录音全采样分析）：
#   RMS 差 -0.41 dB、1000 Hz 基波差 -0.37 dB、峰值差 -0.45 dB —— 同一输出。
# 原因在硬件固件里：TFA9874 的 G_DEFAULT 本身就等于满载 G_6_DB，推功放增益
# 是零收益。真正吃掉响度的是振膜行程：小型扬声器发不出 100~200 Hz 以下的
# 超低频，那些频率只会把振膜推到底，触发 TFA 的 DSP 限幅器，连带把中高频
# 一起压下去。所以正确的做法是「砍掉发不出来的部分」，把行程留给能发声的
# 频段，中高频因此可以更响 —— 且不增加任何硬件功率风险。
#
# Qualcomm 硬件 IIR：5 个双二阶带（IIR0 Band1..5），每带 5 个系数
#   b0 b1 b2 a1 a2      (a0 归一化为 1)
# Q30 有符号定点（1.0 == 2^30）。系数按 RBJ cookbook 的 HPF（Q=0.7071，
# 即 Butterworth 二阶）在**运行时按实际 FS 现场计算**，verification 用一个
# 已知采样率的内置表逐位自校验 —— 算错就一个字都不写。
IIR_HP_F=160                      # 截止频率 (Hz)：低于小型扬声器有效下限
IIR_HP_Q=0.7071067811865476       # Butterworth (Q = sqrt(1/2))
IIR_BAND=1                        # 用 Band1；Band2..5 保持出厂 0（旁路）
IIR_FS_DEFAULT=48000              # 取不到真实播放率时的回退（模块的出厂混音率）
# 内置校验表：这两个值是设计院算好的基准，awk 现场算必须逐位相等。
IIR_REF_48K="1057957290 -2115914580 1057957290 -2115682527 1042404809"
IIR_REF_44K1="1056572595 -2113145190 1056572595 -2112870635 1039677921"

# awk 的系数计算+自校验，全模块只有这一份。输出两种形态：
#   成功 : "<b0> <b1> <b2> <a1> <a2>"
#   失败 : "FAIL:<原因>"   (调用方据此跳过，绝不写半套系数)
#
# 为什么连稳定性一起查：写一半的系数（b 换了 a 没换）会让极点跑出单位圆，
# 那是自激 —— 比不写糟得多。所以这里同时验极点模长与三个频点的幅频响应。
IIR_AWK='
function rnd(x) { return x < 0 ? int(x - 0.5) : int(x + 0.5) }
function mag(f,  B0,B1,B2,A1,A2,qq,w,nr,ni,dr,di) {
  B0=C0; B1=C1; B2=C2; A1=D1; A2=D2; qq=q
  w = 2*pi*f/fs
  nr = B0 + B1*cos(w) + B2*cos(2*w); ni = -(B1*sin(w) + B2*sin(2*w))
  dr = qq + A1*cos(w) + A2*cos(2*w); di = -(A1*sin(w) + A2*sin(2*w))
  return sqrt(nr*nr+ni*ni)/sqrt(dr*dr+di*di)
}
BEGIN {
  fc = FC; Q = QQ; pi = atan2(0, -1); q = 2^30
  if (fs < 8000) { print "FAIL:采样率 " fs " 过低"; exit 1 }
  w0 = 2*pi*fc/fs; cw = cos(w0); sw = sin(w0)
  al = sw/(2*Q); a0 = 1 + al
  C0 = rnd((1+cw)/2/a0*q); C1 = rnd(-(1+cw)/a0*q); C2 = C0
  D1 = rnd(-2*cw/a0*q);    D2 = rnd((1-al)/a0*q)
  a1 = -2*cw/a0; a2 = (1-al)/a0
  # 极点在单位圆内：|a2| < 1 且 |a1| < 1 + a2（二阶实系数稳定判据）
  if (a2 >= 1 || a2 <= -1) { print "FAIL:极点越界 a2=" a2; exit 1 }
  if (a1 >= 1+a2 || a1 <= -(1+a2)) { print "FAIL:极点越界 a1=" a1; exit 1 }
  m_c = mag(fc); m_1k = mag(1000); m_50 = mag(50)
  if (m_c < 0.69 || m_c > 0.72) { printf "FAIL:fc 增益 %.5f\n", m_c; exit 1 }
  if (m_1k < 0.99)              { printf "FAIL:1k 增益 %.5f\n", m_1k; exit 1 }
  if (m_50 > 0.15)              { printf "FAIL:50 增益 %.5f\n", m_50; exit 1 }
  print C0, C1, C2, D1, D2
}'

# 真实播放采样率。优先级（先准后稳）：
#   1. 该 PCM 设备的 hw_params —— 实际正在跑的时钟，最准；
#   2. SPK_RATE（用户钉住的扬声器端口率）；
#   3. MIXER_RATE —— 模块自己的出厂混音率。
# 三个都读不到才回退 IIR_FS_DEFAULT，并把来源写进输出，用户看得到依据。
# 为什么不直接写死 48k：44.1k 库把混音率钉到 44100 是模块的官方用法，
# 那时按 48k 算出来的高通会整体偏移到 174 Hz（多砍 14 Hz 的真实低频）。
iir_fs_of() {
  _hw="$ASOUND/card0/pcm0p/sub0/hw_params"
  if [ -r "$_hw" ]; then
    _r="$(sed -n 's/^ *rate: *//p' "$_hw" 2>/dev/null | head -n1 | tr -dc '0-9')"
    [ -n "$_r" ] && { printf '%s %s' "$_r" "hw_params"; return 0; }
  fi
  case "$SPK_RATE" in
    [0-9]*) printf '%s %s' "$SPK_RATE" "SPK_RATE"; return 0 ;;
  esac
  case "$MIXER_RATE" in
    [0-9]*) printf '%s %s' "$MIXER_RATE" "MIXER_RATE"; return 0 ;;
  esac
  printf '%s %s' "$IIR_FS_DEFAULT" "default"
}

# 把 FS 换成 5 个 Q30 系数；失败返回 "FAIL:<原因>"。
# 用法： iir_coeffs_for_fs <fs>
iir_coeffs_for_fs() {
  case "${1:-}" in
    ''|*[!0-9]*) printf 'FAIL:非数字采样率 [%s]' "${1:-}"; return 1 ;;
  esac
  # shellcheck disable=SC2086
  awk -v fs="$1" -v FC="$IIR_HP_F" -v QQ="$IIR_HP_Q" "$IIR_AWK"
  return 0
}

# 已知采样率的逐位自校验。算出来跟基准表不一致 = awk 的 cos/sin 精度不够
# （busybox awk / 某些 mksh 环境的 atof 会掉精度），此时宁可不做。
# 用法： iir_selftest  -> 打印 FAIL 行并 rc=1，或全通过 rc=0
iir_selftest() {
  _st_fail=""
  for _pair in "48000:$IIR_REF_48K" "44100:$IIR_REF_44K1"; do
    _fs="${_pair%%:*}"; _want="${_pair#*:}"
    _got="$(iir_coeffs_for_fs "$_fs")"
    [ "$_got" = "$_want" ] || _st_fail="$_st_fail ${_fs}Hz"
  done
  if [ -n "$_st_fail" ]; then
    printf 'FAIL:系数自校验不通过（%s）—— 本机 awk 精度不足\n' "${_st_fail# }"
    return 1
  fi
  return 0
}

# 按名字从 tinymix 全量转储里查 numid。返回空 = 控件不存在。
# 为什么必须查 numid 而不能把名字传给 tinymix：老 tinymix 与模块自带的
# payload/tinyalsa_min.c 都用 strtoul/strtoul(argv[1], 0, 10) 解析第一个参数，
# 字符串名会被解析成 0 —— 而 0 号控件是 "Voice Rx Device Mute"，每次调用都
# 在误写语音通路，且 tinymix 返回 0（"写成功"），错误被完全吞掉。
pa_numid_of() {
  _pa_dump_norm | awk -F'\t' -v want="$1" '
    $2 == want { print $1; exit }
    # 多值 INT 控件（IIR0 Band1, count=5）归一化后名字尾部还粘着前面几个
    # 值：normaliser 的"取最后一个空白 token 当值"规则是为单值控件写的。
    # 名字前缀完整就够了，所以这里接受 "<want><空白>" 开头的行。
    index($2, want) == 1 {
      r = substr($2, length(want) + 1)
      if (r ~ /^[ \t]/) { print $1; exit }
    }'
}

# 多值 INT 控件的**整串**读回（pa_get 只留最后一个 token，count>1 时会丢值）。
# 用法： pa_get_multi <numid> <控件名>   ->  "v1 v2 v3 v4 v5"（空格分隔）
#
# 为什么不能复用 pa_get：它按 "取最后一个空白 token" 的规则为单值控件设计，
# 对 IIR0 Band1（count=5）只会返回第 5 个系数 —— 拿它做写入校验等于永远
# 只比最后一个数，前面写错也发现不了。
# 这里改成"先从行里剥掉控件名，再取开头连续的整数 token"，两种方言都成立：
#   vendor : 102\tINT\t5\tIIR0 Band1<pad>0 0 0 0 0
#   legacy : 102\tIIR0 Band1\t0 0 0 0 0
pa_get_multi() {
  _gm_num="$1"; _gm_name="$2"
  _gm_line="$($TMIX "$_gm_num" 2>/dev/null | tr -d '\r' | head -n1)"
  # 优先在行里定位控件名，把它前面的一切（numid / TYPE / count）剥掉。
  # 找不到名字时退化为"按 tab 剥字段"，再不行就整行交给 awk 取首个整数段。
  case "$_gm_line" in
    *"$_gm_name"*) _gm_rest="${_gm_line#*"$_gm_name"}" ;;
    *)             _gm_rest="$($TMIX "$_gm_num" 2>/dev/null | tr -d '\r' \
                       | awk -F'\t' '{ if (NF >= 4) print $4; else print $3 }')" ;;
  esac
  printf '%s' "$_gm_rest" | tr '\t' ' ' \
    | awk '{ s=""; n=0; for (i=1;i<=NF;i++) { if ($i ~ /^-?[0-9]+$/) { s = s (n ? " " : "") $i; n++ } else break } print s }'
}

# 多值 INT 控件（IIR0 Band1 是 count=5）的真实写入。
#
# 关键事实：模块自带的 payload/tinyalsa_min.c（旧版）对 INTEGER 类型用的是
#   for (k = 0; k < i.count; k++) v.value.integer.value[k] = atoi(val);
# 也就是把同一个 atoi(argv[2]) 复制满 5 个 slot —— "a b c d e" 会被 atoi 截成
# a，5 个系数全写成 b0。所以写完必须回读 5 个值逐个比对，对不上就判定"本机
# 不支持多值写"，把控件恢复成写入前的样子并跳过，绝不留下半套系数。
#
# 用法： pa_set_multi <numid> <控件名> <v1> <v2> <v3> <v4> <v5>
#   rc=0 已写入且回读一致；rc=1 拒绝/失败，控件已尽量回滚
pa_set_multi() {
  _pm_ctl="$1"; _pm_nm="$2"; shift 2
  _pm_want="$*"
  _pm_before="$(pa_get_multi "$_pm_ctl" "$_pm_nm")"
  _pm_wn=0; for _pm_t in $_pm_want; do _pm_wn=$((_pm_wn + 1)); done
  if ! $TMIX "$_pm_ctl" $_pm_want >/dev/null 2>&1; then
    printf '!! 控件 %s 写入命令失败（tinymix 拒绝多值写入）\n' "$_pm_ctl" >&2
    return 1
  fi
  _pm_back="$(pa_get_multi "$_pm_ctl" "$_pm_nm")"
  if [ "$_pm_back" = "$_pm_want" ]; then
    return 0
  fi
  printf '!! 控件 %s 回读不符：写入 [%s]，读回 [%s]（本机 tinymix 可能把多值写成了同一个数）\n' \
         "$_pm_ctl" "$_pm_want" "$_pm_back" >&2
  # 回滚：把读到的写入前值写回去。写不回去也要报告 —— 半套系数是自激风险。
  _pm_bn=0; for _pm_t in $_pm_before; do _pm_bn=$((_pm_bn + 1)); done
  if [ "$_pm_bn" -eq "$_pm_wn" ] && [ -n "$_pm_before" ]; then
    if $TMIX "$_pm_ctl" $_pm_before >/dev/null 2>&1; then
      _pm_rb="$(pa_get_multi "$_pm_ctl" "$_pm_nm")"
      [ "$_pm_rb" = "$_pm_before" ] || printf '!! 控件 %s 回滚后仍不一致：现在 [%s]\n' "$_pm_ctl" "$_pm_rb" >&2
    else
      printf '!! 控件 %s 回滚写入失败，请执行 hifi speaker auto 或重启设备\n' "$_pm_ctl" >&2
      return 1
    fi
  else
    # 写前读不全（控件本来就不一致）—— 退化为清零，绝不留下未知组合
    printf '!! 控件 %s 写前状态不可信，退化为清零\n' "$_pm_ctl" >&2
    _pm_zero=""; _pm_k=0
    while [ "$_pm_k" -lt "$_pm_wn" ]; do
      _pm_zero="$_pm_zero 0"; _pm_k=$((_pm_k + 1))
    done
    $TMIX "$_pm_ctl" $_pm_zero >/dev/null 2>&1 \
      || printf '!! 控件 %s 清零也失败了，请重启设备\n' "$_pm_ctl" >&2
  fi
  return 1
}

# 写一个 BOOL 控件（On/Off 与 1/0 两种方言都试）。走 pa_set，回读严格比对。
iir_set_bool() {
  _ib_ctl="$1"; _ib_on="$2"
  if pa_set "$_ib_ctl" "$_ib_on"; then
    return 0
  fi
  case "$_ib_on" in
    1) pa_set "$_ib_ctl" "on" ;;
    0) pa_set "$_ib_ctl" "off" ;;
    *) return 1 ;;
  esac
}

# 硬件 IIR 高通的可用性探测。全部只读，不写任何控件。
# 输出一行可读的结论 + 供调用方判断的变量 IIR_OK / IIR_SKIP_REASON。
#
# 为什么必须先验路由：IIR0 INP0..INP3 MUX 是 IIR 块的输入选择器，出厂值全
# 是 ZERO（没有任何通路）。此时写系数是安全的（不连通就不参与运算），但也
# 完全无效 —— 更要命的是"以为自己做了处理"这种错觉会让用户拿它跟别的调节
# 手段叠加。所以只在**确实存在可用非 ZERO 播放源时才写**，否则明说跳过原因。
iir_probe() {
  IIR_OK=0; IIR_SKIP_REASON=""
  # 1) 控件是否齐全（BOOL 使能 + INT 5 系数）。这是 IIR 块的物理存在性。
  IIR_NUM_EN="$(pa_numid_of "IIR0 Enable Band$IIR_BAND")"
  IIR_NUM_BAND="$(pa_numid_of "IIR0 Band$IIR_BAND")"
  if [ -z "$IIR_NUM_EN" ] || [ -z "$IIR_NUM_BAND" ]; then
    IIR_SKIP_REASON="本机 tinymix 里没有 IIR0 Enable Band$IIR_BAND / IIR0 Band$IIR_BAND 控件（非 Qualcomm IIR 架构）"
    return 1
  fi
  # 2) 写系数前该带的现状（还原/回滚时对照用）
  IIR_PREV_EN="$(pa_get "$IIR_NUM_EN" | tr -d '\r')"
  IIR_PREV_BAND="$(pa_get_multi "$IIR_NUM_BAND" "IIR0 Band$IIR_BAND")"
  # 3) 路由可用性：IIR0 INP0..INP3 MUX 的当前选中项 + 可用枚举列表。
  #
  # 为什么要单独列枚举：tinymix 单控件读会把整张枚举表一起回显，那正是判断
  # "本机到底有没有可接的播放源"的依据。当前选中项只要不是 ZERO/OFF，就说明
  # IIR 块已经接在某条通路上（出厂默认 ZERO = 未连通 = 写了也白写）。
  #
  # 注意 vendor 4 字段方言（一加13 真机）的单控件读形如
  #   "238\tENUM\t1\tIIR0 INP1 MUX  ZERO ...枚举表..."
  # 枚举表在尾部，所以这里只用 pa_get 取**当前值**，枚举表单独抽出来给人看。
  IIR_MUX_USABLE=""
  IIR_MUX_NAMES=""
  IIR_MUX_ALL_ZERO=1
  for _im in "IIR0 INP0 MUX" "IIR0 INP1 MUX" "IIR0 INP2 MUX" "IIR0 INP3 MUX"; do
    _in="$(pa_numid_of "$_im")"
    [ -n "$_in" ] || continue
    # 枚举全表：把控件名那一段剥掉，剩下的全大写 token 就是枚举项
    _names="$($TMIX "$_in" 2>/dev/null | tr -d '\r' \
              | tr '\t' '\n' | tr ' ' '\n' \
              | grep -E '^[A-Z][A-Z0-9_]{2,}$' \
              | grep -vE '^(MUX|IIR0|IIR1|INP[0-9]|ENUM|ZERO)$' \
              | sort -u | tr '\n' ' ')"
    IIR_MUX_NAMES="$IIR_MUX_NAMES $_names"
    _cur="$(pa_get "$_in" | tr -d '\r')"
    case "$_cur" in
      ''|ZERO|OFF|Off|off) continue ;;
    esac
    IIR_MUX_ALL_ZERO=0
    [ -n "$IIR_MUX_USABLE" ] || IIR_MUX_USABLE="$_im=$_cur"
  done
  # 有没有可接的播放源枚举项？（ZERO 之外是否存在 RX / PCM / AIF 类源）
  IIR_MUX_HAS_SRC=0
  for _mt in $IIR_MUX_NAMES; do
    case "$_mt" in
      *RX*|PCM*|AIF*|*_RX*) IIR_MUX_HAS_SRC=1; break ;;
    esac
  done
  IIR_MUX_NAMES="$(printf '%s\n' $IIR_MUX_NAMES | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/ $//')"
  if [ "$IIR_MUX_ALL_ZERO" != 0 ] || [ -z "$IIR_MUX_USABLE" ]; then
    # 没连通 = 写系数完全无效（而且会让用户以为已经处理过）。明确跳过。
    IIR_SKIP_REASON="IIR0 INP0..INP3 MUX 全部为 ZERO（出厂未接通任何播放源）"
    [ "$IIR_MUX_HAS_SRC" = 1 ] \
      && IIR_SKIP_REASON="$IIR_SKIP_REASON；本机可用源枚举: $IIR_MUX_NAMES —— 需先把播放通路接到 IIR 才能生效"
    return 1
  fi
  IIR_OK=1
  return 0
}

# 写入高通。SPK_LOUD=1/2 都走这里；mode 只影响数字音量那一段。
iir_apply_hp() {
  iir_probe || return 1
  _fs_pair="$(iir_fs_of)"
  _fs="${_fs_pair%% *}"; _fs_src="${_fs_pair#* }"
  _co="$(iir_coeffs_for_fs "$_fs")"
  case "$_co" in
    FAIL:*)
      printf '  !! 跳过 IIR：%s（采样率 %s，来源 %s）\n' "${_co#FAIL:}" "$_fs" "$_fs_src"
      return 1 ;;
  esac
  # 已知采样率要跟基准表对上；未知采样率只做稳定性与幅频自检（awk 内部已验）
  case "$_fs" in
    48000) [ "$_co" = "$IIR_REF_48K" ] || { printf '  !! 跳过 IIR：48k 系数与基准表不符（%s）\n' "$_co"; return 1; } ;;
    44100) [ "$_co" = "$IIR_REF_44K1" ] || { printf '  !! 跳过 IIR：44.1k 系数与基准表不符（%s）\n' "$_co"; return 1; } ;;
  esac
  # 先在 Off 状态写系数，再使能 —— 反过来会在运行中换系数，出爆音
  if ! iir_set_bool "$IIR_NUM_EN" 0; then
    printf '  !! 跳过 IIR：无法把 IIR0 Enable Band%s 置 Off\n' "$IIR_BAND"
    return 1
  fi
  if ! pa_set_multi "$IIR_NUM_BAND" "IIR0 Band$IIR_BAND" $_co; then
    printf '  !! 跳过 IIR：Band%s 多值写入被本机 tinymix 拒绝或读回不符（已回滚为原值）\n' "$IIR_BAND"
    return 1
  fi
  if ! iir_set_bool "$IIR_NUM_EN" 1; then
    printf '  !! 跳过 IIR：系数已写但使能失败，正在回滚\n'
    pa_set_multi "$IIR_NUM_BAND" "IIR0 Band$IIR_BAND" 0 0 0 0 0 >/dev/null 2>&1 || true
    return 1
  fi
  printf '  -> 硬件 IIR 高通已生效：%s Band%s @ %s Hz 采样率 %s（来源 %s）\n' \
         "IIR0" "$IIR_BAND" "$IIR_HP_F" "$_fs" "$_fs_src"
  printf '     系数 b0 b1 b2 a1 a2 = %s（Q30 定点，Q=%s）\n' "$_co" "$IIR_HP_Q"
  printf '     路由 %s（本机可用枚举：%s）\n' "$IIR_MUX_USABLE" "${IIR_MUX_NAMES:-?}"
  return 0
}

# 还原：使能 Off + 系数清零 + 数字音量回出厂。幂等，控件不存在就跳过。
# 为什么先关使能再清系数：顺序反了会让一个 b=0/a=出厂 的混合状态短暂通过
# IIR 块，那是纯噪声。
#
# 这里**故意不调用 iir_probe**：probe 会验路由，而还原的职责恰恰是清理，
# 哪怕路由当前是 ZERO、哪怕用户从没开过 SPK_LOUD —— 一次崩溃的运行或旧版本
# 配置都可能留下系数。只要控件存在就还原，才叫 100% 还原。
iir_restore_hp() {
  _ren="$(pa_numid_of "IIR0 Enable Band$IIR_BAND")"
  _reb="$(pa_numid_of "IIR0 Band$IIR_BAND")"
  if [ -z "$_ren" ] && [ -z "$_reb" ]; then
    printf '  -> IIR 还原：本机无 IIR0 Band%s 控件，无需还原\n' "$IIR_BAND"
    return 0
  fi
  _rr=0
  [ -n "$_ren" ] && { iir_set_bool "$_ren" 0 || _rr=1; }
  if [ -n "$_reb" ]; then
    _rz="$(pa_get_multi "$_reb" "IIR0 Band$IIR_BAND")"
    if [ "$_rz" = "0 0 0 0 0" ]; then
      printf '  -> IIR 还原：Band%s 已是 0 0 0 0 0，无需改写\n' "$IIR_BAND"
    else
      pa_set_multi "$_reb" "IIR0 Band$IIR_BAND" 0 0 0 0 0 || _rr=1
    fi
  fi
  if [ "$_rr" = 0 ]; then
    printf '  -> IIR 还原：IIR0 Enable Band%s=Off，Band%s=0 0 0 0 0（回出厂）\n' "$IIR_BAND" "$IIR_BAND"
    return 0
  fi
  printf '  !! IIR 还原未完全成功，请重启或再执行一次 hifi speaker auto\n'
  return 1
}

# ---- speaker: digital front-end volume (the ONLY direction that adds level) --
# Qualcomm 的 RXn Digital Volume 是**衰减索引**：gain_dB = (124 - v)/2，
# 数值越大声音越小。模块自己（约 2118 行）就写着 "INT 0..124, LARGER =
# QUIETER"。所以：
#   * 原来自称 +3dB 的 84 -> 90 其实是 -3dB（调小）；
#   * 只有把数字**减小**才是加音量。
# 安全下限 72（= +26 dB 相对 124 的衰减量，模块 pa_wsa 阶梯的最深一档），
# 而且只允许向下 —— 越界一律钳到 72，绝不写 71 以下。
SPK_DIGITAL_MIN=72
SPK_DIGITAL_FACTORY=84

# 把 4 个 Codec 数字前端音量控件（按 numid 查）向下压到 floor。
# 用法： spk_digital_boost <floor>
# 返回已改动的控件数量（打印在最后一行之外的都是给人看的说明）。
spk_digital_boost() {
  _db_floor="$1"
  case "$_db_floor" in
    ''|*[!0-9]*) printf '  !! 数字音量下限非法：%s\n' "$_db_floor"; return 1 ;;
  esac
  [ "$_db_floor" -ge "$SPK_DIGITAL_MIN" ] || _db_floor="$SPK_DIGITAL_MIN"
  [ "$_db_floor" -le "$SPK_DIGITAL_FACTORY" ] || _db_floor="$SPK_DIGITAL_FACTORY"
  _db_n=0
  for _db_name in "RX0 Digital Volume" "RX1 Digital Volume" \
                  "RX0 Mix Digital Volume" "RX1 Mix Digital Volume"; do
    _db_num="$(pa_numid_of "$_db_name")"
    if [ -z "$_db_num" ]; then
      printf '  ·  未找到控件 %s，跳过\n' "$_db_name"
      continue
    fi
    _db_cur="$(pa_get "$_db_num" | tr -d '\r')"
    case "$_db_cur" in
      ''|*[!0-9]*) printf '  ·  控件 %s（numid %s）读回非整数 [%s]，跳过\n' "$_db_name" "$_db_num" "$_db_cur"; continue ;;
    esac
    if [ "$_db_cur" -le "$_db_floor" ]; then
      printf '  ·  %s（numid %s）已是 %s，不再降低（下限 %s）\n' "$_db_name" "$_db_num" "$_db_cur" "$SPK_DIGITAL_MIN"
      continue
    fi
    if pa_set_int "$_db_num" "$_db_floor"; then
      printf '  ·  %s（numid %s）%s -> %s（衰减索引减小 = +%s dB，下限 %s）\n' \
             "$_db_name" "$_db_num" "$_db_cur" "$_db_floor" \
             "$(awk -v a="$_db_cur" -v b="$_db_floor" 'BEGIN{printf "%.1f", (a-b)/2}')" "$SPK_DIGITAL_MIN"
      _db_n=$((_db_n + 1))
    else
      printf '  !! %s（numid %s）写入失败，保持原值\n' "$_db_name" "$_db_num"
    fi
  done
  return "$_db_n"
}

# 数字音量还原到出厂 84（只在当前值小于 84 时写，避免无谓的控件触碰）
spk_digital_restore() {
  _dr_n=0
  for _dr_name in "RX0 Digital Volume" "RX1 Digital Volume" \
                  "RX0 Mix Digital Volume" "RX1 Mix Digital Volume"; do
    _dr_num="$(pa_numid_of "$_dr_name")"
    [ -n "$_dr_num" ] || continue
    _dr_cur="$(pa_get "$_dr_num" | tr -d '\r')"
    case "$_dr_cur" in
      ''|*[!0-9]*) continue ;;
    esac
    [ "$_dr_cur" -eq "$SPK_DIGITAL_FACTORY" ] && continue
    if pa_set_int "$_dr_num" "$SPK_DIGITAL_FACTORY"; then
      printf '  ·  %s（numid %s）%s -> %s（回出厂）\n' "$_dr_name" "$_dr_num" "$_dr_cur" "$SPK_DIGITAL_FACTORY"
      _dr_n=$((_dr_n + 1))
    else
      printf '  !! %s（numid %s）还原失败，当前 [%s]\n' "$_dr_name" "$_dr_num" "$_dr_cur"
    fi
  done
  return 0
}

# `hifi status` 的 speaker loud 一行。单独拿一个函数出来，只因为 heredoc 里
# 嵌 && / || 加多层引号太难读，且一改就出错。
_loud_txt() {
  case "${SPK_LOUD:-0}" in
    0) printf ' (off: codec untouched)' ;;
    1) printf ' (IIR high-pass %s Hz, Q=%s)' "$IIR_HP_F" "$IIR_HP_Q" ;;
    2) printf ' (IIR high-pass %s Hz + digital volume to %s)' "$IIR_HP_F" "$SPK_DIGITAL_MIN" ;;
    *) printf '' ;;
  esac
}

# ---- boot safety net v1.9.2: read-only view of the boot state ---------------
do_bootmode() {
  # STATE is already the global one (set at L58 via HIFI_STATE_DIR); the
  # HIFI_STATE override in do_boot exists because post-fs-data runs before the
  # state dir exists.  Here we only read.
  if [ -e "$STATE/boot_degraded" ]; then
    printf 'bootmode: degraded\n'
    printf '  一次开机的 boot 阶段超时或 audioserver 拒绝了补丁，本次挂载已自动跳过。\n'
    printf '  late_start（service.sh）会在确认 audioserver 健康后自动恢复。\n'
  elif [ ! -e "$STATE/firstboot_done" ]; then
    printf 'bootmode: discover-only (first boot pending)\n'
    printf '  安装/升级后的第一次开机只准备补丁不挂载（P0-3），重启后生效。\n'
  else
    printf 'bootmode: normal\n'
    printf '  boot 安全网已就绪：post-fs-data 8s 超时自保 + audioserver 不健康自动卸载。\n'
  fi
  [ -r "$STATE/bootfail.count" ] && printf 'bootfail.count: %s（连续不健康开机次数，达 2 自动关闭自启）\n' "$(cat "$STATE/bootfail.count" 2>/dev/null)"
  # P0-2 follow-up: make the way out discoverable.  Read ENABLED from the file
  # instead of $ENABLED: the `bootmode` dispatch has no load_conf, so $ENABLED
  # here is only the global default and would call every device enabled.
  bf_n=""
  [ -r "$STATE/bootfail.count" ] && bf_n="$(head -n1 "$STATE/bootfail.count" 2>/dev/null | tr -d '[:space:]')"
  case "$bf_n" in ''|*[!0-9]*) bf_n=0 ;; esac
  # $CONF, not $CONFIG: the persisted config is CONF="$STATE/config.conf" (L59).
  en="$(sed -n 's/^ENABLED=//p' "$CONF" 2>/dev/null | head -n1)"
  if [ "$bf_n" -ge 2 ] || [ "$en" = 0 ]; then
    printf '  恢复：hifi set enabled 1 && hifi apply   （重新开启并立即重挂；连续失败计数会在成功 apply 后清零）\n'
  fi
  return 0
}

do_speaker() {
  case "${1:-}" in
    loud|turbo)
      # loud 档的新语义（v2.1）：不推功放增益，改砍超低频。
      #
      # 旧实现的两个 bug（已由真机转储与声学实测确认）：
      #   Bug 1 控件名当 tinymix 参数。模块的 pa_set/pa_get 一律传数字 numid，
      #         而老 tinymix 与 payload/tinyalsa_min.c 都是 strtoul(argv[1],0,10)，
      #         字符串名被解析成 0 = "Voice Rx Device Mute"，每次都在误写语音
      #         控件，且 2>/dev/null 把错误吞了。
      #   Bug 1b 方向反了。RX0/RX1 Digital Volume 是 Qualcomm **衰减索引**：
      #         gain_dB=(124-v)/2，数值越大声音越小。84 -> 90 是 -3 dB（调小）。
      #   Bug 2  无效操作。G_DEFAULT / MAX_STATE_2 / VI=1 在真机全量转储里本来
      #         就是出厂值，整个分支一个字节都没改，只打印了成功信息。
      #
      # 保留的仍是"链路纯净"部分（端口钉率 + 位深），并把 SPK_LOUD 记为 1
      # （loud 至少要做 IIR 高通）；SPK_LOUD=2 时才允许压低数字音量。
      SPK_RATE=auto; SPK_BITS=24; ENABLED=1
      [ "${SPK_LOUD:-0}" = 0 ] && SPK_LOUD=1
      save_conf
      echo "扬声器响度最大化 loud 档：SPK_RATE=auto SPK_BITS=24 SPK_LOUD=$SPK_LOUD"
      echo "  原理：砍掉扬声器发不出的超低频，释放振膜行程，让 TFA 的 DSP 限幅器"
      echo "        不再被无效低频触发，中高频因此能推得更响（不增加硬件功率）。"
      echo "  PA 增益不再动：TFA9874 的 G_DEFAULT 在固件里就等于满载 G_6_DB，"
      echo "        真机声学实测推 +6dB 档与原厂档差 <0.5 dB（无物理收益）。"
      # ---- 系数自校验：算不出来就一个字都不写 ----------------------------
      if ! iir_selftest >/dev/null 2>&1; then
        echo "  !! 跳过硬件 IIR：本机 awk 算出的系数与内置基准表不一致（精度不足）"
        echo "     已知基准：48k = $IIR_REF_48K"
        echo "              44.1k = $IIR_REF_44K1"
      elif ! iir_apply_hp; then
        echo "  -> 硬件 IIR 高通已跳过：${IIR_SKIP_REASON:-系数或控件校验未通过}"
      fi
      # ---- 数字前端音量：只有"减小"才是加音量，且必须 >= 72 --------------
      if [ "$SPK_LOUD" = 2 ]; then
        echo "  -> SPK_LOUD=2：允许把数字前端音量（衰减索引）向下压到 $SPK_DIGITAL_MIN"
        spk_digital_boost "$SPK_DIGITAL_MIN" || true
      else
        echo "  -> SPK_LOUD=$SPK_LOUD：数字前端音量保持出厂 $SPK_DIGITAL_FACTORY（要压到 $SPK_DIGITAL_MIN 请先 hifi set speloud 2）"
      fi
      echo "  -> 还原：hifi speaker auto（IIR 关+清零、数字音量回 $SPK_DIGITAL_FACTORY）"
      ;;
    flat)
      SPK_RATE=44100; SPK_BITS=24; ENABLED=1
      save_conf
      echo "扬声器最佳实践 flat 档：SPK_RATE=44100 SPK_BITS=24（MIXER_RATE 保持 $MIXER_RATE 不动）"
      echo "  如果你的曲库以 48k 为主，请改用: hifi set spk 48000 && hifi apply"
      ;;
    hires)
      SPK_RATE=192000; SPK_BITS=32; ENABLED=1
      save_conf
      echo "扬声器实验 hires 档：SPK_RATE=192000 SPK_BITS=32（MIXER_RATE 保持 $MIXER_RATE 不动）"
      echo "  高端设备 / HiRes 扬声器实验用；如果扬声器无声请立即: hifi speaker auto"
      ;;
    auto)
      SPK_RATE=auto; SPK_BITS=16; ENABLED=1; SPK_LOUD=0
      save_conf
      echo "扬声器还原 auto 档：SPK_RATE=auto SPK_BITS=16 SPK_LOUD=0（回到原厂行为）"
      # 100% 还原三件套：IIR 使能 Off、系数清零、数字音量回 84。
      # 顺序固定（先关使能再清系数），控件不存在就跳过 —— 全部走 pa_set /
      # pa_set_multi（回读校验），不再用裸 $TMIX。
      iir_restore_hp || true
      spk_digital_restore
      if pa_detect >/dev/null 2>&1; then
        [ "$PA_BACKEND" = "tfa" ] && pa_set $TM_SPK_GAIN "G_DEFAULT" >/dev/null 2>&1 || true
      fi
      ;;
    status)
      printf 'speaker rate : %s\n' "$SPK_RATE"
      printf 'speaker bits : %s\n' "$SPK_BITS"
      printf 'speaker loud : %s%s\n' "$SPK_LOUD" \
        "$(case "$SPK_LOUD" in 0) printf ' (off: 不动 codec)';; 1) printf ' (IIR 高通 only)';; 2) printf ' (IIR 高通 + 数字音量到 72)';; esac)"
      # IIR 现状：路由可用性 + 实际使能/系数（只读，不写控件）
      if iir_probe >/dev/null 2>&1; then
        printf 'iir high-pass: 可用   Band%s enable=%s  系数=[%s]\n' "$IIR_BAND" \
               "${IIR_PREV_EN:-?}" "${IIR_PREV_BAND:-?}"
        printf '              路由 %s（可用源枚举: %s）\n' "$IIR_MUX_USABLE" "${IIR_MUX_NAMES:-?}"
      else
        printf 'iir high-pass: 不可用/未接通 -- %s\n' "$IIR_SKIP_REASON"
      fi
      # 数字前端音量现状（衰减索引，越大越小）
      for _st_name in "RX0 Digital Volume" "RX1 Digital Volume"; do
        _st_num="$(pa_numid_of "$_st_name")"
        [ -n "$_st_num" ] || continue
        _st_v="$(pa_get "$_st_num" | tr -d '\r')"
        printf '%-14s: %s%s\n' "$_st_name" "${_st_v:-n/a}" \
          "$(case "$_st_v" in ''|*[!0-9]*) : ;; 84) printf ' (出厂)';;
              *) awk -v v="$_st_v" 'BEGIN{printf " (≈ %+.1f dB vs 84)", (84-v)/2}' ;; esac)"
      done
      if [ -r "$MODDIR/bin/probe192.sh" ]; then
        HIFI_PROBE_SECTION=adapt; export HIFI_PROBE_SECTION
        sh "$MODDIR/bin/probe192.sh" 2>/dev/null | sed -n '/^\[9\]/,$p'
      else
        echo "probe192.sh not found under $MODDIR/bin -- vendor DSP 状态不可用"
      fi
      return 0 ;;
    *)
      echo "speaker must be one of: loud | flat | hires | auto | status"
      echo "  loud   : 扬声器响度最大化 -- 硬件 IIR 高通（160Hz, Q=0.7071）砍掉发不出的"
      echo "           超低频，释放振膜行程；SPK_LOUD=2 时额外把数字音量压到 72"
      echo "           （衰减索引，数值小 = 更响）。不动 PA 增益：固件里已满载。"
      echo "  flat   : SPK_RATE=44100 SPK_BITS=24 -- 44.1k 曲库免 SRC（推荐）"
      echo "  hires  : SPK_RATE=192000 SPK_BITS=32 -- 高端设备 / HiRes 扬声器实验"
      echo "  auto   : SPK_RATE=auto SPK_BITS=16 SPK_LOUD=0 -- 100% 还原出厂"
      echo "           （IIR0 Enable Band1=Off、Band1=0 0 0 0 0、数字音量回 84）"
      echo "  status : 当前扬声器档位 + IIR 可用性 + 本机厂商 DSP 检测结果"
      return 1 ;;
  esac
  echo "applying..."
  do_apply
}

# ================================================================== smart PA
# Smart PA layer, driven ONLY through runtime tinymix reads and writes.  Zero
# files touched, zero mounts -- this is a completely separate layer from the
# policy mount stack above, so restore deliberately does NOT touch any PA
# control.
#
# PLUGGABLE BACKEND REGISTRY.  pa_detect() walks the registry in order and
# stops at the first hit; every backend owns three things: a probe rule, the
# write semantics it actually supports, and a status renderer.  A backend that
# has no verified write semantics is READ-ONLY: status shows the raw control
# values, gain/boost/vi refuse with an "unmapped" message, and the user is
# pointed at `hifi adapt` so a maintainer report can add the mapping.  NOTHING
# is ever written to a control the probe did not map -- safety first.
#
#   1. tfa     -- NXP TFA9874 (Redmi K20 Pro / raphael probe, see the
#                 maintainer report).  WRITABLE (gain + vi), the v2.0.2 path:
#   3174 TFA Profile            single "speaker" tier, switching is refused
#   22   EAR PA Gain            earpiece (no user command -- mis-touch guard)
#   23   EAR SPKR PA Gain       loudspeaker gain, the knob users actually want
#   24/25 SPKR Left/Right Boost Max State
#   316/317 AIF4_VI Mixer SPKR_VI_1/2   voltage/current feedback switches
#   3178 ALGO_STATUS            PROTECTED: ENABLE is the burn-the-speaker knob
#
#   2. wsa     -- Qualcomm WSA88xx (OnePlus 13 = WSA884x, kernel
#                 wsa884x_dlkm).  WRITABLE (gain + vi).  The RX digital
#                 volumes + AIF_VI feedback mixers are located BY NAME inside
#                 a full tinymix dump; the numbers and the WSA/WSA1/WSA2/WSA3
#                 name prefix are parsed, never hard-coded.  A mono layout
#                 (RX1 absent) still probes.  No boost / algo / mute controls
#                 exist, so the boost arm reports "firmware-managed".
#
#   3. awinic  -- Awinic "aw_pa" SmartPAs (Redmi/Xiaomi mid-range, some
#                 Honor).  READ-ONLY: the gain semantic is not verified.
#
#   4. cirrus  -- Cirrus Logic CS35L41/45 ("CS35L..", "Speaker Boost",
#                 "DSPx Preload"; Xiaomi/OnePlus flagships).  READ-ONLY.
#
#   5. mtk     -- MediaTek SmartPA controls ("SmartPA"/"SND_SMARTPA").
#                 READ-ONLY.
#
#   unknown    -- nothing matched: status says so and asks for `hifi adapt`,
#                 every write arm fails.  NEVER mention a single vendor name
#                 in the unknown path: the module is device-agnostic.
#
# Hard refusals below are deliberate: 3175 (mute), 3176 (stop), 3177
# (calibration), 3178 (algo), profile switching and /dev/tfa_reg writes are
# never emitted, not even by accident.
#
# MIXER USERLAND RESOLUTION (three stages, first match wins):
#   1. a real `tinymix` on PATH -- the v2.0.2 behaviour, byte-for-byte;
#   2. the module's own static fallback, $MODDIR/bin/tinymix_min (source:
#      payload/tinyalsa_min.c, pure kernel UAPI, musl-static ~33 KB).  Several
#      ROMs -- MediaTek devices in particular -- ship no tinymix at all, which
#      used to blind the whole PA layer; the fallback speaks the SAME legacy
#      3-tab-field dialect ("num\tname\tvalue [enum tail]", ">" marks the
#      current enum value), so every $TMIX call site below works unchanged;
#   3. neither exists (bin stripped, foreign arch): stay "tinymix" -- every
#      call fails quietly and the PA layer degrades to `unknown` exactly as
#      before.  Desktop test hosts run the REAL tinymix_min binary: /dev/snd
#      exists there, so tests must keep the module's bin/ clean of it.
TMIX="tinymix"
if ! command -v tinymix >/dev/null 2>&1; then
  for _tm in "$MODDIR/bin/tinymix_min" "$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)/tinymix_min"; do
    if [ -x "$_tm" ]; then TMIX="$_tm"; break; fi
  done
  unset _tm
fi
TM_PROFILE=3174
TM_EAR_GAIN=22
TM_SPK_GAIN=23
TM_BOOST_L=24
TM_BOOST_R=25
TM_VI_1=316
TM_VI_2=317
TM_ALGO=3178
PA_SNAPSHOT="$STATE/pa.txt"

# Backend selection is probed at RUNTIME, never hard-coded per device:
#   tfa     : NXP TFA9874 (Redmi K20 Pro).  The enum controls above answer
#             with words, so plain reads of ctl 23 + 22 are the probe.
#   wsa     : Qualcomm WSA88xx (OnePlus 13 = WSA884x).  No TFA controls exist;
#             the RX digital volumes and the VI feedback mixers are located by
#             NAME inside a full `tinymix` dump.  Control numbers differ
#             between SoCs and WSA big versions (WSA / WSA1 / WSA2 ... name
#             prefixes), so both the numbers and the prefix are parsed out of
#             the dump, never assumed.
#   unknown : neither probe answers (desktop harness, truly PA-less phones).
# The TFA control numbers above stay exactly where they were: the tfa path is
# byte-for-byte the v2.0.2 behaviour.
PA_BACKEND="unknown"
# WSA instance table.  A device can carry ONE chip (mono: RX0 only, or stereo:
# RX0+RX1 under the same prefix) or SEVERAL chips (dual-chip stereo: WSA_ and
# WSA2_ prefixes each with their own RX0/RX1).  The probe collects EVERY match
# and groups it by prefix, so `pa gain` writes the SAME tier value to every
# speaker volume control on the device -- an equal-value link that keeps the
# factory left/right balance on symmetric AND asymmetric dual-chip layouts
# (writing only the first chip would shift the stereo image and overload one
# side).  Per-instance fine tuning is deliberately NOT exposed: it would need
# verified per-chip data this module does not have.
#   WSA_N          number of instances (>=1)
#   WSA_I<p>_PFX   prefix of instance <p> (1-based), e.g. "WSA2_"
#   WSA_I<p>_RX0   control number of its RX0 volume (always present)
#   WSA_I<p>_RX1   control number of its RX1 volume, "-" when absent
#   WSA_I<p>_VI1   control number of its VI_1 switch, "-" when absent
#   WSA_I<p>_VI2   control number of its VI_2 switch, "-" when absent
WSA_N=0
WSA_PREFIX=""
# WSA loudspeaker digital volume: INT 0..124, LARGER = QUIETER.  Qualcomm
# maps gain_dB = (124 - volume) / 2, so the OnePlus 13 factory value 84 is
# ~+20 dB and every -2 steps +1 dB.  84 / tier 0 is the ladder's origin.
WSA_MAX_VOL=124
WSA_FACTORY_VOL=84
# Read-only backends: the control names the probe matched (status shows up to
# this many lines of the dump), plus the backend's display name.
PA_RO_HITS=""
PA_BACKEND_NAME=""

pa_warning() {
  printf '%s\n' \
    '!! 警告：提高 PA 增益会增大扬声器功率，可能造成振膜损伤/失真/硬件损坏，请从小档开始试听'
}

# tinymix read -> "On" / "G_6_DB" / "" when the control is absent
#
# tinymix comes in two dialects and the K20 Pro ships the OLD one, where
# `tinymix get <num>` is a parse error ("Invalid mixer control: get"):
#   old (system/bin, pre-Toybox):  `tinymix <num>`       read
#                                  `tinymix <num> <val>` write
#   new (toybox):                  `tinymix get <num>`   read
#                                  `tinymix set <num>`   write
# Both reads therefore go through the argument-less form, which every
# tinymix accepts.  The current value is the field carrying the `>` prefix
# ("EAR PA Gain: >G_6_DB G_4P5_DB ..." old / ">G_6_DB:..." new); when no `>`
# exists the value is the FIRST token of the third tab-field -- for every
# dialect the dump row is "<num>\t<name>\t<value> [enum tail...]".  Plain awk
# whitespace splitting cannot recover that shape (the enum tail has the same
# whitespace), so the field-3 split is done on the TAB character explicitly.
pa_get() {
  $TMIX "$1" 2>/dev/null | tr -d '\r' | awk -F'\t' '
    {
      # vendor 4-field single read: "<num>\tTYPE\tcount\t<name><pad><value>".
      # The last tab field still carries name + value (the dump-shaped row);
      # the value is its LAST whitespace token.  If the device appends the
      # value as its own tab field instead, $NF is the value alone -- both
      # shapes resolve to the same last-token extraction.
      if (NF >= 4 && $2 ~ /^(INT|BOOL|ENUM)$/) {
        v = $NF
        sub(/.*[ \t][ \t]*/, "", v)   # keep only the last token
        print v
        exit
      }
      # single-line, no-tab readback -- TWO real shapes share it:
      #   K20 legacy:  "EAR SPKR PA Gain: >G_6_DB G_4P5_DB ..."
      #   OP13 vendor: "WSA2_RX0 Digital Volume: 84 (dsrange 0->124)"
      # ORDER MATTERS: this colon branch MUST run BEFORE the ">" scan below.
      # The OP13 tail note "(dsrange 0->124)" contains an ARROW, so a naive
      # ">" scan over a single-line read hits the tail first and returns the
      # control NAME -- the third real-device bug.  The colon form is the one
      # shape both tinymix dialects agree on for single-control reads, so it
      # wins outright.
      if (NF == 1) {
        line = $0
        if (line ~ /:/) {
          sub(/^[^:]*:[ \t]*/, "", line)
          # the value token may itself carry a tail ("84 (dsrange 0->124)"):
          # keep only its first whitespace-delimited token
          sub(/[ \t].*$/, "", line)
          print line
          exit
        }
        print $1
        exit
      }
      # ">" marker scan -- TAB-SEPARATED rows only (K20 legacy enum values
      # like ">G_6_DB" sit in their own tab field).  Never reached for a
      # single-line read (the colon branch above already handled it), and the
      # G_-family guard below would reject an arrow-tail hit anyway.
      for (i = 1; i <= NF; i++) {
        f = $i
        if (f !~ />/) continue
        g = f
        sub(/>/, "", g)
        # only the G_-family gain enums (G_DEFAULT / G_0_DB / G_4P5_DB / ...)
        # are what this marker means -- "0->124"-style tails must not match
        if (g !~ /^G_[0-9P]/) continue
        sub(/[ :].*/, "", g)
        if (g != "") { print g; exit }
      }
      if (NF >= 3) {
        v = $3
        sub(/ .*/, "", v)          # strip the enum tail, keep the value token
        if (v ~ /^>/) { sub(/>/, "", v) }
        print v
        exit
      }
      exit
    }'
}

pa_conf_json_num() {
  case "$1" in
    [0-6]) printf '%s' "$1" ;;
    *)     printf 'null' ;;
  esac
}

# The full-dump reader the WSA probe parses.  A `tinymix` dump has one line per
# control in every dialect -- the old one as
#   "<num>\t<name>\t<current> <enum>..."  (current first, value with a ">")
# the toybox one as
#   "<num> <name> >Range 0..124: <current>" etc.
# We do NOT try to parse the CURRENT VALUE here -- only (number, name) pairs.
# Value reads go through pa_get(), the exact same path the TFA branch uses.
# The dump is read once and cached, because some dumps run to 380+ lines.
_pa_dump() {
  if [ -z "${_PA_DUMP_CACHE:-}" ]; then
    _PA_DUMP_CACHE="$($TMIX 2>/dev/null | tr -d '\r')"
  fi
  # 🔴 ANDROID PLATFORM TRAP -- do NOT "simplify" this back to printf.
  #
  # On Android, `printf` is NOT a shell builtin: it is the external binary
  # /system/bin/printf.  Emitting the cached dump through it therefore goes
  # through execve(), and the whole dump is ONE argv element of ~245 KB
  # (measured on the K20 Pro: 3450 lines / 250741 bytes).  That exceeds ARG_MAX
  # and the command dies with "/system/bin/printf: Argument list too long",
  # writing NOTHING to stdout.
  #
  # The failure is silent in the worst possible way: the assignment above
  # SUCCEEDS (${#_PA_DUMP_CACHE} is a healthy 250740), so only the OUTPUT is
  # lost.  Every dump consumer then sees an empty dump and concludes the
  # opposite of the truth:
  #   - pa_numid_of()    -> "" for every control => IIR probe reports
  #                         "no IIR0 Band1 on this device" and the high-pass
  #                         is skipped on hardware that actually has the block
  #   - pa_probe_wsa()   -> no WSA instance => wrong backend (or none)
  #   - pa_probe_tfa()   -> falls through the semantic check
  # A desktop bash `printf` IS a builtin and has no argv limit, which is
  # exactly why the offline suite stayed green while the phone was broken.
  #
  # `echo` is an mksh builtin, so the buffer never reaches execve.  Verified on
  # the device: echo emits 250741 bytes / 3450 lines with no stderr, and the
  # full probe chain then resolves IIR0 Enable Band1 -> 92, IIR0 Band1 -> 102,
  # IIR0 INP0 MUX -> 237, EAR SPKR PA Gain -> 23.
  #
  # The dump is machine-generated from control names/values: it contains no
  # backslash escapes and no line starts with '-', so mksh echo's option/escape
  # handling cannot corrupt it.  If that ever stops being true, switch to a
  # heredoc (its body travels on stdin, not argv, so ARG_MAX does not apply).
  echo "$_PA_DUMP_CACHE"
}

# Normalise ANY tinymix dump dialect into the legacy 3-field shape
#   "<num>\t<NAME> <VALUE> [enum tail...]"
# so every dump consumer matches on ONE shape.  Two dialects exist in the wild:
#
#   legacy (K20 Pro, old system/bin tinymix) -- 3 tab fields:
#     233\tWSA2_RX0 Digital Volume\t84 0 1 2 ... 124
#     -> $1 = num, $2 = name, $3 = value
#
#   vendor 4-field (OnePlus 13 / sun-mtp-snd-card, 2023+ QTI):
#     233\tINT\t1\tWSA2_RX0 Digital Volume                  84
#     -> $1 = num, $2 = TYPE (INT/BOOL/ENUM/BYTE), $3 = count, $4 = "name<pad>value"
#     BYTE rows may fold SEVERAL controls onto one physical line -- those are
#     dropped; every control this module needs is INT/BOOL/ENUM.
#
# Inside $4 the name is left-justified against the vendor's column padding, so
# the value is the LAST whitespace token and the name is everything before it.
# A single-token value ("84", "Off") survives both splits unchanged.
_pa_dump_norm() {
  _pa_dump | awk -F'\t' -v OFS='\t' '
    $1 ~ /^[0-9]+$/ && NF >= 4 && $2 ~ /^(INT|BOOL|ENUM)$/ {
      v = $4
      if (match(v, /[ \t]+[^ \t]+$/)) {
        val = substr(v, RSTART)
        sub(/^[ \t]+/, "", val)
        name = substr(v, 1, RSTART - 1)
        sub(/[ \t]+$/, "", name)
      } else {
        name = v
        val = ""
      }
      print $1, name, val
      next
    }
    $1 ~ /^[0-9]+$/ && NF == 3 { print; next }   # legacy rows pass through
    # banner / header / folded BYTE lines are dropped
  '
}

# --- WSA probe: find the three controls BY NAME inside the tinymix dump. ----
# Accepted name shapes (WSA881x/882x/884x big versions vary the prefix):
#   <N> WSA[0-9]*RX0 Digital Volume        <- loudspeaker left / ch0 volume
#   <N> WSA[0-9]*RX1 Digital Volume        <- loudspeaker right / ch1 volume
#   <N> WSA[0-9]*AIF_VI Mixer WSA[0-9]*_VI_1   <- VI feedback switch ch1
#   <N> WSA[0-9]*AIF_VI Mixer WSA[0-9]*_VI_2   <- VI feedback switch ch2
# The prefix (WSA / WSA1 / WSA2 / ...) is captured per instance so the status
# overview can name every chip the device carries.
#
# MULTI-CHIP: every prefix forms its own speaker instance.  A dump like
#   100 WSA_RX0 Digital Volume ... / 101 WSA_RX1 ...
#   233 WSA2_RX0 Digital Volume ... / 234 WSA2_RX1 ...
# yields TWO instances, and `pa gain` writes BOTH -- writing only the first
# would shift the stereo image and overload one side.  A mono layout (RX0
# alone, no RX1) still probes: RX0 is the one MANDATORY control.
pa_probe_wsa() {
  WSA_N=0
  WSA_PREFIX=""
  ensure_dirs
  # group every RX volume row by its prefix; emit one line per instance:
  #   "<pfx>|<rx0>|<rx1|->|<vi1|->|<vi2|->"
  # The dump order is NOT guaranteed to interleave nicely (the real OP13 dump
  # lists the VI mixers at 203/204, BEFORE the RX volumes at 233/234), so VI
  # rows are collected per prefix into arrays keyed by prefix -- never tied to
  # the "current" prefix of the line stream.
  _pa_dump_norm | awk -F'\t' '
    function have(p) { return (p in seen) }
    $2 ~ /WSA.*RX0 Digital Volume$/ {
      p = $2; sub(/RX0.*/, "", p)
      rx0[p] = $1; seen[p] = 1
    }
    $2 ~ /WSA.*RX1 Digital Volume$/ {
      p = $2; sub(/RX1.*/, "", p)
      rx1[p] = $1; seen[p] = 1
    }
    $2 ~ /AIF_VI Mixer.*_VI_1$/ {
      # switch name: "<PFX>AIF_VI Mixer <PFX>_SPKR_VI_1" -> the instance prefix
      p = $2; sub(/AIF_VI.*/, "", p)
      vi1[p] = $1; seen[p] = 1
    }
    $2 ~ /AIF_VI Mixer.*_VI_2$/ {
      p = $2; sub(/AIF_VI.*/, "", p)
      vi2[p] = $1; seen[p] = 1
    }
    END {
      for (p in seen) {
        if (!(p in rx0)) continue          # RX0 is the MANDATORY control
        printf "%s|%s|%s|%s|%s\n", p, rx0[p],
               ((p in rx1) ? rx1[p] : "-"),
               ((p in vi1) ? vi1[p] : "-"),
               ((p in vi2) ? vi2[p] : "-")
      }
    }
  ' | sort > "$PA_TMP"
  [ -s "$PA_TMP" ] || return 1
  WSA_N=0
  while IFS='|' read -r _pfx _rx0 _rx1 _vi1 _vi2; do
    [ -n "$_pfx" ] || continue
    WSA_N=$((WSA_N + 1))
    eval "WSA_I${WSA_N}_PFX=\"$_pfx\" WSA_I${WSA_N}_RX0=\"$_rx0\" \
          WSA_I${WSA_N}_RX1=\"$_rx1\" WSA_I${WSA_N}_VI1=\"$_vi1\" WSA_I${WSA_N}_VI2=\"$_vi2\""
  done < "$PA_TMP"
  rm -f "$PA_TMP"
  [ "$WSA_N" -ge 1 ] || return 1
  WSA_PREFIX="$WSA_I1_PFX"
  return 0
}

# --- backend selection.  Called once per PA command; idempotent. ------------
# --- read-only backend probes -----------------------------------------------
# Every probe looks at the (number, name) pairs of the tinymix dump only --
# no value is read, nothing is written.  A hit stores the matched control
# names in PA_RO_HITS (newline-separated "<num> <name>", capped later) and
# returns 0.  These backends have NO verified gain semantics, so the write
# arms refuse by design: status shows the raw values and asks the user to run
# `hifi adapt` so a maintainer report can map the controls safely.
pa_ro_collect() {  # pa_ro_collect <grep -iE pattern> -> fills PA_RO_HITS
  _pa_ro_hits="$(_pa_dump_norm | grep -iE "$1" | head -n 6)"
  [ -n "$_pa_ro_hits" ] || return 1
  PA_RO_HITS="$_pa_ro_hits"
  return 0
}

pa_probe_awinic() {
  # Awinic smart PAs expose "aw_pa"-style control names (case-insensitive);
  # e.g. "AW862XX aw_pa Boost", "awinic,smartpa ...".
  pa_ro_collect 'aw_pa|awinic' \
    && { PA_BACKEND_NAME="Awinic (aw_pa)"; return 0; }
  return 1
}

pa_probe_cirrus() {
  # Cirrus Logic CS35L41/45: the driver registers "CS35L.." prefixed
  # controls; some builds carry "Speaker Boost" + "DSPx Preload" instead.
  if pa_ro_collect 'CS35L'; then
    PA_BACKEND_NAME="Cirrus Logic (CS35L)"
    return 0
  fi
  # weaker signature: BOTH a boost and a preload control must exist, or it is
  # not a CS35L-class PA (a lone "Speaker Boost" would be too greedy)
  if _pa_dump_norm | grep -qi 'Speaker Boost' && _pa_dump_norm | grep -qiE 'DSP[0-9].*Preload|Preload.*DSP[0-9]'; then
    PA_RO_HITS="$(_pa_dump_norm | grep -iE 'Speaker Boost|DSP[0-9].*Preload|Preload.*DSP[0-9]' | head -n 6)"
    PA_BACKEND_NAME="Cirrus Logic (Speaker Boost)"
    return 0
  fi
  return 1
}

pa_probe_mtk() {
  # MediaTek SmartPA plumbing: "SmartPA" / "SND_SMARTPA" control names.
  pa_ro_collect 'SmartPA|SND_SMARTPA' \
    && { PA_BACKEND_NAME="MediaTek (SmartPA)"; return 0; }
  return 1
}

# --- TFA probe: name + value semantics of controls 22/23 ---------------------
# The K20 Pro dump rows look like
#   22\tEAR PA Gain\t>G_6_DB G_4P5_DB
#   23\tEAR SPKR PA Gain\t>G_DEFAULT G_1_DB ...
# so the probe requires: the NAME field contains "PA Gain" (case-insensitive)
# for BOTH controls, and the VALUE of 22 or 23 is a G_-family gain enum.  A
# device whose 22/23 are anything else (e.g. TX capture mixers on OP13) fails
# and the registry walk continues to the WSA probe.
pa_probe_tfa() {
  ensure_dirs
  _pa_dump_norm | awk -F'\t' -v e="$TM_EAR_GAIN" -v s="$TM_SPK_GAIN" '
    $1 == e { ear_name = $2; ear_val = $3 }
    $1 == s { spk_name = $2; spk_val = $3 }
    END {
      # a) names must be PA Gain controls
      if (ear_name !~ /[Pp][Aa] [Gg]ain/) exit 1
      if (spk_name !~ /[Pp][Aa] [Gg]ain/) exit 1
      # b) at least one value is a G_-family gain enum
      if (ear_val !~ /(^|>)G_/ && spk_val !~ /(^|>)G_/) exit 1
      exit 0
    }'
  return $?
}

# --- backend selection: the registry walk ------------------------------------
# Order matters: the exact, verified layouts first, the generic signatures
# last.  Called once per PA command; idempotent (the result is cached).
pa_detect() {
  [ "$PA_BACKEND" != "unknown" ] && return 0
  # 1) the TFA probe: SEMANTIC check, not a bare read.  A bare "does ctl 23
  #    answer" is NOT enough -- old-dialect tinymixes echo a control row for
  #    ANY number, so on a OnePlus 13 controls 22/23 are unrelated WCD capture
  #    mixers ("TX_AIF3_CAP Mixer DEC6: Off") and the read comes back
  #    non-empty, which used to mis-select tfa and never reach the WSA probe.
  #    Both conditions verified against the (cached) full dump instead:
  #      a) the control NAMES of 22 and 23 contain "PA Gain", and
  #      b) the current VALUE of 22 or 23 is a G_-family gain enum.
  #    Still read-only, zero side effects, and a K20 Pro dump passes both.
  if pa_probe_tfa; then
    PA_BACKEND="tfa"
    PA_BACKEND_NAME="NXP TFA9874"
    return 0
  fi
  # 2) the WSA probe: name-matched RX volumes + VI mixers from the full dump.
  if pa_probe_wsa; then
    PA_BACKEND="wsa"
    _wsa_clean="${WSA_PREFIX%_}"
    if [ "$WSA_N" -ge 2 ]; then
      PA_BACKEND_NAME="Qualcomm ${_wsa_clean}88xx (${WSA_N} chips)"
    else
      PA_BACKEND_NAME="Qualcomm ${_wsa_clean}88xx (WSA${_wsa_clean#WSA})"
    fi
    return 0
  fi
  # 3..5) the read-only registry entries
  if pa_probe_awinic; then
    PA_BACKEND="awinic"
    return 0
  fi
  if pa_probe_cirrus; then
    PA_BACKEND="cirrus"
    return 0
  fi
  if pa_probe_mtk; then
    PA_BACKEND="mtk"
    return 0
  fi
  return 1
}

# compare a value against the factory default shown in the status overview
pa_is_factory_gain()   { case "$1" in G_DEFAULT|G_6_DB) return 0 ;; esac; return 1; }
pa_is_factory_boost()  { case "$1" in MAX_STATE_2) return 0 ;; esac; return 1; }
pa_is_factory_vi()     { case "$1" in Off|"") return 0 ;; esac; return 1; }

# WSABackend detection needs a scratch file next to the snapshot it serves;
# put it in the state dir so a read-only root still degrades gracefully.
PA_TMP="$STATE/pa.tmp.$$"

pa_status() {
  load_conf
  if ! pa_detect; then
    # unified unknown verdict -- NO vendor name in it: this module is
    # device-agnostic and the report goes to the maintainer via `hifi adapt`
    printf 'Smart PA: 未识别（回传 hifi adapt 协助适配）\n'
    return 1
  fi
  case "$PA_BACKEND" in
    wsa)     pa_status_wsa ;;
    tfa)     pa_status_tfa ;;
    *)       pa_status_ro "$PA_BACKEND" "$PA_BACKEND_NAME" ;;
  esac
  return 0
}

# read-only backend overview: the backend name, then up to 6 matched controls
# with their live values.  Pure display -- the write arms refuse by design.
pa_status_ro() {
  backend="$1"; name="$2"
  printf 'Smart PA: %s（%s）\n' "$backend" "$name"
  n=0
  printf '%s\n' "$PA_RO_HITS" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    num="$(printf '%s' "$line" | awk '{print $1}')"
    ctlname="$(printf '%s' "$line" | cut -f2)"
    val="$(pa_get "$num")"
    printf '  %-44s : %s\n' "${ctlname:-<unnamed>} ($num)" "${val:-n/a}"
  done
  printf '  只读（档位未映射，回传 hifi adapt 协助适配）\n'
  return 0
}

# the original NXP TFA overview
pa_status_tfa() {
  printf 'Smart PA: tfa（%s via tinymix）\n' "$PA_BACKEND_NAME"
  prof="$(pa_get $TM_PROFILE)"
  ear="$(pa_get $TM_EAR_GAIN)"
  spk="$(pa_get $TM_SPK_GAIN)"
  bl="$(pa_get $TM_BOOST_L)"
  br="$(pa_get $TM_BOOST_R)"
  v1="$(pa_get $TM_VI_1)"
  algo="$(pa_get $TM_ALGO)"
  miss=0
  for v in "$prof" "$ear" "$spk" "$bl" "$br" "$v1" "$algo"; do
    [ -n "$v" ] || miss=1
  done
  cat <<EOF
  PA profile        : ${prof:-n/a} (唯一档，不支持换挡)
  earpiece gain     : ${ear:-n/a}$([ -n "$ear" ] && pa_is_factory_gain "$ear" && printf ' (出厂值)')
  speaker gain      : ${spk:-n/a}$([ -n "$spk" ] && [ "$spk" = G_DEFAULT ] && printf ' (出厂值)')   ← 控件 23
  boost max state   : L/R = ${bl:-n/a} / ${br:-n/a}$([ -n "$bl" ] && [ -n "$br" ] && pa_is_factory_boost "$bl" && pa_is_factory_boost "$br" && printf ' (出厂值)')
  vi feedback       : ${v1:-n/a}$([ -n "$v1" ] && pa_is_factory_vi "$v1" && printf ' (出厂值)')
  protection algo   : enabled (DSP 内置，不可关)
EOF
  if [ "$miss" = 1 ]; then
    printf '本机无 TFA smart PA 或控件号不同，功能不可用\n'
    return 1
  fi
  return 0
}

# the Qualcomm WSA overview (OnePlus 13 = WSA884x, prefix WSA2).  The volume
# is an INT, larger = quieter, so the readable number is the ESTIMATED dB gain
# (124 - v) / 2 -- flagged as an estimate because the mapping is the Qualcomm
# convention, not a spec constant.
pa_wsa_db_of() {
  v="$1"
  case "$v" in
    ''|*[!0-9]*) printf '?' ; return ;;
  esac
  [ "$v" -le "$WSA_MAX_VOL" ] || v="$WSA_MAX_VOL"
  printf '%s' "$(( (WSA_MAX_VOL - v) / 2 ))"
}

pa_status_wsa() {
  printf 'Smart PA: wsa（%s via tinymix）\n' "$PA_BACKEND_NAME"
  if [ "$WSA_N" -ge 2 ]; then
    printf '  多芯片立体声（%s 实例，等值联动）\n' "$WSA_N"
  fi
  p=1
  while [ "$p" -le "$WSA_N" ]; do
    eval "pfx=\"\$WSA_I${p}_PFX\" rx0ctl=\"\$WSA_I${p}_RX0\" rx1ctl=\"\$WSA_I${p}_RX1\" \
          vi1ctl=\"\$WSA_I${p}_VI1\" vi2ctl=\"\$WSA_I${p}_VI2\""
    rx0="$(pa_get "$rx0ctl")"
    rx1=""; [ "$rx1ctl" != "-" ] && [ -n "$rx1ctl" ] && rx1="$(pa_get "$rx1ctl")"
    v1="";  [ "$vi1ctl" != "-" ] && [ -n "$vi1ctl" ] && v1="$(pa_get "$vi1ctl")"
    db0="$(pa_wsa_db_of "$rx0")"
    db1="$(pa_wsa_db_of "$rx1")"
    fac0=""; [ "$rx0" = "$WSA_FACTORY_VOL" ] && fac0=" (出厂值)"
    fac1=""; [ -n "$rx1" ] && [ "$rx1" = "$WSA_FACTORY_VOL" ] && fac1=" (出厂值)"
    if [ "$WSA_N" -ge 2 ]; then
      tag="speaker [$pfx]"
    else
      tag="speaker"
    fi
    line1="$(printf '  %s RX0  : volume %s (≈ +%s dB, 估算)%s ← 控件 %s' "$tag" "$rx0" "$db0" "$fac0" "$rx0ctl")"
    printf '%s\n' "$line1"
    if [ -n "$rx1" ]; then
      if [ "$WSA_N" -ge 2 ]; then
        printf '  %s RX1  : volume %s (≈ +%s dB, 估算)%s ← 控件 %s\n' "$tag" "$rx1" "$db1" "$fac1" "$rx1ctl"
      else
        printf '  %s RX1  : volume %s (≈ +%s dB, 估算)%s ← 控件 %s\n' "$tag" "$rx1" "$db1" "$fac1" "$rx1ctl"
      fi
    elif [ "$WSA_N" -eq 1 ]; then
      printf '  %s RX1  : 本机无此通道（单声道布局）\n' "$tag"
    fi
    if [ "$vi1ctl" != "-" ] && [ -n "$vi1ctl" ]; then
      vi_state="Off"
      case "$v1" in 1|On|ON|on) vi_state="On" ;; esac
      facv=""; case "$v1" in Off|0|off|OFF) facv=" (出厂值)" ;; esac
      printf '  %s vi        : %s%s ← 控件 %s%s\n' "$tag" "$vi_state" "$facv" "$vi1ctl" \
        "$([ "$vi2ctl" != "-" ] && [ -n "$vi2ctl" ] && printf '/%s' "$vi2ctl")"
    fi
    p=$((p + 1))
  done
  if [ "$WSA_N" -eq 1 ]; then
    printf '%s\n' '  boost             : WSA 机型由固件管理，无手动 boost'
    printf '%s\n' '  protection algo   : enabled (DSP 内置，不可关)'
  else
    printf '%s\n' '  boost             : WSA 机型由固件管理，无手动 boost'
    printf '%s\n' '  protection algo   : enabled (DSP 内置，不可关)'
  fi
  # every instance must answer on RX0 -- a dead chip is a real failure
  p=1
  while [ "$p" -le "$WSA_N" ]; do
    eval "rx0ctl=\"\$WSA_I${p}_RX0\""
    rx0="$(pa_get "$rx0ctl")"
    case "$rx0" in
      '') printf 'WSA 实例 %s（控件 %s）无回读，功能不可用\n' "$p" "$rx0ctl"
          return 1 ;;
    esac
    p=$((p + 1))
  done
  return 0
}

# write one control and read it back; anything other than an exact match fails.
# Uses the argument-less two-positional form `tinymix <num> <value>`, which is
# the write syntax of BOTH dialects (the new toybox `tinymix set <num> <val>`
# is never used, so a single code path drives every build).
#
# BOOL read-back normalisation: the old (K20 Pro) tinymix echoes boolean
# controls as words -- `tinymix 316 1` really does apply, but the read-back
# says "On".  1 = On / 0 = Off (case-insensitive) is therefore accepted as a
# match in BOTH directions; enum values (G_3_DB, MAX_STATE_2, ...) stay strict.
pa_bool_like() {
  case "$1" in
    1|On|ON|on)  return 0 ;;
    0|Off|OFF|off) return 1 ;;
    *) return 2 ;;
  esac
}
# pa_bool_like returns 0 = on-like, 1 = off-like, 2 = not a boolean at all:
# the class numbers must match (1 and On are the same class, etc.)
pa_values_match() {
  [ "$2" = "$1" ] && return 0
  pa_bool_like "$1"; a=$?
  [ "$a" != 2 ] || return 1
  pa_bool_like "$2"; b=$?
  [ "$a" = "$b" ] || return 1
  return 0
}
pa_set() {
  ctl="$1"; val="$2"
  if ! $TMIX "$ctl" "$val" >/dev/null 2>&1; then
    printf '!! 控件 %s 写入命令失败（tinymix 返回非零）\n' "$ctl" >&2
    return 1
  fi
  back="$(pa_get "$ctl")"
  pa_values_match "$val" "$back" \
    || { printf '!! 控件 %s 写入后回读不符: %s\n' "$ctl" "${back:-（空）}" >&2; return 1; }
  return 0
}

# WSA volume write: the same two-positional form as pa_set, but the read-back
# is an INT compared NUMERICALLY (a naive string compare also works on real
# tinymix, yet a build that echoes the value with extra formatting must not
# fail the verification -- so the comparison is numeric when both parse).
pa_set_int() {
  ctl="$1"; val="$2"
  case "$val" in ''|*[!0-9]*)
    printf '!! 控件 %s 需要 0..%s 的整数，收到 %r\n' "$ctl" "$WSA_MAX_VOL" "$val" >&2
    return 1 ;;
  esac
  if ! $TMIX "$ctl" "$val" >/dev/null 2>&1; then
    printf '!! 控件 %s 写入命令失败（tinymix 返回非零）\n' "$ctl" >&2
    return 1
  fi
  back="$(pa_get "$ctl")"
  case "$back" in
    "$val") return 0 ;;
    ''|*[!0-9]*)
      printf '!! 控件 %s 写入后回读非整数: %s\n' "$ctl" "${back:-（空）}" >&2
      return 1 ;;
    *)  [ "$back" -eq "$val" ] && return 0 ;;
  esac
  printf '!! 控件 %s 写入后回读不符: %s\n' "$ctl" "$back" >&2
  return 1
}

# WSA gain tier -> volume: tier N adds +N dB over the factory origin, i.e.
# volume = 84 - 2*N.  Tier 6 -> 72 (~+26 dB).  Clamped to 0..WSA_MAX_VOL so a
# corrupt config can never push the value out of the control's range.
pa_wsa_vol_of_tier() {
  n="$1"
  v=$(( WSA_FACTORY_VOL - 2 * n ))
  [ "$v" -lt 0 ] && v=0
  [ "$v" -gt "$WSA_MAX_VOL" ] && v="$WSA_MAX_VOL"
  printf '%s' "$v"
}

# WSA volume -> nearest tier (for the apply hook's consistency check only);
# round half up so an odd factory volume still maps onto the ladder.
pa_wsa_tier_of_vol() {
  v="$1"
  [ "$v" -gt "$WSA_FACTORY_VOL" ] && v="$WSA_FACTORY_VOL"
  printf '%s' "$(( (WSA_FACTORY_VOL - v + 1) / 2 ))"
}

# the write-a-WSA-tier primitive shared by `pa gain` and `pa_apply_conf`:
# EVERY instance, EVERY channel, the SAME tier value -- the equal-value link
# that keeps multi-chip stereo balanced.  Each control is read back; ANY
# mismatch fails the whole write (already-written controls stay as-is, the
# same no-rollback atomicity as the rest of the module).
pa_wsa_set_tier() {
  n="$1"
  vol="$(pa_wsa_vol_of_tier "$n")"
  wsa_fail=0
  p=1
  while [ "$p" -le "$WSA_N" ]; do
    eval "rx0ctl=\"\$WSA_I${p}_RX0\" rx1ctl=\"\$WSA_I${p}_RX1\" pfx=\"\$WSA_I${p}_PFX\""
    if ! pa_set_int "$rx0ctl" "$vol"; then
      printf '!! WSA gain 写入失败（实例 %s RX0 控件 %s 回读不一致或写入被拒）\n' "$p" "$rx0ctl" >&2
      wsa_fail=1
    fi
    if [ "$rx1ctl" != "-" ] && [ -n "$rx1ctl" ] && ! pa_set_int "$rx1ctl" "$vol"; then
      printf '!! WSA gain 写入失败（实例 %s RX1 控件 %s 回读不一致或写入被拒）\n' "$p" "$rx1ctl" >&2
      wsa_fail=1
    fi
    p=$((p + 1))
  done
  [ "$wsa_fail" = 0 ] || return 1
  if [ "$WSA_N" -ge 2 ]; then
    printf 'WSA loudspeaker gain: %s 实例全部 volume = %s (tier %s, ≈ +%s dB, 估算，等值联动)\n' \
      "$WSA_N" "$vol" "$n" "$(pa_wsa_db_of "$vol")"
  elif [ "$WSA_I1_RX1" != "-" ] && [ -n "$WSA_I1_RX1" ]; then
    printf 'WSA loudspeaker gain: RX0/RX1 volume = %s (tier %s, ≈ +%s dB, 估算)\n' \
      "$vol" "$n" "$(pa_wsa_db_of "$vol")"
  else
    printf 'WSA loudspeaker gain: RX0 volume = %s (tier %s, ≈ +%s dB, 估算)\n' \
      "$vol" "$n" "$(pa_wsa_db_of "$vol")"
  fi
  return 0
}

# WSA VI feedback switch: BOOL, digit form (the old tinymix refuses enum words
# on bool controls, exactly the reason the TFA branch writes digits too).
# Walks every instance's VI switches.
pa_wsa_set_vi() {
  v="$1"
  case "$v" in 0|1) ;; *) return 1 ;; esac
  wsa_fail=0
  wsa_vi_any=0
  p=1
  while [ "$p" -le "$WSA_N" ]; do
    eval "vi1ctl=\"\$WSA_I${p}_VI1\" vi2ctl=\"\$WSA_I${p}_VI2\""
    if [ "$vi1ctl" != "-" ] && [ -n "$vi1ctl" ]; then
      wsa_vi_any=1
      if ! pa_set "$vi1ctl" "$v"; then
        printf '!! WSA VI 写入失败（实例 %s 控件 %s 回读不一致或写入被拒）\n' "$p" "$vi1ctl" >&2
        wsa_fail=1
      fi
    fi
    if [ "$vi2ctl" != "-" ] && [ -n "$vi2ctl" ] && ! pa_set "$vi2ctl" "$v"; then
      printf '!! WSA VI 写入失败（实例 %s 控件 %s 回读不一致或写入被拒）\n' "$p" "$vi2ctl" >&2
      wsa_fail=1
    fi
    p=$((p + 1))
  done
  [ "$wsa_vi_any" = 1 ] || { printf '!! 本机 WSA 无 VI 反馈控件\n' >&2; return 1; }
  [ "$wsa_fail" = 0 ] || return 1
  printf 'WSA VI 反馈: 已设为 %s (On/Off)\n' "$v"
  return 0
}

# read-only backends: the safety-first refusal every write arm funnels into.
pa_readonly_refusal() {
  printf '!! 该 PA 后端（%s）暂未开放调节：档位未映射，模块绝不盲写未知控件。\n' "$PA_BACKEND" >&2
  printf '   请执行 hifi adapt 并把 [8] 段整段回传给维护者，协助补齐映射。\n' >&2
  return 1
}

# the apply-time hook: config-driven, warnings printed, read-back verified
pa_apply_conf() {
  load_conf
  pa_detect || { PA_BACKEND="unknown"; }
  case "$PA_BACKEND" in
    wsa)     pa_apply_conf_wsa ;;
    tfa)     pa_apply_conf_tfa ;;
    *)       # read-only or unknown: PA_GAIN / PA_BOOST must NOT be consumed
             case "$PA_GAIN$PA_BOOST" in
               ''|reset) : ;;
               *) printf '!! 本机 PA 后端（%s）暂不支持写入，PA_GAIN/PA_BOOST 配置被跳过（未落盘修改，控件未动）\n' "$PA_BACKEND" >&2 ;;
             esac
             ;;
  esac
  return 0
}

pa_apply_conf_tfa() {
  load_conf
  applied_any=0
  case "$PA_GAIN" in
    [0-6])
      pa_warning
      if pa_set $TM_SPK_GAIN "G_${PA_GAIN}_DB"; then
        printf 'earpiece-speaker PA gain = G_%s_DB\n' "$PA_GAIN"
        applied_any=1
      else
        printf '!! PA_GAIN 写入失败（本机可能无 TFA smart PA），扬声器增益保持原值\n' >&2
      fi
      ;;
  esac
  case "$PA_BOOST" in
    1|2)
      [ "$applied_any" = 1 ] || pa_warning
      if pa_set $TM_BOOST_L "MAX_STATE_${PA_BOOST}" && pa_set $TM_BOOST_R "MAX_STATE_${PA_BOOST}"; then
        printf 'speaker boost max state = MAX_STATE_%s (L/R)\n' "$PA_BOOST"
      else
        printf '!! PA_BOOST 写入失败（本机可能无 TFA smart PA），boost 保持原值\n' >&2
      fi
      ;;
  esac
  return 0
}

pa_apply_conf_wsa() {
  load_conf
  case "$PA_GAIN" in
    [0-6])
      pa_warning
      if pa_wsa_set_tier "$PA_GAIN"; then
        printf 'speaker PA gain = tier %s\n' "$PA_GAIN"
      else
        printf '!! PA_GAIN 写入失败（本机可能无 WSA smart PA），扬声器增益保持原值\n' >&2
      fi
      ;;
  esac
  case "$PA_BOOST" in
    1|2)
      printf '!! 本机 PA（WSA884x）无手动 boost 控件，PA_BOOST 由固件管理，跳过\n' >&2
      ;;
  esac
  return 0
}

pa_snapshot() {
  pa_status > "$PA_SNAPSHOT" 2>&1 || true
  printf '已写入 %s\n' "$PA_SNAPSHOT"
}

pa_usage() {
  echo "pa must be one of: status | scan | gain | boost | vi"
  echo "  status        当前 smart PA 全量状态（纯读，自动识别 TFA / WSA / 其它后端）"
  echo "  scan          状态快照写入 $PA_SNAPSHOT（供 WebUI 轮询）"
  echo "  gain <0..6>   外放 PA 增益档（TFA: 控件 23 的 dB 档 / WSA: RX volume 84-2N；0 = 出厂；"
  echo "                未映射后端只读，不提供写入）"
  echo "  boost <1|2>   boost 上限档（仅 TFA；WSA 由固件管理；未映射后端只读）"
  echo "  vi <on|off>   VI 电压电流回读开关（TFA: 316+317 / WSA: AIF_VI Mixer）"
  return 1
}

# `pa gain <0..6>`: dispatch on the detected backend, persist the tier once.
pa_do_gain() {
  n="$1"
  if ! pa_detect; then
    printf 'Smart PA: 未识别（回传 hifi adapt 协助适配）\n' >&2
    return 1
  fi
  case "$PA_BACKEND" in
    tfa|wsa) : ;;
    *)       pa_readonly_refusal; return 1 ;;
  esac
  if [ "$n" = 0 ]; then
    printf '%s\n' '恢复外放 PA 增益到出厂值'
  else
    pa_warning
  fi
  case "$PA_BACKEND" in
    wsa) ok_write=pa_wsa_set_tier ;;
    *)   ok_write=pa_tfa_set_tier ;;
  esac
  if "$ok_write" "$n"; then
    printf '提示：听筒增益不受此命令影响；增益越大失真越大，出现破音立即执行: hifi pa gain reset\n'
    # persist the tier so `hifi json` / WebUI reflect the new state (the
    # WebUI is the primary entry point and re-reads the conf on refresh)
    PA_GAIN="$n"
    save_conf
    return 0
  fi
  printf '!! 写入失败：本机 smart PA 控件写入被拒，功能不可用\n' >&2
  return 1
}

# the TFA half of the ladder, factored out of the old do_pa gain arm
pa_tfa_set_tier() {
  n="$1"
  case "$n" in
    0) val=G_DEFAULT ;;
    *) val="G_${n}_DB" ;;
  esac
  if ! pa_set $TM_SPK_GAIN "$val"; then
    printf '!! 写入失败：本机可能无 TFA smart PA 或控件号不同，功能不可用\n' >&2
    return 1
  fi
  printf 'earpiece-speaker PA gain = %s\n' "$val"
  return 0
}

# the TFA half of the VI switch, factored out of the old do_pa vi arm
pa_tfa_set_vi() {
  v="$1"
  if pa_set $TM_VI_1 "$v" && pa_set $TM_VI_2 "$v"; then
    if [ "$v" = 1 ]; then
      printf 'VI 回读已开启，数据口 /dev/tfa_rw（需 root 自行解析 DSP 帧）\n'
    else
      printf 'VI 回读已关闭\n'
    fi
    return 0
  fi
  printf '!! 写入失败：本机可能无 TFA smart PA 或控件号不同，功能不可用\n' >&2
  return 1
}

do_pa() {
  sub="${1:-status}"
  case "$sub" in
    status)
      pa_status ;;
    scan)
      ensure_dirs
      pa_snapshot ;;
    gain)
      shift
      case "${1:-}" in
        reset) n=0 ;;
        [0-6]) n="$1" ;;
        *)     pa_usage; return 1 ;;
      esac
      pa_do_gain "$n" ;;
    boost)
      shift
      case "${1:-}" in
        reset) m=2 ;;
        1|2)   m="$1" ;;
        *)     pa_usage; return 1 ;;
      esac
      if ! pa_detect; then
        printf 'Smart PA: 未识别（回传 hifi adapt 协助适配）\n' >&2
        return 1
      fi
      if [ "$PA_BACKEND" = "wsa" ]; then
        printf '本机 PA（WSA884x）无手动 boost 控件，由固件管理\n' >&2
        return 1
      fi
      if [ "$PA_BACKEND" != "tfa" ]; then
        pa_readonly_refusal
        return 1
      fi
      if [ "$m" = 2 ]; then
        printf '%s\n' '恢复 boost 上限到出厂满档 MAX_STATE_2'
      else
        printf '%s\n' '!! 警告：提高 PA 增益会增大扬声器功率，可能造成振膜损伤/失真/硬件损坏，请从小档开始试听'
        printf '%s\n' 'boost 1 = 降压省电档，削峰更早（省电不保真）；2 = 出厂满档'
      fi
      if pa_set $TM_BOOST_L "MAX_STATE_${m}" && pa_set $TM_BOOST_R "MAX_STATE_${m}"; then
        printf 'speaker boost max state = MAX_STATE_%s (L/R)\n' "$m"
        # persist like gain: json / WebUI must reflect the new tier
        PA_BOOST="$m"
        save_conf
      else
        printf '!! 写入失败：本机可能无 TFA smart PA 或控件号不同，功能不可用\n' >&2
        return 1
      fi ;;
    vi)
      shift
      case "${1:-}" in
        on)  v=1 ;;
        off) v=0 ;;
        *)   pa_usage; return 1 ;;
      esac
      if ! pa_detect; then
        printf 'Smart PA: 未识别（回传 hifi adapt 协助适配）\n' >&2
        return 1
      fi
      if [ "$PA_BACKEND" != "tfa" ] && [ "$PA_BACKEND" != "wsa" ]; then
        pa_readonly_refusal
        return 1
      fi
      if [ "$v" = 1 ] && [ "$PA_BACKEND" = "wsa" ]; then
        printf '%s\n' '开启 WSA VI 电压电流回读（AIF_VI Mixer），供高级用户读取'
      elif [ "$v" = 1 ]; then
        printf '%s\n' '开启 VI 电压电流回读（控件 316+317），供高级用户配合第三方工具读取'
      fi
      # write the DIGIT: the old tinymix refuses enum words on BOOL controls
      # ("Error: only enum types can be set with strings", exit 22) while both
      # dialects accept 1/0 -- pa_set's BOOL normalisation then matches the
      # digit against whatever the read-back echoes (On/Off or 1/0)
      case "$PA_BACKEND" in
        wsa) pa_wsa_set_vi "$v" ;;
        *)   pa_tfa_set_vi "$v" ;;
      esac
      case "$PA_BACKEND:$?" in wsa:0|tfa:0) return 0 ;; *) return 1 ;; esac ;;
    algo|mute|stop|calib|profile)
      # hard refusals: these controls burn / mute / stop or de-calibrate the
      # speaker -- they are never exposed, not even as a "helpful" option
      printf '!! 已拒绝：ALGO_STATUS / Mute / Stop / Calibration / 换挡 类控件是扬声器安全红线，本模块永不提供\n' >&2
      return 1 ;;
    *)
      pa_usage ;;
  esac
}

do_verify() {
  printf 'config        : mixer=%s ceiling=%s bits=%s enabled=%s\n' \
         "$MIXER_RATE" "$MAX_RATE" "$BIT_DEPTH" "$ENABLED"
  printf 'policy files  : %s\n' "$(targets_brief)"
  printf 'mounted       : %s of %s\n' "$(count_applied)" "$(count_targets)"
  n=0
  if [ -r "$TGT" ]; then
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      n=$((n + 1))
      printf '\n--- [%s] %s\n' "$n" "$live"
      if is_mounted "$live"; then printf '    mount      : active\n'; else printf '    mount      : inactive\n'; fi
      if is_hal_target "$live"; then
        printf '    layer      : USB HAL library -- sample-rate table (layer 2)\n'
        printf '    ceiling    : %s Hz  (what the HAL advertises as its maximum)\n' "$(hal_ceiling "$live")"
        printf '    probe      : %s\n' \
               "$(sh "$HALPATCH" --check "$live" "$MAX_RATE" 2>&1 | tail -n1)"
        continue
      fi
      if is_volume_target "$live"; then
        # a volume table carries NO marker by construction: the patch has to keep
        # the file byte-identical in length, so there is nowhere to stamp one.
        # Its proof is the checker, run live against the archived factory copy --
        # that is also exactly what target_applied() used to accept the mount.
        printf '    layer      : volume table -- speaker/music curve (layer 4)\n'
        printf '    curve      : last %s step(s) at 0 dB\n' "$VOL_POINTS"
        stk_v="$STATE/stock/$(flatten "$live")"
        if [ -r "$stk_v" ] && [ -r "$live" ]; then
          if awk -v SPK_POINTS="$VOL_POINTS" -f "$VOLCHECK" "$stk_v" "$live" >/dev/null 2>&1; then
            printf '    check      : pass (factory copy vs live: only the tail lifted)\n'
          else
            printf '    check      : FAIL -- the live file is not a pure tail-lift of the archive\n'
          fi
        else
          printf '    check      : no factory archive to compare against\n'
        fi
        continue
      fi
      [ -r "$live" ] || continue
      printf '    marker     : %s line(s)\n' "$(grep -c "$MARKER" "$live" 2>/dev/null)"
      printf '    dialect    : %s\n' "$(sed -n "s/.*| dialect=\([a-z]*\) |.*/\1/p" "$live" 2>/dev/null | head -n1)"
      printf '    patched    : %s\n' "$(sed -n "s/.*$MARKER | ports=\([^|]*\)|.*/\1/p" "$live" 2>/dev/null | head -n1)"
      # report the ceiling actually present in every USB / wired port
      awk -v ceil="$MAX_RATE" -v mst="$MARKER" '
        /^[ \t]*<devicePort/ {
          tag = ""
          if (match($0, /tagName="[^"]*"/)) { tag = substr($0, RSTART+9, RLENGTH-10) }
          if (tag == "") { if (match($0, /type="[^"]*"/)) tag = substr($0, RSTART+6, RLENGTH-7) }
          cur = tag
        }
        /^[ \t]*<profile/ {
          r = ""
          if (match($0, /samplingRates="[^"]*"/)) r = substr($0, RSTART+15, RLENGTH-16)
          f = ""
          if (match($0, /pcmType="[^"]*"/))  f = substr($0, RSTART+9, RLENGTH-10)
          else if (match($0, /format="[^"]*"/)) f = substr($0, RSTART+8, RLENGTH-9)
          if (r == "" || f == "") next
          if (f ~ /NON_PCM|MP3|FLAC|AAC|VORBIS|OPUS|APE/) next
          if (cur ~ /usb|USB|wired|Wired|Headset|Headphone/) {
            mx = 0
            n = split(r, a, " ")
            for (i = 1; i <= n; i++) if (a[i] + 0 > mx) mx = a[i] + 0
            key = cur "|" f
            if (mx > seen[key]) seen[key] = mx
            nk = nk + 1
          }
        }
        END {
          if (nk == 0) { print "    ports      : (none matched)"; exit }
          for (k in seen) printf "    %-46s max %s\n", k, seen[k]
        }
      ' "$live" 2>/dev/null
    done < "$TGT"
  fi
  printf '\n--- host view (audioserver) ---\n'
  # dumpsys prints  `8. "direct_pcm_out"; 0x0001 (...)` -- quoted, no name=
  dumpsys media.audio_policy 2>/dev/null \
    | awk '/"direct_pcm_out"|"direct output"|"direct_pcm"|"hifi"/{f=1} f && /";[[:space:]]*0x/ && !/direct|hifi/{exit} f' \
    | head -n 20
  return 0
}

# ------------------------------------------------------------------ uninstall
do_uninstall() {
  log "=== uninstall: removing every trace ==="
  # 1. drop every bind mount, from the global namespace if we can reach it,
  #    and from every other namespace that happens to hold it
  if [ -r "$TGT" ]; then
    while IFS='|' read -r live patched stk; do
      [ -n "$live" ] || continue
      nsenter -t 1 -m -- umount "$live" 2>/dev/null
      is_mounted "$live" && umount "$live" 2>/dev/null
      is_mounted "$live" && umount -l "$live" 2>/dev/null
      [ -z "$PROOT" ] || continue
      for d in /proc/[0-9]*; do
        [ -r "$d/mounts" ] || continue
        if awk -v t="$live" '$2 == t { found = 1 } END { exit !found }' "$d/mounts" 2>/dev/null; then
          nsenter -t "${d#/proc/}" -m -- umount "$live" 2>/dev/null
        fi
      done
      if is_mounted "$live"; then
        log "! could not unmount $live -- REBOOT once to finish the removal"
      fi
    done < "$TGT"
  fi

  # 2. keep the settings in the manager log, then wipe the state dir
  if [ -r "$CONF" ]; then
    log "-- settings that are being removed --"
    sed 's/^/    /' "$CONF" >> "$LOG" 2>/dev/null
    sed 's/^/    /' "$CONF" 2>/dev/null
    log "-- end of settings --"
  fi
  rm -rf "$STATE" 2>/dev/null
  [ -e "$STATE" ] && log "! $STATE survived the wipe"

  # 3. stray files we may have produced outside the state dir
  rm -rf /data/local/tmp/hifi_src_bypass* 2>/dev/null
  rm -f  /data/local/tmp/.hifi_probe_* 2>/dev/null
  rm -rf /data/adb/modules_update/$MOD_ID 2>/dev/null

  log "/vendor /odm /system were never written to -- the factory policy is intact"
  log "=== uninstall finished ==="
  return 0
}

# ==================================================================== migrate
# Coming from the OnePlus-13-only build: adopt its settings, and warn loudly if
# it is still installed (two modules bind-mounting the same policy file is a
# recipe for confusion).
migrate_old() {
  changed=0
  if [ ! -e "$CONF" ] && [ -r "$OLD_STATE/config.conf" ]; then
    . "$OLD_STATE/config.conf" 2>/dev/null || true
    MIXER_RATE="${MIXER_RATE:-48000}"
    MAX_RATE="${MAX_RATE:-384000}"
    BIT_DEPTH="${BIT_DEPTH:-32}"
    ENABLED="${ENABLED:-1}"
    RESTART="${RESTART:-1}"
    save_conf
    log "migrated the settings of the previous module from $OLD_STATE/config.conf"
    changed=1
  fi
  if [ -d "/data/adb/modules/$OLD_ID" ]; then
    log "! the previous module ($OLD_ID) is still installed."
    log "  Two modules must not bind-mount the same audio policy. Please remove"
    log "  one of them in your module manager and reboot."
  fi
  return $changed
}

usage() {
  # Read the version from module.prop so `hifi` (and the help text users paste
  # into bug reports) can never drift from the shipped version= line.
  # Safe under `set -u` and when module.prop is missing/unreadable: _uv is always
  # assigned.  The version is interpolated into a `cat <<EOF` heredoc, so every
  # character that the shell could act on (backslash, backtick, $) is deleted
  # rather than escaped -- a hostile module.prop must not be able to run code
  # through `hifi`'s help text.
  _uv="$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n1 \
         | tr -d '\\`$' | tr -cd 'A-Za-z0-9._+-')"
  # module.prop carries a bare "2.0.0"; the help text shows "v2.0.2".  Drop an
  # optional leading v so the two can never render as "vv2.0.2", and fall back
  # to the same "v?" the WebUI version badge uses.
  _uv="${_uv#v}"; _uv="${_uv#V}"
  [ -n "$_uv" ] || _uv="?"
  cat <<EOF
HiFi SRC Bypass  (universal)   v${_uv}

  hifi status              show current state + the files in use + DAC
  hifi scan                rescan the ROM for audio policy files AND USB HAL libs
  hifi ports               list the policy files and the ports they expose
  hifi files               list every target, its archive and its patch
  hifi hal                 list the USB HAL libraries and their current ceiling
  hifi dac                 probe the connected USB dongle
  hifi verify              inspect the live config + the audioserver view
  hifi doctor              deep probe: is the high rate REALLY running?
  hifi adapt               device adaptation info (send this to the maintainer)
  hifi rates               list the selectable ceilings
  hifi set mixer 44100     global mixer rate (44100 / 48000 / 192000 / 384000)
  hifi set hifirate 192000 vendor HiFi port rate (auto = stock DAC maximum).
                           Pick the rate YOUR library uses: that content then
                           plays without resampling, the rest is resampled UP, never down
  hifi set max 384000      HiFi direct ceiling (48000 - 384000)
  hifi set bitdepth 24     USB / wired output bit-depth ceiling (16 / 24 / 32)
  hifi set spk 48000       speaker / earpiece port rate pinned to a single value,
                           auto = 原厂 (mixer mixPorts stay with MIXER_RATE)
  hifi set spkdsp 24       force the ADSP speaker bit width via the HAL
                           dsp_bit_width_enforce_mode property (16 / 24 / 32;
                           16 = off, injected on apply, cleared on restore)
  hifi set spkbits 24      speaker / earpiece bit-depth ceiling (16 / 24 / 32),
                           16 = 保持原厂
  hifi set restart 1       restart the audio stack after applying (1 / 0)
  hifi set enabled 0       boot-time intent only (advanced)
  hifi set hal 1           also unlock the USB HAL library's own rate table (1 / 0)
  hifi set volunlock 1     lift the CEILING of the speaker/music volume curve
                           (audio_policy_volumes.xml + default_volume_tables.xml):
                           the last 3 steps go from e.g. -3 dB to 0 dB, which is
                           what actually raises the maximum loudspeaker output.
                           THIS CHANGES MAXIMUM ACOUSTIC OUTPUT -- start at low
                           volume and check for clipping.  0 = factory (default)
  hifi set speloud 1       speaker loudness mode (0 / 1 / 2), default 0:
                           0 = 不碰;  1 = 只做硬件 IIR 高通 (160 Hz, Q=0.7071);
                           2 = 额外允许把 Qualcomm 数字前端音量压到 72.
                           The IIR high-pass cuts the sub-bass the loudspeaker
                           cannot reproduce, which frees diaphragm excursion so
                           TFA's DSP limiter stops being tripped by inaudible
                           low frequencies and lets mid/high pass through
                           louder.  PA gain is NOT raised: TFA9874's G_DEFAULT
                           is already the firmware maximum (measured <0.5 dB
                           difference), so that knob has no physical headroom.
  hifi preset auto         detect the dongle ceiling and configure it (recommended)
  hifi preset 384k         CX31993 / full-fat
  hifi preset 192k         generic 192 kHz compatibility tier
  hifi preset 96k          96 kHz Hi-Res Premium tier
  hifi preset 44k          align the system mixer to a 44.1 kHz library
  hifi preset 192mix       raise the global mixer to 192 kHz
  hifi preset 384mix       raise the global mixer to 384 kHz (high-end only)
  hifi speaker loud        speaker loudness: hardware IIR high-pass at 160 Hz
                           (Q=0.7071) cuts the sub-bass the speaker cannot make,
                           freeing excursion so the DSP limiter stops cutting
                           the mid/high band -- louder without more PA power.
                           SPK_LOUD=2 also lowers the digital front-end volume
                           to 72 (attenuation index: smaller = louder).
                           Skips itself, with the reason printed, when the IIR
                           block has no live playback route (INP* MUX = ZERO).
  hifi speaker flat        speaker best practice: SPK_RATE=44100 SPK_BITS=24
                           (44.1k library; for a 48k library use: hifi set spk 48000)
  hifi speaker hires       experimental HiRes speaker tier: SPK_RATE=192000 SPK_BITS=32
                           (if the speaker goes silent, run: hifi speaker auto)
  hifi speaker auto        100% factory speaker behaviour: 16-bit, auto rate,
                           IIR0 Enable Band1=Off, Band1=0 0 0 0 0, digital
                           volume back to 84, SPK_LOUD=0
  hifi speaker status      current speaker knobs + IIR availability + the vendor
                           DSP check of probe [9]
  hifi pa                  smart PA status overview (read-only; auto-detects
                           TFA9874 / Qualcomm WSA / Awinic / CS35L / MTK)
  hifi pa status           same as above
  hifi pa scan             snapshot the PA state to the state dir (WebUI poll)
  hifi pa gain <0..6>      loudspeaker PA gain tier (TFA: control 23; WSA884x:
                           RX volume = 84 - 2N, factory = 84)
                           (POWER WARNING printed first; 0 / reset = factory;
                           read-only backends refuse with an adapt pointer)
  hifi pa boost <1|2>      boost max state via controls 24+25 (2 = factory);
                           WSA has no manual boost -- firmware-managed
  hifi pa vi <on|off>      VI voltage/current feedback switches
                           (TFA 316+317 / WSA AIF_VI Mixer)
  hifi bootmode            show the boot safety-net state (normal/discover-only/degraded)
  hifi apply               TURN ON : patch + mount, persists across reboots
  hifi restore             TURN OFF: unmount, back to factory, module stays
  hifi reset               alias of restore
  hifi uninstall           manual full cleanup (normally run by the manager)
  hifi log                 show the run log
  hifi report [file]       write a world-readable diagnostic snapshot to
                           /data/local/tmp/hifi_src_bypass_report.txt
                           (also produced at every boot by service.sh)

  There are TWO ceilings and this module lifts both.  The XML policy is what
  the *framework* will hand out; the USB HAL library (libalsautils{,v2}.so)
  keeps its own hard table, and that is the one the DAC actually sees.  A
  dongle that stays at 96 kHz whatever the XML says is the HAL table talking.

  BIT_DEPTH is a *ceiling* on what is added, never a removal: 16 leaves the
  factory bit depths alone, 24 adds 24-bit, 32 adds 24-bit and 32-bit.
  Nothing the vendor declared is ever taken away.
EOF
}

# ======================================================================= main
case "${1:-status}" in
  status)     ensure_dirs; load_conf; do_status ;;
  dac)        ensure_dirs; load_conf; cmd_dac ;;
  json)       ensure_dirs; load_conf; status_json ;;
  rates)      printf 'ceiling options : %s\nmixer options   : %s\nhifi options    : %s\nbitdepth options: %s\nspk options     : %s\nspkbit options  : %s\nspkdsp options  : %s\nspeloud options : 0 1 2\n' \
                     "$ALL_RATES" "$ALL_MIXER" "$ALL_HIFI" "$ALL_BITS" "$ALL_SPK" "$ALL_SPK_BITS" "$ALL_SPKDSP" ;;
  scan)       ensure_dirs; load_conf; prepare || true; do_ports ;;
  ports)      ensure_dirs; load_conf; do_ports ;;
  files)      ensure_dirs; load_conf; do_files ;;
  set)        ensure_dirs; load_conf; do_set "${2:-}" "${3:-}" ;;
  preset)     ensure_dirs; load_conf; do_preset "${2:-}" ;;
  speaker)    ensure_dirs; load_conf; do_speaker "${2:-}" ;;
  pa)         ensure_dirs; load_conf; do_pa "${2:-}" "${3:-}" ;;
  bootmode)   ensure_dirs; do_bootmode ;;
  apply)      ensure_dirs; load_conf; do_apply "${2:-}" ;;
  restore)    ensure_dirs; load_conf; do_restore "${2:-}" ;;
  reset)      ensure_dirs; load_conf; do_restore "${2:-}" ;;
  verify)     ensure_dirs; load_conf; do_verify ;;
  # used by service.sh / action.sh: they must not grep for the text marker,
  # because a HAL library can never carry one
  applied)    enter_global_ns applied; ensure_dirs; load_conf
              printf '%s\n' "$(count_applied_verified)" ;;
  missing)    enter_global_ns missing; ensure_dirs; load_conf
              printf '%s\n' "$(count_missing)" ;;
  # a world-readable snapshot for remote diagnosis -- see do_report above
  report)     ensure_dirs; load_conf
              [ -r "$TGT" ] || prepare >/dev/null 2>&1
              do_report "${2:-}" ;;
  hal)        ensure_dirs; load_conf
              while IFS='|' read -r live rest; do
                [ -n "$live" ] || continue
                is_hal_target "$live" || continue
                printf '%s  %s Hz\n' "$live" "$(hal_ceiling "$live")"
              done < "$TGT" 2>/dev/null
              [ -r "$TGT" ] || printf '(nothing scanned yet)\n' ;;
  migrate)    ensure_dirs; load_conf; migrate_old ;;
  doctor|probe)
              ensure_dirs; load_conf
              if [ -r "$MODDIR/bin/probe192.sh" ]; then
                # the deep check is sections [1]..[7] only; [8] lives in its own
                # pane (`hifi adapt` / the WebUI adaptation card).  Without this
                # filter the probe also runs the adapt half, which is exactly
                # the duplication the split was meant to remove.
                HIFI_PROBE_SECTION=core; export HIFI_PROBE_SECTION
                exec sh "$MODDIR/bin/probe192.sh"
              else
                echo "probe192.sh not found under $MODDIR/bin" >&2
                exit 1
              fi ;;
  # [8] on its own -- the WebUI shows it in a separate pane, so the doctor
  # pane ([1]..[7]) opens straight on the live output state, no scrolling.
  adapt|adaptinfo|deviceinfo)
              ensure_dirs; load_conf
              if [ -r "$MODDIR/bin/probe192.sh" ]; then
                HIFI_PROBE_SECTION=adapt; export HIFI_PROBE_SECTION
                exec sh "$MODDIR/bin/probe192.sh"
              else
                echo "probe192.sh not found under $MODDIR/bin" >&2
                exit 1
              fi ;;
  uninstall)  ensure_dirs; load_conf; do_uninstall ;;
  log)        tail -n 150 "$LOG" 2>/dev/null || echo "no log yet" ;;
  boot)       ensure_dirs; do_boot ;;
  *)          usage ;;
esac
